function testMarkowitzRunMinimumMonths():
    symbols = testStockSymbols(testMinimumStocks)
    stockMap = markowitzStockMap(testMinimumStocks)
    unittestDeepEqual(markowitzRunMinimumMonths(symbols, stockMap), {'months': 12, 'count': 12})

    # Ending in 2025-09, the stocks with 8 and 12 months of prices have none
    unittestDeepEqual(markowitzRunMinimumMonths(symbols, stockMap, markowitzMonthIndex('2025-09')), {'months': 11, 'count': 11})

    # Unknown stocks are ignored - and the minimum is at least the minimum months
    unittestDeepEqual(markowitzRunMinimumMonths(['S0', 'XYZ'], stockMap), {'months': 6, 'count': 1})
    unittestDeepEqual(markowitzRunMinimumMonths(['XYZ'], stockMap), {'months': 6, 'count': 0})
endfunction
