#
# Runs page tests
#


async function testMarkowitzRunsPage():
    unittestMockAll({'systemFetch': {'getRuns': jsonStringify({'runs': [testRun]})}})
    markowitzRunsPage()
    expected = testHeaderCalls('Markowitz', 'Markowitz')
    arrayPush(expected, \
        ['systemFetch', ['getRuns']], \
        ['markdownPrint', [[ \
            '| Run                                             | Created          | Stocks | Analysis Period      | Targets                |', \
            '|-------------------------------------------------|------------------|-------:|----------------------|------------------------|', \
            "| [Blue \\<Chips\\>](#var.vId='r1'&var.vPage='run') | 2026-10-10 12:30 |      4 | 36 months to 2023-01 | 6.17%, 19.56%, 151.80% |" \
        ]]] \
    )
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction
unittestRunTest('testMarkowitzRunsPage')


async function testMarkowitzRunsPage_empty():
    unittestMockAll({'systemFetch': {'getRuns': jsonStringify({'runs': []})}})
    markowitzRunsPage()
    expected = testHeaderCalls('Markowitz', 'Markowitz')
    arrayPush(expected, \
        ['systemFetch', ['getRuns']], \
        ['markdownPrint', ["There are no runs. [Start a run](#var.vPage='new')."]] \
    )
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction
unittestRunTest('testMarkowitzRunsPage_empty')


async function testMarkowitzRunsPage_error():
    unittestMockAll({})
    markowitzRunsPage()
    expected = testHeaderCalls('Markowitz', 'Markowitz')
    arrayPush(expected, ['systemFetch', ['getRuns']], ['markdownPrint', ['**Error:** The runs could not be loaded.']])
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction
unittestRunTest('testMarkowitzRunsPage_error')


