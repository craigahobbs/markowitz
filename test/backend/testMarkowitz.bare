#
# Month tests
#


function testMarkowitzMonthIndex():
    unittestEqual(markowitzMonthIndex('1967-09'), 1967 * 12 + 8)
    unittestEqual(markowitzMonthIndex('2023-12'), 2023 * 12 + 11)
    unittestEqual(markowitzMonthIndex('2023-00'), null)
    unittestEqual(markowitzMonthIndex('2023-13'), null)
    unittestEqual(markowitzMonthIndex('2023-1'), null)
    unittestEqual(markowitzMonthIndex('Sept 1967'), null)
endfunction
unittestRunTest('testMarkowitzMonthIndex')


function testMarkowitzMonthString():
    unittestEqual(markowitzMonthString(1967 * 12 + 8), '1967-09')
    unittestEqual(markowitzMonthString(2023 * 12 + 9), '2023-10')
    unittestEqual(markowitzMonthString(2023 * 12 + 11), '2023-12')
    unittestEqual(markowitzMonthString(2024 * 12), '2024-01')
endfunction
unittestRunTest('testMarkowitzMonthString')


function testMarkowitzTimestampMonth():
    unittestEqual(markowitzTimestampMonth(0), '1970-01')
    unittestEqual(markowitzTimestampMonth(-1), '1969-12')
    unittestEqual(markowitzTimestampMonth(-2208988800), '1900-01')
    unittestEqual(markowitzTimestampMonth(-73526400), '1967-09')
    unittestEqual(markowitzTimestampMonth(951782399), '2000-02')
    unittestEqual(markowitzTimestampMonth(951868799), '2000-02')
    unittestEqual(markowitzTimestampMonth(951868800), '2000-03')
    unittestEqual(markowitzTimestampMonth(1790827200 - 14400), '2026-10')
    unittestEqual(markowitzTimestampMonth(1790827200 - 14401), '2026-09')
endfunction
unittestRunTest('testMarkowitzTimestampMonth')


