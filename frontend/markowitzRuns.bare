# The Markowitz application's runs and run pages, and a running run's progress

include <args.bare>
include <dataLineChart.bare>
include <dataTable.bare>
include <forms.bare>
include <markdown.bare>
include <url.bare>

# The common page helpers
include 'markowitzCommon.bare'


#
# Runs page
#


async function markowitzRunsPage():
    markowitzHeader('Markowitz')
    response = markowitzFetch('getRuns')
    if response == null:
        markdownPrint('**Error:** The runs could not be loaded.')
        return
    endif
    runs = objectGet(response, 'runs')
    if !arrayLength(runs):
        markdownPrint('There are no runs. ' + argsLink(markowitzArguments, 'Start a run', {'page': 'new'}, true) + '.')
        return
    endif

    # The runs table
    data = []
    for run in runs:
        arrayPush(data, { \
            'Run': argsLink(markowitzArguments, objectGet(run, 'name'), {'page': 'run', 'id': objectGet(run, 'id')}, true) + \
                if(objectGet(run, 'running'), ' (incomplete)', ''), \
            'Created': markowitzDatetimeText(objectGet(run, 'created')), \
            'Stocks': stringNew(arrayLength(objectGet(run, 'symbols'))), \
            'Group': objectGet(run, 'group', ''), \
            'Analysis Period': markowitzPeriodText(run), \
            'Targets': markowitzTargetsText(objectGet(run, 'targets')) \
        })
    endfor
    markdownPrint(dataTableMarkdown(data, { \
        'fields': ['Run', 'Created', 'Stocks', 'Group', 'Analysis Period', 'Targets'], \
        'formats': {'Run': {'markdown': true}, 'Stocks': {'align': 'right'}} \
    }))
endfunction


#
# Run page
#


async function markowitzRunPage(args, message):
    id = objectGet(args, 'id')
    response = if(id != null, markowitzFetch('getRun?id=' + urlEncodeComponent(id)))
    if response == null:
        markowitzHeader('Run', {'page': 'runs'})
        markdownPrint('**Error:** The run could not be loaded.')
        return
    endif
    run = objectGet(response, 'run')
    symbols = objectGet(run, 'symbols')
    portfolios = objectGet(run, 'portfolios')

    # The run's parameters and actions
    group = objectGet(run, 'group')
    markowitzHeader(objectGet(run, 'name'), {'page': 'runs'})
    markowitzMessage(message)
    if group != null:
        markdownPrint('- **Group:** ' + argsLink(markowitzArguments, group, {'page': 'group', 'group': group}, true))
    endif
    markdownPrint( \
        '- **Stocks:** ' + markdownEscape(arrayJoin(symbols, ', ')), \
        '- **Analysis period:** ' + markowitzPeriodText(run), \
        '- **Projection:** ' + objectGet(run, 'horizon') + ' months', \
        '- **Created:** ' + markowitzDatetimeText(objectGet(run, 'created')), \
        '' \
    )
    controls = []
    if objectGet(run, 'running'):
        markdownPrint( \
            '**This run is incomplete** - ' + arrayLength(portfolios) + ' of its ' + arrayLength(objectGet(run, 'targets')) + \
                ' portfolios are computed. Continue the run to compute the rest.', \
            '' \
        )
        arrayPush(controls, formsLinkButtonElements('Continue', systemPartial(markowitzOnContinueRun, args, run)), {'text': ' | '})
    endif
    arrayPush(controls, \
        formsLinkElements('Run Again', argsURL(markowitzArguments, {'page': 'new', 'id': id}, true)), \
        {'text': ' | '}, \
        formsLinkButtonElements('Delete', systemPartial(markowitzOnDeleteRun, args, id)) \
    )
    elementModelRender({'html': 'p', 'elem': controls})

    # The portfolios table
    portfolioData = []
    frontierData = []
    for portfolio in portfolios:
        variance = objectGet(portfolio, 'variance')
        risk = if(variance != null, mathSqrt(variance))
        arrayPush(portfolioData, { \
            'Target Return': markowitzPercentText(objectGet(portfolio, 'target')), \
            'Realized Return': markowitzPercentText(objectGet(portfolio, 'realizedReturn')), \
            'Risk': if(risk != null, markowitzPercentText(risk), 'No solution'), \
            'Stocks': stringNew(arrayLength(objectGet(portfolio, 'allocations'))), \
            'Deleted': stringNew(arrayLength(objectGet(portfolio, 'deleted'))) \
        })
        if risk != null:
            arrayPush(frontierData, {'Risk (%)': risk, 'Target Return (%)': objectGet(portfolio, 'target')})
        endif
    endfor
    markdownPrint( \
        '## Portfolios', \
        '', \
        'The minimum-risk portfolio for each target return. Stocks with negative allocations are deleted from the', \
        'portfolio, one at a time, most negative first (see "Excluded Stocks", below). Returns are annualized. Risk is', \
        'the standard deviation of the portfolio\'s monthly returns about their trend.', \
        '' \
    )
    markdownPrint(dataTableMarkdown(portfolioData, { \
        'fields': ['Target Return', 'Realized Return', 'Risk', 'Stocks', 'Deleted'], \
        'formats': { \
            'Target Return': {'align': 'right'}, \
            'Realized Return': {'align': 'right'}, \
            'Risk': {'align': 'right'}, \
            'Stocks': {'align': 'right'}, \
            'Deleted': {'align': 'right'} \
        } \
    }))

    # The efficient frontier chart
    if arrayLength(frontierData) >= 2:
        markdownPrint('', '## Efficient Frontier', '')
        dataLineChart(frontierData, {'x': 'Target Return (%)', 'y': ['Risk (%)']})
    endif

    # The allocations table - a column for each portfolio
    allocationData = []
    allocationFields = ['Stock']
    allocationFormats = {'Stock': {'markdown': true}}
    for symbol in symbols:
        arrayPush(allocationData, {'Stock': markowitzStockLink(symbol)})
    endfor
    for portfolio, ixPortfolio in portfolios:
        field = 'P' + ixPortfolio
        arrayPush(allocationFields, field)
        objectSet(allocationFormats, field, {'align': 'right', 'header': markowitzPercentText(objectGet(portfolio, 'target'))})
        for row in allocationData:
            objectSet(row, field, '')
        endfor
        for allocation in objectGet(portfolio, 'allocations'):
            row = arrayGet(allocationData, arrayIndexOf(symbols, objectGet(allocation, 'symbol')))
            objectSet(row, field, markowitzPercentText(100 * objectGet(allocation, 'weight')))
        endfor
    endfor
    markdownPrint( \
        '', \
        '## Allocations', \
        '', \
        'The percent of each target return\'s portfolio to invest in each stock.', \
        '' \
    )
    markdownPrint(dataTableMarkdown(allocationData, {'fields': allocationFields, 'formats': allocationFormats}))

    # The stocks table
    stockData = []
    for stock in objectGet(run, 'stocks'):
        arrayPush(stockData, { \
            'Stock': markowitzStockLink(objectGet(stock, 'symbol')), \
            'Projected Return': markowitzPercentText(objectGet(stock, 'expectedReturn')), \
            'Realized Return': markowitzPercentText(objectGet(stock, 'realizedReturn')), \
            'Risk': markowitzPercentText(mathSqrt(objectGet(stock, 'variance'))) \
        })
    endfor
    markdownPrint( \
        '', \
        '## Stocks', \
        '', \
        'Each stock\'s monthly returns are fit to a trend line. The projected return is the trend\'s return at the', \
        'end of the projection, and the risk is the standard deviation of the monthly returns about the trend.', \
        '' \
    )
    markdownPrint(dataTableMarkdown(stockData, { \
        'fields': ['Stock', 'Projected Return', 'Realized Return', 'Risk'], \
        'formats': { \
            'Stock': {'markdown': true}, \
            'Projected Return': {'align': 'right'}, \
            'Realized Return': {'align': 'right'}, \
            'Risk': {'align': 'right'} \
        } \
    }))

    # The excluded stocks table - the stocks excluded from the run, and the stocks deleted from each portfolio, sorted
    # by stock (a stock's run exclusion first, then its portfolio deletions, in portfolio order)
    excludedRows = []
    for exclusion in objectGet(run, 'excluded', []):
        symbol = objectGet(exclusion, 'symbol')
        arrayPush(excludedRows, [symbol, arrayLength(excludedRows), markowitzExcludedRow(symbol, 'Run', objectGet(exclusion, 'reason'))])
    endfor
    for portfolio in portfolios:
        portfolioText = markowitzPercentText(objectGet(portfolio, 'target')) + ' portfolio'
        deletedWeights = objectGet(portfolio, 'deletedWeights')
        for deletedSymbol, ixDeleted in objectGet(portfolio, 'deleted'):
            reason = 'Negative allocation' + \
                if(deletedWeights != null, ' (' + markowitzPercentText(100 * arrayGet(deletedWeights, ixDeleted)) + ')', '')
            arrayPush(excludedRows, [deletedSymbol, arrayLength(excludedRows), markowitzExcludedRow(deletedSymbol, portfolioText, reason)])
        endfor
    endfor
    if arrayLength(excludedRows):
        excludedData = []
        for excludedRow in arraySort(excludedRows, markowitzCompareExcludedRow):
            arrayPush(excludedData, arrayGet(excludedRow, 2))
        endfor
        markdownPrint( \
            '', \
            '## Excluded Stocks', \
            '', \
            'The stocks excluded from the run - stocks without a price for every month of the analysis period - and the', \
            'stocks deleted from each portfolio for a negative allocation, sorted by stock.', \
            '' \
        )
        markdownPrint(dataTableMarkdown(excludedData, { \
            'fields': ['Stock', 'Excluded From', 'Reason'], \
            'formats': {'Stock': {'markdown': true}} \
        }))
    endif
endfunction


# Compare excluded stocks table rows ([symbol, order, row]) - by symbol, then order
function markowitzCompareExcludedRow(a, b):
    return systemCompare(arrayGet(a, 0), arrayGet(b, 0)) || systemCompare(arrayGet(a, 1), arrayGet(b, 1))
endfunction


# An excluded stocks table row
function markowitzExcludedRow(symbol, excludedFrom, reason):
    return { \
        'Stock': markowitzStockLink(symbol), \
        'Excluded From': excludedFrom, \
        'Reason': reason \
    }
endfunction


# Continue an incomplete run - compute the rest of its portfolios
function markowitzOnContinueRun(args, run):
    markowitzRunProgress({ \
        'args': args, \
        'id': objectGet(run, 'id'), \
        'name': objectGet(run, 'name'), \
        'count': arrayLength(objectGet(run, 'portfolios')), \
        'total': arrayLength(objectGet(run, 'targets')) \
    })
endfunction


# Delete a run
async function markowitzOnDeleteRun(args, id):
    if markowitzFetch('deleteRun', {'id': id}) == null:
        markowitzRunPage(args, 'The run could not be deleted.')
        return
    endif
    windowSetLocation(argsURL(markowitzArguments, {'page': 'runs'}, true))
endfunction


#
# Run progress - a running run's portfolios are computed a request at a time, each in its own window timeout, so that
# its progress renders after each portfolio. The progress object has the page's URL arguments ("args"), the run's ID
# and name, and the counts of its portfolios computed and of its target returns.
#


# Render a running run's progress, and schedule its next portfolio
function markowitzRunProgress(progress):
    count = objectGet(progress, 'count')
    total = objectGet(progress, 'total')
    markowitzHeader(objectGet(progress, 'name'))
    markdownPrint( \
        '**Running...** Computed ' + count + ' of ' + total + ' portfolios (' + numberToFixed(100 * count / total, 0) + \
            '%). A run of many stocks can take a minute.', \
        '' \
    )
    elementModelRender(markowitzProgressElements(count, total, systemPartial(markowitzOnRunStop, progress)))
    windowSetTimeout(systemPartial(markowitzOnRunPortfolio, progress), 0)
endfunction


# Compute a running run's next portfolio - render the progress, or, if done (or failed), the run's page
async function markowitzOnRunPortfolio(progress):
    if objectGet(progress, 'stopped'):
        return
    endif
    response = markowitzFetch('computeRunPortfolio', {'id': objectGet(progress, 'id')})
    if objectGet(progress, 'stopped'):
        return
    elif response == null:
        markowitzRunProgressDone(progress, 'Computing the run\'s portfolio failed.')
        return
    endif
    count = objectGet(response, 'portfolios')
    if count < objectGet(response, 'targets'):
        objectSet(progress, 'count', count)
        markowitzRunProgress(progress)
        return
    endif
    markowitzRunProgressDone(progress)
endfunction


# Stop computing a running run's portfolios - render the run's page, where it can be continued. The progress is
# marked stopped, so that the portfolio being computed (MarkdownUp doesn't queue a click behind a window timeout's
# callback), or the next portfolio's already-queued window timeout, renders and schedules nothing.
async function markowitzOnRunStop(progress):
    objectSet(progress, 'stopped', true)
    markowitzRunProgressDone(progress)
endfunction


# Render a running run's page - from the run's page (continued), render it with the message, otherwise go to it
async function markowitzRunProgressDone(progress, message):
    args = objectGet(progress, 'args')
    if objectGet(args, 'page') == 'run':
        markowitzRunPage(args, message)
        return
    endif
    windowSetLocation(argsURL(markowitzArguments, {'page': 'run', 'id': objectGet(progress, 'id')}, true))
endfunction
