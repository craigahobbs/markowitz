endfunction
unittestRunTest('testMarkowitzStockMap')


function testMarkowitzRunMinimumMonths():
    symbols = testStockSymbols(testMinimumStocks)
    stockMap = markowitzStockMap(testMinimumStocks)
    unittestDeepEqual(markowitzRunMinimumMonths(symbols, stockMap), {'months': 12, 'count': 12})

    # Ending in 2025-09, the stocks with 8 and 12 months of prices have none
    unittestDeepEqual(markowitzRunMinimumMonths(symbols, stockMap, markowitzMonthIndex('2025-09')), {'months': 11, 'count': 11})

    # Unknown stocks are ignored - and the minimum is at least the minimum months
    unittestDeepEqual(markowitzRunMinimumMonths(['S0', 'XYZ'], stockMap), {'months': 6, 'count': 1})
    unittestDeepEqual(markowitzRunMinimumMonths(['XYZ'], stockMap), {'months': 6, 'count': 0})
endfunction
unittestRunTest('testMarkowitzRunMinimumMonths')


function testMarkowitzRunMinimumMonths_tooMany():
    stocks = testPriceStocks(arrayNewSize(601, '1950-01'))
    unittestDeepEqual(markowitzRunMinimumMonths(testStockSymbols(stocks), markowitzStockMap(stocks)), {'months': null, 'count': 601})
endfunction
unittestRunTest('testMarkowitzRunMinimumMonths_tooMany')


function testMarkowitzGroupMinimumText():
    unittestEqual( \
        markowitzGroupMinimumText(arrayGet(testMinimumGroups, 0), testMinimumStocks), \
        testMinimumText(12, 12, 13) \
    )
    stocks = testPriceStocks(arrayNewSize(601, '1950-01'))
    unittestEqual( \
        markowitzGroupMinimumText({'name': 'Big', 'symbols': testStockSymbols(stocks)}, stocks), \
        "**Note:** This group can't be run - 601 of its 601 stocks have prices for 600 months (the most a run can have), " + \
            "and a run can't have more stocks than months. Exclude at least 1 more stocks to run it." \
    )
    unittestEqual( \
        markowitzGroupMinimumText({'name': 'S&P 100', 'symbols': ['XYZ']}, testStocks), \
        "**Note:** Fewer than two of the group's stocks have prices - [update the stocks](#var.vGroup='S%26P%20100'&var.vPage='group')." \
    )
endfunction
unittestRunTest('testMarkowitzGroupMinimumText')


function testMarkowitzGroupMissingText():
    unittestEqual(markowitzGroupMissingText(arrayGet(testGroups, 1), testStocks), testMissingText('S%26P%20100', 1, 3))
    unittestEqual(markowitzGroupMissingText(arrayGet(testGroups, 0), testStocks), null)
endfunction
unittestRunTest('testMarkowitzGroupMissingText')


function testMarkowitzRunFormUpdate():
    # The months are raised to the minimum - the stock with 8 months of prices is excluded
    form = objectAssign(objectCopy(testForm), {'group': 'Minimum', 'months': '6', 'exclude': 'S0'})
    markowitzRunFormUpdate(form, testMinimumStocks, testMinimumGroups, true)
    unittestDeepEqual(form, objectAssign(objectCopy(testForm), {'group': 'Minimum', 'months': '12', 'exclude': 'S10'}))

    # More months than the minimum are lowered to the minimum
    form = objectAssign(objectCopy(testForm), {'group': 'Minimum', 'months': '24'})
    markowitzRunFormUpdate(form, testMinimumStocks, testMinimumGroups, true)
    unittestDeepEqual(form, objectAssign(objectCopy(testForm), {'group': 'Minimum', 'months': '12', 'exclude': 'S10'}))

    # Without setting the months, the stocks with 8 and 12 months of prices are excluded from 24 months
    form = objectAssign(objectCopy(testForm), {'group': 'Minimum', 'months': '24'})
    markowitzRunFormUpdate(form, testMinimumStocks, testMinimumGroups, false)
    unittestDeepEqual(form, objectAssign(objectCopy(testForm), {'group': 'Minimum', 'months': '24', 'exclude': 'S10 S11'}))

    # Invalid months are set to the minimum
    form = objectAssign(objectCopy(testForm), {'group': 'Minimum', 'months': 'many'})
    markowitzRunFormUpdate(form, testMinimumStocks, testMinimumGroups, true)
    unittestDeepEqual(form, objectAssign(objectCopy(testForm), {'group': 'Minimum', 'months': '12', 'exclude': 'S10'}))

    # The end month - the stocks without prices from 2024-11 to 2025-09 are excluded
    form = objectAssign(objectCopy(testForm), {'group': 'Minimum', 'endMonth': ' 2025-09 ', 'months': '10'})
    markowitzRunFormUpdate(form, testMinimumStocks, testMinimumGroups, false)
    unittestEqual(objectGet(form, 'exclude'), 'S10 S11')
endfunction
unittestRunTest('testMarkowitzRunFormUpdate')


function testMarkowitzRunFormUpdate_name():
    # An empty name, or another group's name, is set to the selected group's name
    for name in [' ', 'Dow 30', 'Minimum']:
        form = objectAssign(objectCopy(testForm), {'name': name, 'group': 'Minimum'})
        markowitzRunFormUpdate(form, testMinimumStocks, arrayExtend(arrayCopy(testMinimumGroups), testGroups), true)
        unittestEqual(objectGet(form, 'name'), 'Minimum')
    endfor

    # A user's name is kept
    form = objectAssign(objectCopy(testForm), {'group': 'Minimum'})
    markowitzRunFormUpdate(form, testMinimumStocks, testMinimumGroups, true)
    unittestEqual(objectGet(form, 'name'), ' My Run ')

    # The name isn't changed unless the group was selected
    form = objectAssign(objectCopy(testForm), {'name': '', 'group': 'Minimum'})
    markowitzRunFormUpdate(form, testMinimumStocks, testMinimumGroups, false)
    unittestEqual(objectGet(form, 'name'), '')
endfunction
unittestRunTest('testMarkowitzRunFormUpdate_name')


function testMarkowitzRunFormUpdate_noChange():
    # Invalid months, without setting the months, don't change the excluded stocks
    form = objectAssign(objectCopy(testForm), {'group': 'Minimum', 'months': 'many', 'exclude': 'S0'})
    markowitzRunFormUpdate(form, testMinimumStocks, testMinimumGroups, false)
    unittestDeepEqual(form, objectAssign(objectCopy(testForm), {'group': 'Minimum', 'months': 'many', 'exclude': 'S0'}))

    # An unknown group changes nothing
    form = objectAssign(objectCopy(testForm), {'group': 'Gone', 'months': '6'})
    markowitzRunFormUpdate(form, testMinimumStocks, testMinimumGroups, true)
    unittestDeepEqual(form, objectAssign(objectCopy(testForm), {'group': 'Gone', 'months': '6'}))

    # The months are the maximum if the group has too many stocks
    stocks = testPriceStocks(arrayNewSize(601, '1950-01'))
    groups = [{'name': 'Big', 'symbols': testStockSymbols(stocks)}]
    form = objectAssign(objectCopy(testForm), {'group': 'Big'})
    markowitzRunFormUpdate(form, stocks, groups, true)
    unittestEqual(objectGet(form, 'months'), '600')
endfunction
unittestRunTest('testMarkowitzRunFormUpdate_noChange')


#
# Run request tests
#


function testMarkowitzRunRequest():
    unittestDeepEqual(markowitzRunRequest(testForm, testStocks, testGroups), {'request': testRequest})
endfunction
unittestRunTest('testMarkowitzRunRequest')


function testMarkowitzRunRequest_exclude():
    # Excluding MSFT (no prices) leaves IBM and KO
    form = objectAssign(objectCopy(testForm), {'group': 'S&P 100', 'exclude': ' msft, XYZ '})
    request = objectAssign(objectCopy(testRequest), {'group': 'S&P 100', 'exclude': ['MSFT', 'XYZ']})
    unittestDeepEqual(markowitzRunRequest(form, testStocks, testGroups), {'request': request})

    # Excluding IBM leaves MSFT, without prices
    unittestDeepEqual(markowitzRunRequest(objectAssign(objectCopy(form), {'exclude': 'IBM'}), testStocks, testGroups), {'missing': ['MSFT']})

    # Excluding IBM and MSFT leaves one stock
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(form), {'exclude': 'IBM MSFT'}), testStocks, testGroups), \
        {'error': 'Fewer than two of the group\'s stocks have prices for the analysis period - update the group\'s stocks.'} \
    )
endfunction
unittestRunTest('testMarkowitzRunRequest_exclude')


function testMarkowitzRunRequest_noGroup():
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(testForm), {'group': ''}), testStocks, testGroups), \
        {'error': 'Select a stock group.'} \
    )
endfunction
unittestRunTest('testMarkowitzRunRequest_noGroup')


function testMarkowitzRunRequest_unknownGroup():
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(testForm), {'group': 'Nasdaq'}), testStocks, testGroups), \
        {'error': 'Unknown stock group "Nasdaq".'} \
    )
endfunction
unittestRunTest('testMarkowitzRunRequest_unknownGroup')


function testMarkowitzRunRequest_endMonth():
    form = objectAssign(objectCopy(testForm), {'endMonth': ' 1990-06 ', 'months': '60'})
    request = objectAssign(objectCopy(testRequest), {'endMonth': '1990-06', 'months': 60})
    unittestDeepEqual(markowitzRunRequest(form, testStocks, testGroups), {'request': request})
endfunction
unittestRunTest('testMarkowitzRunRequest_endMonth')


function testMarkowitzRunRequest_invalid():
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(testForm), {'name': ' '}), testStocks, testGroups), \
        {'error': 'Invalid "Name" value.'} \
    )
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(testForm), {'months': '-5'}), testStocks, testGroups), \
        {'error': 'Invalid "Months in the analysis period" value.'} \
    )
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(testForm), {'months': 'many'}), testStocks, testGroups), \
        {'error': 'Invalid "Months in the analysis period" value.'} \
    )
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(testForm), {'targets': '10, ten'}), testStocks, testGroups), \
        {'error': 'Invalid "Target annual returns, in percent, separated by spaces or commas" value.'} \
    )
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(testForm), {'exclude': 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'}), testStocks, testGroups), \
        {'error': 'Invalid "' + testExcludeLabel + '" value.'} \
    )
endfunction
unittestRunTest('testMarkowitzRunRequest_invalid')


function testMarkowitzRunRequest_invalidMonth():
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(testForm), {'endMonth': '2023-13'}), testStocks, testGroups), \
        {'error': 'Invalid end month "2023-13" - use "YYYY-MM".'} \
    )
endfunction
unittestRunTest('testMarkowitzRunRequest_invalidMonth')


function testMarkowitzRunRequest_tooManyStocks():
    unittestDeepEqual( \
        markowitzRunRequest( \
            objectAssign(objectCopy(testForm), {'group': 'Minimum', 'months': '11', 'exclude': 'S10'}), testMinimumStocks, testMinimumGroups \
        ), \
        {'error': 'There are more of the group\'s stocks with prices for the analysis period (12) than months (11) - ' + \
            'increase the months in the analysis period, or exclude stocks.'} \
    )
endfunction
unittestRunTest('testMarkowitzRunRequest_tooManyStocks')


function testMarkowitzRunRequest_tooFewStocks():
    # KO's prices start in 1985-01 - the analysis period's starting price is needed
    form = objectAssign(objectCopy(testForm), {'group': 'S&P 100', 'exclude': 'MSFT'})
    unittestEqual(objectHas(markowitzRunRequest(objectAssign(objectCopy(form), {'endMonth': '1988-01'}), testStocks, testGroups), 'request'), true)
    unittestDeepEqual(markowitzRunRequest(objectAssign(objectCopy(form), {'endMonth': '1987-12'}), testStocks, testGroups), {'missing': ['KO']})

    # Excluded, KO leaves one stock
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(form), {'endMonth': '1987-12', 'exclude': 'KO MSFT'}), testStocks, testGroups), \
        {'error': 'Fewer than two of the group\'s stocks have prices for the analysis period - update the group\'s stocks.'} \
    )
endfunction
unittestRunTest('testMarkowitzRunRequest_tooFewStocks')
