include <unittest.bare>
include <unittestMock.bare>
include '../../frontend/markowitz.bare'
include 'testMarkowitzHelpers.bare'


#
# Main tests
#


async function testMarkowitzMain():
    data = {'systemFetch': {'getRuns': jsonStringify({'runs': []})}}
    testSameEffect(markowitzMain, markowitzRunsPage, data)
endfunction
unittestRunTest('testMarkowitzMain')


async function testMarkowitzMain_run():
    systemGlobalSet('vPage', 'run')
    systemGlobalSet('vId', 'r1')
    data = {'systemFetch': {'getRun?id=r1': jsonStringify({'run': testRun})}}
    testSameEffect(markowitzMain, systemPartial(markowitzRunPage, {'page': 'run', 'id': 'r1'}), data)
    systemGlobalSet('vPage', null)
    systemGlobalSet('vId', null)
endfunction
unittestRunTest('testMarkowitzMain_run')


async function testMarkowitzMain_new():
    systemGlobalSet('vPage', 'new')
    data = {'systemFetch': {'getStocks': jsonStringify({'stocks': testStocks}), 'getGroups': jsonStringify({'groups': testGroups})}}
    testSameEffect(markowitzMain, systemPartial(markowitzNewRunPage, {'page': 'new'}), data)
    systemGlobalSet('vPage', null)
endfunction
unittestRunTest('testMarkowitzMain_new')


async function testMarkowitzMain_stocks():
    systemGlobalSet('vPage', 'stocks')
    data = {'systemFetch': {'getStocks': jsonStringify({'stocks': testStocks}), 'getGroups': jsonStringify({'groups': testGroups})}}
    testSameEffect(markowitzMain, systemPartial(markowitzStocksPage, {'page': 'stocks'}), data)
    systemGlobalSet('vPage', null)
endfunction
unittestRunTest('testMarkowitzMain_stocks')


async function testMarkowitzMain_stock():
    systemGlobalSet('vPage', 'stock')
    systemGlobalSet('vSymbol', 'IBM')
    data = {'systemFetch': {'getStock?symbol=IBM': jsonStringify({'stock': arrayGet(testStocks, 0), 'prices': {'2026-07': 9}})}}
    testSameEffect(markowitzMain, systemPartial(markowitzStockPage, {'page': 'stock', 'symbol': 'IBM'}), data)
    systemGlobalSet('vPage', null)
    systemGlobalSet('vSymbol', null)
endfunction
unittestRunTest('testMarkowitzMain_stock')


async function testMarkowitzMain_groups():
    systemGlobalSet('vPage', 'groups')
    data = {'systemFetch': {'getGroups': jsonStringify({'groups': testGroups})}}
    testSameEffect(markowitzMain, systemPartial(markowitzGroupsPage, {'page': 'groups'}), data)
    systemGlobalSet('vPage', null)
endfunction
unittestRunTest('testMarkowitzMain_groups')


async function testMarkowitzMain_group():
    systemGlobalSet('vPage', 'group')
    systemGlobalSet('vGroup', 'Dow 30')
    data = {'systemFetch': {'getGroup?name=Dow%2030': jsonStringify({'group': arrayGet(testGroups, 0), 'stocks': testStocks})}}
    testSameEffect(markowitzMain, systemPartial(markowitzGroupPage, {'page': 'group', 'group': 'Dow 30'}), data)
    systemGlobalSet('vPage', null)
    systemGlobalSet('vGroup', null)
endfunction
unittestRunTest('testMarkowitzMain_group')
