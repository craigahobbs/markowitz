# Test a group creation that fails - its message and re-rendered page
async function testOnCreateGroupFailure(inputs, fetchCount, message):
    args = {'page': 'groups'}
    data = {'documentInputValue': inputs, 'systemFetch': {'getGroups': jsonStringify({'groups': testGroups})}}
    unittestMockAll(data)
    markowitzOnCreateGroup(args, ['Dow 30'])
    calls = unittestMockEnd()
    form = {'name': objectGet(inputs, 'markowitz-group-name'), 'symbols': objectGet(inputs, 'markowitz-group-symbols')}
    unittestDeepEqual(arraySlice(calls, 0, 2), testGroupFormInputCalls)
    unittestDeepEqual( \
        arraySlice(calls, 2 + fetchCount), \
        testPageCalls(systemPartial(markowitzGroupsPage, args, form, message), data) \
    )
endfunction


