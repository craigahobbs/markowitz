#
# createRun tests
#


# The createRun test fetch mock data - the "Test" group of stock symbols, and the stock documents and run ID, if any
function testCreateRunData(symbols, docs, id):
    group = {'_id': 'group:Test', '_rev': '1-abc', 'type': 'group', 'name': 'Test', 'symbols': symbols}
    fetchData = objectNew(testCouchURL + '/group%3ATest', jsonStringify(group))
    if docs != null:
        objectSet(fetchData, testCouchURL + '/_find', jsonStringify({'docs': docs}))
    endif
    if id != null:
        objectSet(fetchData, testCouchURL, jsonStringify({'ok': true, 'id': id, 'rev': '1-abc'}))
    endif
    return {'systemFetch': fetchData}
endfunction


# Get the run document posted by a createRun call log
function testCreateRunDoc(calls):
    return jsonParse(objectGet(arrayGet(arrayGet(arrayGet(calls, 2), 1), 0), 'body'))
endfunction


async function testCreateRun():
    testMockAll(testCreateRunData(['D', 'C', 'B', 'A'], testStockDocs(), 'run1'))
    request = {'name': 'Test Run', 'group': 'Test', 'endMonth': '2023-01', 'targets': testTargets}
    unittestDeepEqual(testAction('POST', '/createRun', '', request), ['200 OK', {'id': 'run1'}])
    calls = unittestMockEnd()
    unittestEqual(arrayLength(calls), 3)
    unittestDeepEqual(arrayGet(calls, 0), testCouchCall('/group%3ATest'))
    unittestDeepEqual(arrayGet(calls, 1), testCreateRunFindCall(testSymbols))

    # The run document - the statistics and portfolios match the original program's
    postRequest = arrayGet(arrayGet(arrayGet(calls, 2), 1), 0)
    unittestEqual(objectGet(postRequest, 'url'), testCouchURL)
    unittestDeepEqual(objectGet(postRequest, 'headers'), testCouchHeaders)
    unittestDeepEqual(testRound(jsonParse(objectGet(postRequest, 'body'))), testRound({ \
        'type': 'run', \
        'name': 'Test Run', \
        'created': testNowISO, \
        'symbols': testSymbols, \
        'group': 'Test', \
        'endMonth': '2023-01', \
        'months': 36, \
        'horizon': 3, \
        'targets': testTargets, \
        'stocks': testRunStocks, \
        'portfolios': [], \
        'excluded': [], \
        'running': true, \
        'relatives': testAnalysisRelatives, \
        'horizonRelatives': testHorizonRelatives \
    }))
endfunction
unittestRunTest('testCreateRun')


async function testCreateRun_defaultEndMonth():
    testMockAll(testCreateRunData(testSymbols, testStockDocs(), 'run2'))
    request = {'name': 'Test Run', 'group': 'Test', 'months': 24, 'horizon': 1, 'targets': [20]}
    unittestDeepEqual(testAction('POST', '/createRun', '', request), ['200 OK', {'id': 'run2'}])
    run = testCreateRunDoc(unittestMockEnd())

    # The projection months have not passed - there are no realized returns
    unittestEqual(objectGet(run, 'endMonth'), '2023-04')
    unittestEqual(objectGet(run, 'months'), 24)
    unittestEqual(objectGet(run, 'horizon'), 1)
    for stock in objectGet(run, 'stocks'):
        unittestEqual(objectHas(stock, 'realizedReturn'), false)
    endfor
    unittestDeepEqual(objectGet(run, 'horizonRelatives'), [null, null, null, null])
endfunction
unittestRunTest('testCreateRun_defaultEndMonth')


async function testCreateRun_invalidMonth():
    for endMonth in ['2023-13', 'January']:
        testMockAll({})
        request = {'name': 'Test Run', 'group': 'Test', 'endMonth': endMonth, 'targets': [10]}
        unittestDeepEqual( \
            testAction('POST', '/createRun', '', request), \
            ['400 Bad Request', {'error': 'InvalidMonth', 'message': 'Invalid end month "' + endMonth + '" - use "YYYY-MM"'}] \
        )
        unittestDeepEqual(unittestMockEnd(), [])
    endfor
endfunction
unittestRunTest('testCreateRun_invalidMonth')


async function testCreateRun_excluded():
    # E's prices start late, and C is missing a month's price - F is unknown
    docs = testStockDocs()
    arrayPush(docs, objectAssign(objectCopy(arrayGet(docs, 0)), {'symbol': 'E', 'firstMonth': '2021-01'}))
    objectDelete(objectGet(arrayGet(docs, 2), 'prices'), '2021-06')
    testMockAll(testCreateRunData(['A', 'B', 'C', 'D', 'E', 'F'], docs, 'run3'))
    request = {'name': 'Group Run', 'group': 'Test', 'endMonth': '2023-01', 'targets': [10]}
    unittestDeepEqual(testAction('POST', '/createRun', '', request), ['200 OK', {'id': 'run3'}])
    run = testCreateRunDoc(unittestMockEnd())
    unittestEqual(objectGet(run, 'group'), 'Test')
    unittestDeepEqual(objectGet(run, 'symbols'), ['A', 'B', 'D'])
    unittestDeepEqual(objectGet(run, 'excluded'), [ \
        {'symbol': 'C', 'reason': 'No price for 2021-06'}, \
        {'symbol': 'E', 'reason': 'Prices start in 2021-01'}, \
        {'symbol': 'F', 'reason': 'No prices - update the stock on the Stocks page'} \
    ])
endfunction
unittestRunTest('testCreateRun_excluded')


async function testCreateRun_exclude():
    # B's prices end early - excluded, it doesn't move the default end month. E is unknown.
    docs = testStockDocs()
    objectSet(arrayGet(docs, 1), 'lastMonth', '2022-12')
    testMockAll(testCreateRunData(['A', 'B', 'C', 'D', 'E'], docs, 'run5'))
    request = {'name': 'Test Run', 'group': 'Test', 'exclude': ['c', 'B', 'E', 'XYZ'], 'targets': [10]}
    unittestDeepEqual(testAction('POST', '/createRun', '', request), ['200 OK', {'id': 'run5'}])
    run = testCreateRunDoc(unittestMockEnd())
    unittestEqual(objectGet(run, 'endMonth'), '2023-04')
    unittestDeepEqual(objectGet(run, 'symbols'), ['A', 'D'])
    unittestDeepEqual(objectGet(run, 'excluded'), [ \
        {'symbol': 'B', 'reason': 'Prices end in 2022-12'}, \
        {'symbol': 'C', 'reason': 'Excluded by the user'}, \
        {'symbol': 'E', 'reason': 'No prices - update the stock on the Stocks page'} \
    ])
endfunction
unittestRunTest('testCreateRun_exclude')


async function testCreateRun_stale():
    # One of ten stocks' prices end early - it's excluded, rather than ending the analysis period early
    symbols = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J']
    docs = testStockDocs(symbols)
    objectSet(arrayGet(docs, 5), 'lastMonth', '2022-06')
    testMockAll(testCreateRunData(symbols, docs, 'run6'))
    request = {'name': 'Test Run', 'group': 'Test', 'targets': [10]}
    unittestDeepEqual(testAction('POST', '/createRun', '', request), ['200 OK', {'id': 'run6'}])
    run = testCreateRunDoc(unittestMockEnd())
    unittestEqual(objectGet(run, 'endMonth'), '2023-04')
    unittestEqual(arrayIndexOf(objectGet(run, 'symbols'), 'F'), -1)
    unittestDeepEqual(objectGet(run, 'excluded'), [{'symbol': 'F', 'reason': 'Prices end in 2022-06'}])
endfunction
unittestRunTest('testCreateRun_stale')


async function testCreateRun_pricesEnd():
