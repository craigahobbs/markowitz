# The running run's page calls
function testRunningCalls(name):
    calls = testHeaderCalls('New Run', 'New Run')
    arrayPush(calls, \
        ['markdownPrint', ['**Running "' + name + '"...** A run of many stocks can take a minute.', '']], \
        ['windowSetTimeout', ['<function>', 0]] \
    )
    return calls
endfunction


