# The test stock download request
function testYahooRequest(symbol):
    return {'url': testYahooURL(symbol), 'headers': {'User-Agent': 'Mozilla/5.0 (compatible; Markowitz)'}}
endfunction


async function testUpdateStocks_group():
    group = {'_id': 'group:Test', '_rev': '1-abc', 'type': 'group', 'name': 'Test', 'symbols': ['IBM', 'KO']}
    fetchData = {}
    objectSet(fetchData, testCouchURL + '/group%3ATest', jsonStringify(group))
    objectSet(fetchData, testCouchURL + '/_all_docs', jsonStringify({'rows': []}))
    objectSet(fetchData, testCouchURL + '/_bulk_docs', '[]')
    testMockAll({'systemFetch': fetchData})
    unittestDeepEqual( \
        testAction('POST', '/updateStocks', '', {'symbols': ['msft', 'ko'], 'group': 'Test'}), \
        ['200 OK', {'results': [ \
            {'symbol': 'IBM', 'error': 'Download failed - is "IBM" a Yahoo Finance symbol?'}, \
            {'symbol': 'KO', 'error': 'Download failed - is "KO" a Yahoo Finance symbol?'}, \
            {'symbol': 'MSFT', 'error': 'Download failed - is "MSFT" a Yahoo Finance symbol?'} \
        ]}] \
    )
    unittestDeepEqual(unittestMockEnd(), [ \
        testCouchCall('/group%3ATest'), \
        ['systemFetch', [[testYahooRequest('IBM'), testYahooRequest('KO'), testYahooRequest('MSFT')]]], \
        testCouchCall('/_all_docs', {'keys': ['stock:IBM', 'stock:KO', 'stock:MSFT']}), \
        testCouchCall('/_bulk_docs', {'docs': []}) \
    ])
endfunction
unittestRunTest('testUpdateStocks_group')


