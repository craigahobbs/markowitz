# Utilities shared by the backend and frontend


# Normalize stock symbols - uppercase, unique, and sorted
function markowitzSymbols(symbols):
    unique = {}
    for symbol in symbols:
        objectSet(unique, stringUpper(symbol), true)
    endfor
    return arraySort(objectKeys(unique))
endfunction


#
# Months - a month string is "YYYY-MM" and a month index is the number of months since year zero
#


markowitzRegexMonth = regexNew('^(?<year>\\d{4})-(?<month>\\d{2})$')


# Parse a month string to a month index - null if invalid
function markowitzMonthIndex(month):
    matchMonth = regexMatch(markowitzRegexMonth, month)
    if matchMonth == null:
        return null
    endif
    groups = objectGet(matchMonth, 'groups')
    monthNumber = numberParseInt(objectGet(groups, 'month'))
    if monthNumber < 1 || monthNumber > 12:
        return null
    endif
    return numberParseInt(objectGet(groups, 'year')) * 12 + monthNumber - 1
endfunction


# Format a month index as a month string
function markowitzMonthString(monthIndex):
    monthNumber = monthIndex % 12 + 1
    return mathFloor(monthIndex / 12) + '-' + if(monthNumber < 10, '0', '') + monthNumber
endfunction


#
# Runs
#


# The fraction of a run's stocks with prices through its default end month - the other stocks' prices end earlier
# (e.g. a delisted or stale stock), so they're excluded rather than ending the analysis period early
markowitzRunEndFraction = 0.9


# Get a run's default end month index - the latest month for which most stocks (the end fraction) have a price, or the
# last month for which every stock has a price if there are fewer than ten stocks. The stocks are a map of symbol to
# stock summary ("lastMonth"). Returns null if no stock has prices.
function markowitzRunEndIndex(symbols, stocks):
    lastIndexes = []
    for symbol in symbols:
        stock = objectGet(stocks, symbol)
        if stock != null:
            arrayPush(lastIndexes, markowitzMonthIndex(objectGet(stock, 'lastMonth')))
        endif
    endfor
    if !arrayLength(lastIndexes):
        return null
    endif
    arraySort(lastIndexes, markowitzCompareDescending)
    return arrayGet(lastIndexes, mathCeil(markowitzRunEndFraction * arrayLength(lastIndexes)) - 1)
endfunction


# Compare values in descending order
function markowitzCompareDescending(a, b):
    return systemCompare(b, a)
endfunction


# Select a run's stocks - the stocks, not excluded, with prices from the analysis period's start month (the month
# before its first month) to its end month. The stocks are a map of symbol to stock summary ("firstMonth" and
# "lastMonth"). The end month index defaults to the stocks' (not excluded) default end month. Returns {"endIndex":
# monthIndex, "symbols": symbols, "excluded": exclusions} - the end month index is null if no stock has prices. An
# excluded stock without prices for the analysis period is excluded for its prices.
function markowitzRunSelect(symbols, stocks, endIndex, months, exclude):
    exclude = if(exclude != null, exclude, [])
    if endIndex == null:
        includedSymbols = []
        for symbol in symbols:
            if arrayIndexOf(exclude, symbol) == -1:
                arrayPush(includedSymbols, symbol)
            endif
        endfor
        endIndex = markowitzRunEndIndex(includedSymbols, stocks)
    endif

    # Exclude the stocks without prices for the analysis period, and the excluded stocks
    included = []
    excluded = []
    for symbol in symbols:
        stock = objectGet(stocks, symbol)
        reason = null
        if stock == null:
            reason = 'No prices - update the stock on the Stocks page'
        elif markowitzMonthIndex(objectGet(stock, 'firstMonth')) > endIndex - months:
            reason = 'Prices start in ' + objectGet(stock, 'firstMonth')
        elif markowitzMonthIndex(objectGet(stock, 'lastMonth')) < endIndex:
            reason = 'Prices end in ' + objectGet(stock, 'lastMonth')
        elif arrayIndexOf(exclude, symbol) != -1:
            reason = 'Excluded by the user'
        endif
        if reason != null:
            arrayPush(excluded, {'symbol': symbol, 'reason': reason})
        else:
            arrayPush(included, symbol)
        endif
    endfor
    return {'endIndex': endIndex, 'symbols': included, 'excluded': excluded}
endfunction
