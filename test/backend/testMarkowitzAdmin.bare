async function testMarkowitzAdminInit():
    fetchData = testAdminFetchData()
    objectSet(fetchData, testAdminServerURL + '/_session', testAdminSession)
    objectSet(fetchData, testAdminServerURL + '/_users', '{"db_name": "_users"}')
    objectSet(fetchData, testAdminServerURL + '/_replicator', '{"db_name": "_replicator"}')
    objectSet(fetchData, testAdminCouchURL, '{"db_name": "markowitz"}')
    objectSet(fetchData, testAdminCouchURL + '/_all_docs', jsonStringify({'rows': []}))
    objectSet(fetchData, testAdminCouchURL + '/group%3AGroup%20A', '{"ok": true}')
    objectSet(fetchData, testAdminCouchURL + '/group%3AGroup%20B', '{"ok": true}')
    objectSet(fetchData, testAdminCouchURL + '/_bulk_docs', '[]')
    result = testAdminRun(['init'], fetchData)
    unittestEqual(arrayGet(result, 0), 1)
    logs = []
    for call in arrayGet(result, 1):
        if arrayGet(call, 0) == 'systemLog':
            arrayPush(logs, arrayGet(arrayGet(call, 1), 0))
        endif
    endfor
    unittestDeepEqual(logs, [ \
        'The admin "admin" exists', \
        'The database "http://127.0.0.1:5984/_users" exists', \
        'The database "http://127.0.0.1:5984/_replicator" exists', \
        'The database "http://127.0.0.1:5984/markowitz" exists', \
        'Saved the group "Group A" (2 stocks)', \
        'Saved the group "Group B" (1 stocks)', \
        'Downloading 2 stocks\' prices...', \
        'Failed to update IBM: Download failed - is "IBM" a Yahoo Finance symbol?', \
        'Failed to update KO: Download failed - is "KO" a Yahoo Finance symbol?', \
        'Updated 0 of 2 stocks', \
        'Failed to update the stocks - is Yahoo Finance available?' \
    ])
endfunction
unittestRunTest('testMarkowitzAdminInit')


async function testMarkowitzAdminInit_updated():
    fetchData = testAdminFetchData()
    objectSet(fetchData, testAdminServerURL + '/_session', testAdminSession)
    objectSet(fetchData, testAdminServerURL + '/_users', '{"db_name": "_users"}')
    objectSet(fetchData, testAdminServerURL + '/_replicator', '{"db_name": "_replicator"}')
    objectSet(fetchData, testAdminCouchURL, '{"db_name": "markowitz"}')
    objectSet(fetchData, testAdminCouchURL + '/_all_docs', jsonStringify({'rows': []}))
    objectSet(fetchData, testAdminCouchURL + '/group%3AGroup%20A', '{"ok": true}')
    objectSet(fetchData, testAdminCouchURL + '/group%3AGroup%20B', '{"ok": true}')
    objectSet(fetchData, testAdminCouchURL + '/_bulk_docs', '[{"ok": true}]')
    yahooResponse = jsonStringify({'chart': {'result': [{ \
        'meta': {'regularMarketTime': 1791576000}, \
        'timestamp': [1788235200], \
        'indicators': {'adjclose': [{'adjclose': [12]}]} \
    }]}})
    objectSet(fetchData, markowitzYahooURL + 'KO' + markowitzYahooQuery, yahooResponse)
    calls = arrayGet(testAdminRun(['init'], fetchData), 1)
    unittestDeepEqual(arrayGet(calls, arrayLength(calls) - 1), testAdminLog('Updated 1 of 2 stocks'))
endfunction
unittestRunTest('testMarkowitzAdminInit_updated')


async function testMarkowitzAdminInit_addAdmin():
    fetchData = testAdminFetchData()
    objectSet(fetchData, testAdminServerURL + '/_session', jsonStringify({'ok': true, 'userCtx': {'name': null, 'roles': []}}))
    objectSet(fetchData, testAdminServerURL + '/_node/_local/_config/admins/admin', '""')
    objectSet(fetchData, testAdminServerURL + '/_users', '{"ok": true}')
    calls = arrayGet(testAdminRun(['init'], fetchData), 1)
    unittestDeepEqual(arraySlice(calls, 0, 9), testAdminConcat(testAdminServerCalls, [ \
        testAdminCall(testAdminServerURL + '/_session'), \
        testAdminCall( \
            testAdminServerURL + '/_node/_local/_config/admins/admin', 'PUT', {'Content-Type': 'application/json'}, '"secret"' \
        ), \
        testAdminLog('Added the admin "admin"'), \
        testAdminCall(testAdminServerURL + '/_users'), \
        testAdminLog('The database "http://127.0.0.1:5984/_users" exists'), \
        testAdminCall(testAdminServerURL + '/_replicator'), \
        testAdminCall(testAdminServerURL + '/_replicator', 'PUT'), \
        testAdminLog('Failed to create the database "http://127.0.0.1:5984/_replicator"') \
    ]))
    unittestEqual(arrayLength(calls), 9)
endfunction
unittestRunTest('testMarkowitzAdminInit_addAdmin')


async function testMarkowitzAdminInit_addAdminError():
    unittestDeepEqual(testAdminRun(['init'], testAdminFetchData()), [1, testAdminConcat(testAdminServerCalls, [ \
        testAdminCall(testAdminServerURL + '/_session'), \
        testAdminCall( \
            testAdminServerURL + '/_node/_local/_config/admins/admin', 'PUT', {'Content-Type': 'application/json'}, '"secret"' \
        ), \
        testAdminLog( \
            'Failed to add the admin "admin" - if CouchDB has an admin, set MARKOWITZ_COUCH_CREDENTIALS to its "user:password"' \
        ) \
    ])])
endfunction
unittestRunTest('testMarkowitzAdminInit_addAdminError')


async function testMarkowitzAdminInit_noCredentials():
    for credentials in ['', 'admin', ':secret']:
        systemGlobalSet('markowitzCouchCredentials', credentials)
        unittestDeepEqual(testAdminRun(['init'], testAdminFetchData()), [1, testAdminConcat(testAdminServerCalls, [ \
            testAdminLog('Set MARKOWITZ_COUCH_CREDENTIALS to the CouchDB admin\'s "user:password"') \
        ])])
    endfor
    systemGlobalSet('markowitzCouchCredentials', 'admin:secret')
endfunction
unittestRunTest('testMarkowitzAdminInit_noCredentials')


async function testMarkowitzAdminInit_createDatabase():
    fetchData = testAdminFetchData()
    objectSet(fetchData, testAdminServerURL + '/_session', testAdminSession)
    objectSet(fetchData, testAdminServerURL + '/_users', '{"ok": true}')
    objectSet(fetchData, testAdminServerURL + '/_replicator', '{"ok": true}')
    objectSet(fetchData, testAdminCouchURL + '/_all_docs', jsonStringify({'rows': []}))
    calls = arrayGet(testAdminRun(['init'], fetchData), 1)
    unittestDeepEqual(arraySlice(calls, 7), [ \
        testAdminCall(testAdminCouchURL), \
        testAdminCall(testAdminCouchURL, 'PUT'), \
        testAdminLog('Failed to create the database "http://127.0.0.1:5984/markowitz"') \
    ])
endfunction
unittestRunTest('testMarkowitzAdminInit_createDatabase')


