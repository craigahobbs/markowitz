        testAction('POST', '/updateStocks', '', {'symbols': []}), \
        ['400 Bad Request', { \
            'error': 'InvalidInput', \
            'member': 'symbols', \
            'message': 'Invalid value [] (type "array") for member "symbols", expected type "array" [len > 0] (content)' \
        }] \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testUpdateStocks_invalidInput')


