#
# createRun tests
#


# The createRun test fetch mock data - the "Test" group of stock symbols, and the stock documents and run ID, if any
function testCreateRunData(symbols, docs, id):
    group = {'_id': 'group:Test', '_rev': '1-abc', 'type': 'group', 'name': 'Test', 'symbols': symbols}
    fetchData = objectNew(testCouchURL + '/group%3ATest', jsonStringify(group))
    if docs != null:
        objectSet(fetchData, testCouchURL + '/_find', jsonStringify({'docs': docs}))
    endif
    if id != null:
        objectSet(fetchData, testCouchURL, jsonStringify({'ok': true, 'id': id, 'rev': '1-abc'}))
    endif
    return {'systemFetch': fetchData}
endfunction


# Get the run document posted by a createRun call log
function testCreateRunDoc(calls):
    return jsonParse(objectGet(arrayGet(arrayGet(arrayGet(calls, 2), 1), 0), 'body'))
endfunction


async function testCreateRun():
    testMockAll(testCreateRunData(['D', 'C', 'B', 'A'], testStockDocs(), 'run1'))
    request = {'name': 'Test Run', 'group': 'Test', 'endMonth': '2023-01', 'targets': testTargets}
    unittestDeepEqual(testAction('POST', '/createRun', '', request), ['200 OK', {'id': 'run1'}])
    calls = unittestMockEnd()
    unittestEqual(arrayLength(calls), 3)
    unittestDeepEqual(arrayGet(calls, 0), testCouchCall('/group%3ATest'))
    unittestDeepEqual(arrayGet(calls, 1), testCreateRunFindCall(testSymbols))

    # The run document - the statistics and portfolios match the original program's
    postRequest = arrayGet(arrayGet(arrayGet(calls, 2), 1), 0)
    unittestEqual(objectGet(postRequest, 'url'), testCouchURL)
    unittestDeepEqual(objectGet(postRequest, 'headers'), testCouchHeaders)
    unittestDeepEqual(testRound(jsonParse(objectGet(postRequest, 'body'))), testRound({ \
        'type': 'run', \
        'name': 'Test Run', \
        'created': testNowISO, \
        'symbols': testSymbols, \
        'group': 'Test', \
        'endMonth': '2023-01', \
        'months': 36, \
        'horizon': 3, \
        'targets': testTargets, \
        'stocks': testRunStocks, \
        'portfolios': [], \
        'excluded': [], \
        'running': true, \
        'relatives': testAnalysisRelatives, \
        'horizonRelatives': testHorizonRelatives \
    }))
endfunction
unittestRunTest('testCreateRun')


async function testCreateRun_defaultEndMonth():
    testMockAll(testCreateRunData(testSymbols, testStockDocs(), 'run2'))
    request = {'name': 'Test Run', 'group': 'Test', 'months': 24, 'horizon': 1, 'targets': [20]}
    unittestDeepEqual(testAction('POST', '/createRun', '', request), ['200 OK', {'id': 'run2'}])
    run = testCreateRunDoc(unittestMockEnd())

    # The projection months have not passed - there are no realized returns
    unittestEqual(objectGet(run, 'endMonth'), '2023-04')
    unittestEqual(objectGet(run, 'months'), 24)
    unittestEqual(objectGet(run, 'horizon'), 1)
    for stock in objectGet(run, 'stocks'):
        unittestEqual(objectHas(stock, 'realizedReturn'), false)
    endfor
    unittestDeepEqual(objectGet(run, 'horizonRelatives'), [null, null, null, null])
endfunction
unittestRunTest('testCreateRun_defaultEndMonth')


