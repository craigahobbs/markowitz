async function testMarkowitzOnUpdateStocks():
    args = {'page': 'stocks'}
    data = { \
        'documentInputValue': {'markowitz-symbols': ' msft,xyz '}, \
        'systemFetch': { \
            'getStocks': jsonStringify({'stocks': testStocks}), \
            'updateStocks': jsonStringify({'results': [ \
                {'symbol': 'MSFT', 'stock': arrayGet(testStocks, 0)}, \
                {'symbol': 'XYZ', 'error': 'Download failed'} \
            ]}) \
        } \
    }
    unittestMockAll(data)
    markowitzOnUpdateStocks(args, null)
    calls = unittestMockEnd()
    unittestDeepEqual(arraySlice(calls, 0, 2), [ \
        ['documentInputValue', ['markowitz-symbols']], \
        ['systemFetch', [{'url': 'updateStocks', 'body': '{"symbols":["msft","xyz"]}'}]] \
    ])
    message = 'Updated MSFT. Failed XYZ (Download failed).'
    unittestDeepEqual(arraySlice(calls, 2), testPageCalls(systemPartial(markowitzStocksPage, args, message), data))
endfunction
unittestRunTest('testMarkowitzOnUpdateStocks')


