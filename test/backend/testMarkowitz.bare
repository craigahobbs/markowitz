#
# getRuns tests
#


async function testGetRuns():
    run1 = { \
        '_id': 'run1', 'name': 'Run 1', 'created': '2026-10-01T09:00:00-07:00', 'symbols': ['A', 'B'], \
        'endMonth': '2026-06', 'months': 36, 'horizon': 3, 'targets': [10] \
    }
    run2 = objectAssign(objectCopy(run1), {'_id': 'run2', 'name': 'Run 2', 'created': '2026-10-01T12:00:00-04:00', 'group': 'Test'})
    run3 = objectAssign(objectCopy(run1), {'_id': 'run3', 'name': 'Run 3', 'created': '2026-10-01T08:00:00-07:00'})
    testMockAll({'systemFetch': objectNew(testCouchURL + '/_find', jsonStringify({'docs': [run3, run1, run2]}))})
    info1 = objectAssign({'id': 'run1'}, run1)
    objectDelete(info1, '_id')
    info2 = objectAssign(objectCopy(info1), {'id': 'run2', 'name': 'Run 2', 'created': '2026-10-01T12:00:00-04:00', 'group': 'Test'})
    info3 = objectAssign(objectCopy(info1), {'id': 'run3', 'name': 'Run 3', 'created': '2026-10-01T08:00:00-07:00'})
    unittestDeepEqual(testAction('GET', '/getRuns', '', null), ['200 OK', {'runs': [info1, info2, info3]}])
    unittestDeepEqual(unittestMockEnd(), [ \
        testCouchCall('/_find', {'selector': {'type': 'run'}, 'fields': markowitzRunInfoFields, 'limit': 100000}) \
    ])
endfunction
unittestRunTest('testGetRuns')


async function testGetRuns_databaseError():
