# The new run page's calls - the header, the message, the stock group, the selection list, the group's stocks without
# prices warning and minimum analysis period (if a group is selected), and the form
function testNewRunCalls(fetchCalls, backURL, message, groupCall, selecting, form, minimumText, missingText):
    calls = arrayCopy(fetchCalls)
    arrayExtend(calls, testHeaderCalls('New Run', 'New Run', backURL))
    arrayPush(calls, groupCall)
    if selecting:
        arrayPush(calls, testGroupListCall)
    endif
    if missingText != null:
        arrayPush(calls, ['markdownPrint', [missingText, '']])
    endif
    if minimumText != null:
        arrayPush(calls, ['markdownPrint', [minimumText, '']])
    endif
    arrayExtend(calls, testFormCalls(form, minimumText != null, message))
    return calls
endfunction


# The new run page's fetch calls
testNewRunFetchCalls = [['systemFetch', ['getStocks']], ['systemFetch', ['getGroups']]]


# Ten stocks with long price histories and three with 8, 12, and 50 months of prices - the minimum analysis period is
# 12 months, with 12 stocks
