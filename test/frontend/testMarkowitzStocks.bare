async function testMarkowitzOnUpdateStock():
    args = {'page': 'stock', 'symbol': 'IBM'}
    data = {'systemFetch': { \
        'getStock?symbol=IBM': jsonStringify({'stock': arrayGet(testStocks, 0), 'prices': {'2026-07': 9}}), \
        'updateStocks': jsonStringify({'results': [{'symbol': 'IBM', 'stock': arrayGet(testStocks, 0)}]}) \
    }}
    unittestMockAll(data)
    markowitzOnUpdateStock(args, 'IBM')
    calls = unittestMockEnd()
    unittestDeepEqual(arrayGet(calls, 0), ['systemFetch', [{'url': 'updateStocks', 'body': '{"symbols":["IBM"]}'}]])
    unittestDeepEqual(arraySlice(calls, 1), testPageCalls(systemPartial(markowitzStockPage, args, 'Updated IBM.'), data))
endfunction
unittestRunTest('testMarkowitzOnUpdateStock')


async function testMarkowitzOnDeleteStock():
    unittestMockAll({'systemFetch': {'deleteStock': '{}'}})
    markowitzOnDeleteStock({'page': 'stock', 'symbol': 'IBM'}, 'IBM')
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemFetch', [{'url': 'deleteStock', 'body': '{"symbol":"IBM"}'}]], \
        ['windowSetLocation', ["#var.vPage='stocks'"]] \
    ])
endfunction
unittestRunTest('testMarkowitzOnDeleteStock')


async function testMarkowitzOnDeleteStock_error():
    args = {'page': 'stock', 'symbol': 'IBM'}
    data = {'systemFetch': {'getStock?symbol=IBM': jsonStringify({'stock': arrayGet(testStocks, 0), 'prices': {'2026-07': 9}})}}
    unittestMockAll(data)
    markowitzOnDeleteStock(args, 'IBM')
    calls = unittestMockEnd()
    unittestDeepEqual(arrayGet(calls, 0), ['systemFetch', [{'url': 'deleteStock', 'body': '{"symbol":"IBM"}'}]])
    unittestDeepEqual(arraySlice(calls, 1), testPageCalls(systemPartial(markowitzStockPage, args, 'The stock could not be deleted.'), data))
endfunction
unittestRunTest('testMarkowitzOnDeleteStock_error')
