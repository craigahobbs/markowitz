async function testDeleteRun():
    fetchData = {}
    objectSet(fetchData, testCouchURL + '/run1', jsonStringify({'_id': 'run1', '_rev': '1-abc', 'type': 'run'}))
    objectSet(fetchData, testCouchURL + '/run1?rev=1-abc', '{"ok": true}')
    testMockAll({'systemFetch': fetchData})
    unittestDeepEqual(testAction('POST', '/deleteRun', '', {'id': 'run1'}), ['200 OK', {}])
    unittestDeepEqual(unittestMockEnd(), [ \
        testCouchCall('/run1'), \
        testCouchCall('/run1?rev=1-abc', null, 'DELETE') \
    ])
endfunction
unittestRunTest('testDeleteRun')


