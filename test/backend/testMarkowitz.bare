include <unittest.bare>
include <unittestMock.bare>


# The static files the host passes to the backend
markowitzStatics = {'/index.html': 'frontend/index.html'}

# The database credentials the host passes to the backend
markowitzCouchCredentials = 'admin:secret'


include '../../backend/markowitz.bare'
include 'testMarkowitzHelpers.bare'


# The test time
testNow = datetimeNew(2026, 10, 10, 12, 30, 0)
testNowISO = datetimeISOFormat(testNow)


# Call the application with a request - returns [status, response object]
async function testAction(method, path, query, body):
    response = markowitzApplication({ \
        'REQUEST_METHOD': method, \
        'PATH_INFO': path, \
        'QUERY_STRING': query, \
        'wsgi.input': if(body != null, jsonStringify(body), '') \
    })
    return [objectGet(response, 'status'), jsonParse(objectGet(response, 'content'))]
endfunction


# Start mocking, with the test time
function testMockAll(data):
    unittestMockAll(data)
    unittestMockOne('datetimeNow', testDatetimeNow)
endfunction

function testDatetimeNow():
    return testNow
endfunction


# A CouchDB request call log entry
function testCouchCall(path, body, method):
    request = {'url': testCouchURL + path, 'headers': testCouchHeaders}
    if body != null:
        objectSet(request, 'body', jsonStringify(body))
    endif
    if method != null:
        objectSet(request, 'method', method)
    endif
    return ['systemFetch', [request]]
endfunction


# Create a test stock's prices from its relatives - 100 in 2020-01
function testPrices(relatives):
    monthIndex = markowitzMonthIndex('2020-01')
    price = 100
    prices = objectNew('2020-01', price)
    for relative in relatives:
        monthIndex = monthIndex + 1
        price = price * relative
        objectSet(prices, markowitzMonthString(monthIndex), price)
    endfor
    return prices
endfunction


# The test stock documents' run fields - the test stocks, by default
function testStockDocs(symbols):
    docs = []
    for symbol, ixSymbol in if(symbols != null, symbols, testSymbols):
        relatives = arrayGet(testRelatives, ixSymbol % arrayLength(testRelatives))
        arrayPush(docs, {'symbol': symbol, 'firstMonth': '2020-01', 'lastMonth': '2023-04', 'prices': testPrices(relatives)})
    endfor
    return docs
endfunction


# The test createRun stock document query
function testCreateRunFindCall(symbols):
    return testCouchCall('/_find', { \
        'selector': {'type': 'stock', 'symbol': {'$in': symbols}}, \
        'fields': ['symbol', 'firstMonth', 'lastMonth', 'prices'], \
        'limit': 100000 \
    })
endfunction


# The test Yahoo Finance chart API URL
function testYahooURL(symbol):
    return 'https://query1.finance.yahoo.com/v8/finance/chart/' + symbol + \
        '?period1=-2208988800&period2=9999999999&interval=1mo'
endfunction


#
# Application tests
#


async function testMarkowitzApplication():
    response = markowitzApplication({'REQUEST_METHOD': 'GET', 'PATH_INFO': '/doc/', 'QUERY_STRING': '', 'wsgi.input': ''})
    unittestEqual(objectGet(response, 'status'), '200 OK')
endfunction
unittestRunTest('testMarkowitzApplication')


async function testMarkowitzApplication_static():
    response = markowitzApplication({'REQUEST_METHOD': 'GET', 'PATH_INFO': '/index.html', 'QUERY_STRING': '', 'wsgi.input': ''})
    unittestEqual(objectGet(response, 'status'), '200 OK')
    unittestDeepEqual(objectGet(response, 'headers'), [['Content-Type', 'text/html; charset=utf-8']])
    unittestEqual(stringIndexOf(objectGet(response, 'content'), '<title>Markowitz</title>') != -1, true)
endfunction
unittestRunTest('testMarkowitzApplication_static')


# A request environ from a page's origin (e.g. "http://127.0.0.1:8080") to the deleteGroup action
function testOriginEnviron(origin):
    return { \
        'REQUEST_METHOD': 'POST', \
        'PATH_INFO': '/deleteGroup', \
        'QUERY_STRING': '', \
        'wsgi.input': '{"name": "Dow 30"}', \
        'wsgi.url_scheme': 'http', \
        'HTTP_HOST': '127.0.0.1:8080', \
        'HTTP_ORIGIN': origin \
    }
endfunction


async function testMarkowitzApplication_sameOrigin():
    # The action is called - its database request fails
    testMockAll({})
    response = markowitzApplication(testOriginEnviron('http://127.0.0.1:8080'))
    unittestEqual(arrayLength(unittestMockEnd()), 1)
    unittestEqual(objectGet(response, 'status'), '500 Internal Server Error')
endfunction
unittestRunTest('testMarkowitzApplication_sameOrigin')


async function testMarkowitzApplication_crossOrigin():
    testMockAll({})
    unittestDeepEqual( \
        markowitzApplication(testOriginEnviron('https://example.com')), \
        {'status': '403 Forbidden', 'headers': [['Content-Type', 'text/plain; charset=utf-8']], 'content': '403 Forbidden'} \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testMarkowitzApplication_crossOrigin')


#
# getStocks tests
#


async function testGetStocks():
    stockIBM = { \
        'symbol': 'IBM', 'name': 'International Business Machines', 'currency': 'USD', \
        'firstMonth': '1962-01', 'lastMonth': '2026-09', 'monthCount': 777, 'updated': testNowISO \
    }
    stockKO = {'symbol': 'KO', 'firstMonth': '1985-01', 'lastMonth': '2026-09', 'monthCount': 501, 'updated': testNowISO}
    findKO = objectCopy(stockKO)
    objectSet(findKO, 'name', null)
    testMockAll({'systemFetch': objectNew(testCouchURL + '/_find', jsonStringify({'docs': [findKO, stockIBM]}))})
    unittestDeepEqual(testAction('GET', '/getStocks', '', null), ['200 OK', {'stocks': [stockIBM, stockKO]}])
    unittestDeepEqual(unittestMockEnd(), [ \
        testCouchCall('/_find', {'selector': {'type': 'stock'}, 'fields': markowitzStockInfoFields, 'limit': 100000}) \
    ])
endfunction
unittestRunTest('testGetStocks')


async function testGetStocks_databaseError():
    testMockAll({})
    unittestDeepEqual( \
        testAction('GET', '/getStocks', '', null), \
        ['500 Internal Server Error', {'error': 'DatabaseError', 'message': 'The database request failed'}] \
    )
    unittestEqual(arrayLength(unittestMockEnd()), 1)
endfunction
unittestRunTest('testGetStocks_databaseError')


