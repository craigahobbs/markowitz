# The static files the host passes to the backend
markowitzStatics = {'/index.html': 'frontend/index.html'}

# The database credentials the host passes to the backend
markowitzCouchCredentials = 'admin:secret'


include '../../backend/markowitz.bare'


# The test database URL and headers
