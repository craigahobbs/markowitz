include <schemaParser.bare>


# The Markowitz API's Schema Markdown types - shared by the backend, which serves the API, and the frontend,
# which validates its requests
markowitzTypes = schemaParse( \
    '# The errors common to every action', \
    'enum MarkowitzError', \
    '', \
    '    # The database request failed', \
    '    DatabaseError', \
    '', \
    '', \
    '# A stock symbol (e.g. "IBM")', \
    'typedef string(len > 0, len <= 20) Symbol', \
    '', \
    '', \
    '# A month string, "YYYY-MM" (e.g. "1967-06")', \
    'typedef string(len == 7) Month', \
    '', \
    '', \
    '# A stock group name (e.g. "S&P 100")', \
    'typedef string(len > 0, len <= 100) GroupName', \
    '', \
    '', \
    '# A stock excluded from a run, and why', \
    'struct Exclusion', \
    '', \
    '    # The stock symbol', \
    '    string symbol', \
    '', \
    '    # The reason the stock was excluded (e.g. "Prices start in 2021-03")', \
    '    string reason', \
    '', \
    '', \
    'group "Stocks"', \
    '', \
    '', \
    '# A stock\'s summary', \
    'struct StockInfo', \
    '', \
    '    # The stock symbol', \
    '    string symbol', \
    '', \
    '    # The stock\'s name', \
    '    optional string name', \
    '', \
    '    # The price currency (e.g. "USD")', \
    '    optional string currency', \
    '', \
    '    # The first month with a price', \
    '    Month firstMonth', \
    '', \
    '    # The last month with a price', \
    '    Month lastMonth', \
    '', \
    '    # The number of months with a price', \
    '    int monthCount', \
    '', \
    '    # The time the stock\'s prices were downloaded', \
    '    datetime updated', \
    '', \
    '', \
    '# A stock update\'s result', \
    'struct StockUpdate', \
    '', \
    '    # The stock symbol', \
    '    string symbol', \
    '', \
    '    # The updated stock\'s summary - absent if the update failed', \
    '    optional StockInfo stock', \
    '', \
    '    # The update\'s error message - absent if the update succeeded', \
    '    optional string error', \
    '', \
    '', \
    '# Get the stocks', \
    'action getStocks', \
    '    urls', \
    '        GET', \
    '', \
    '    output', \
    '', \
    '        # The stocks, sorted by symbol', \
    '        StockInfo[] stocks', \
    '', \
    '    errors (MarkowitzError)', \
    '', \
    '', \
    '# Get a stock and its monthly prices', \
    'action getStock', \
    '    urls', \
    '        GET', \
    '', \
    '    query', \
    '', \
    '        # The stock symbol', \
    '        Symbol symbol', \
    '', \
    '    output', \
    '', \
    '        # The stock\'s summary', \
    '        StockInfo stock', \
    '', \
    '        # The map of month ("YYYY-MM") to month-end price, adjusted for splits and dividends', \
    '        float{} prices', \
    '', \
    '    errors (MarkowitzError)', \
    '', \
    '        # The stock is unknown', \
    '        UnknownStock', \
    '', \
    '', \
    '# Download stocks\' monthly prices and add or update them in the database - the stock symbols, the group\'s stocks,', \
    '# and every stock in the database, if "all" is true', \
    'action updateStocks', \
    '    input', \
    '', \
    '        # The stock symbols', \
    '        optional Symbol[len > 0, len <= 50] symbols', \
    '', \
    '        # The stock group', \
    '        optional GroupName group', \
    '', \
    '        # If true, update every stock in the database', \
    '        optional bool all', \
    '', \
    '    output', \
    '', \
    '        # The update results, in symbol order', \
    '        StockUpdate[] results', \
    '', \
    '    errors (MarkowitzError)', \
    '', \
    '        # The group is unknown', \
    '        UnknownGroup', \
    '', \
    '', \
    '# Delete a stock', \
    'action deleteStock', \
    '    input', \
    '', \
    '        # The stock symbol', \
    '        Symbol symbol', \
    '', \
    '    errors (MarkowitzError)', \
    '', \
    '        # The stock is unknown', \
    '        UnknownStock', \
    '', \
    '', \
    'group "Groups"', \
    '', \
    '', \
    '# A stock group (e.g. "S&P 100")', \
    'struct Group', \
    '', \
    '    # The group name', \
    '    string name', \
    '', \
    '    # The group\'s stock symbols, sorted', \
    '    string[] symbols', \
    '', \
    '', \
    '# Get the stock groups', \
    'action getGroups', \
    '    urls', \
    '        GET', \
    '', \
    '    output', \
    '', \
    '        # The groups, sorted by name', \
    '        Group[] groups', \
    '', \
    '    errors (MarkowitzError)', \
    '', \
    '', \
    '# Get a stock group and its stocks', \
    'action getGroup', \
    '    urls', \
    '        GET', \
    '', \
    '    query', \
    '', \
    '        # The group name', \
    '        GroupName name', \
    '', \
    '    output', \
    '', \
    '        # The group', \
    '        Group group', \
    '', \
    '        # The group\'s stocks in the database, sorted by symbol', \
    '        StockInfo[] stocks', \
    '', \
    '    errors (MarkowitzError)', \
    '', \
    '        # The group is unknown', \
    '        UnknownGroup', \
    '', \
    '', \
    '# Create or update a stock group', \
    'action setGroup', \
    '    input', \
    '', \
    '        # The group name', \
    '        GroupName name', \
    '', \
    '        # The group\'s stock symbols', \
    '        Symbol[len > 0, len <= 1000] symbols', \
    '', \
    '    errors (MarkowitzError)', \
    '', \
    '', \
    '# Delete a stock group', \
    'action deleteGroup', \
    '    input', \
    '', \
    '        # The group name', \
    '        GroupName name', \
    '', \
    '    errors (MarkowitzError)', \
    '', \
    '        # The group is unknown', \
    '        UnknownGroup', \
    '', \
    '', \
    'group "Runs"', \
    '', \
    '', \
    '# A run\'s summary', \
    'struct RunInfo', \
    '', \
    '    # The run ID', \
    '    string id', \
    '', \
    '    # The run name', \
    '    string name', \
    '', \
    '    # The time the run was created', \
    '    datetime created', \
    '', \
    '    # The portfolio stock symbols - the stocks with a price for every month of the analysis period', \
    '    string[] symbols', \
    '', \
    '    # The stock group - absent for a run of stock symbols (no longer supported)', \
    '    optional string group', \
    '', \
    '    # The last month of the analysis period', \
    '    Month endMonth', \
    '', \
    '    # The number of months in the analysis period', \
    '    int months', \
    '', \
    '    # The number of months, following the analysis period, of the projection', \
    '    int horizon', \
    '', \
    '    # The target annual returns, in percent', \
    '    float[] targets', \
    '', \
    '    # If true, the run\'s portfolios are being computed (see computeRunPortfolio) - absent when complete', \
    '    optional bool running', \
    '', \
    '', \
    '# A run - its portfolio stocks\' statistics and a portfolio for each target return', \
    'struct Run (RunInfo)', \
    '', \
    '    # The portfolio stocks\' statistics', \
    '    RunStock[] stocks', \
    '', \
    '    # The portfolios, one for each target return (in target return order) - fewer while the run is running', \
    '    Portfolio[] portfolios', \
    '', \
    '    # The stocks excluded from the run - stocks without a price for every month of the analysis period', \
    '    optional Exclusion[] excluded', \
    '', \
    '', \
    '# A run stock\'s statistics', \
    'struct RunStock', \
    '', \
    '    # The stock symbol', \
    '    string symbol', \
    '', \
    '    # The projected annual return, in percent, from the analysis period\'s monthly return trend', \
    '    float expectedReturn', \
    '', \
    '    # The variance of the monthly returns, in percent, about their trend', \
    '    float variance', \
    '', \
    '    # The annualized return, in percent, realized over the projection months - absent if the months', \
    '    # have not passed', \
    '    optional float realizedReturn', \
    '', \
    '', \
    '# A target return\'s minimum-variance portfolio', \
    'struct Portfolio', \
    '', \
    '    # The target annual return, in percent', \
    '    float target', \
    '', \
    '    # If false, there is no solution - the target return is not attainable', \
    '    bool solved', \
    '', \
    '    # The portfolio allocations, in symbol order', \
    '    Allocation[] allocations', \
    '', \
    '    # The stocks deleted from the portfolio for negative allocations, in order of deletion', \
    '    string[] deleted', \
    '', \
    '    # The deleted stocks\' (negative) allocations when they were deleted, in order of deletion', \
    '    optional float[] deletedWeights', \
    '', \
    '    # The variance of the portfolio\'s monthly returns, in percent', \
    '    optional float variance', \
    '', \
    '    # The portfolio\'s annualized return, in percent, realized over the projection months - absent', \
    '    # if the months have not passed', \
    '    optional float realizedReturn', \
    '', \
    '', \
    '# A portfolio allocation', \
    'struct Allocation', \
    '', \
    '    # The stock symbol', \
    '    string symbol', \
    '', \
    '    # The fraction of the portfolio to invest in the stock', \
    '    float weight', \
    '', \
    '', \
    '# Get the runs', \
    'action getRuns', \
    '    urls', \
    '        GET', \
    '', \
    '    output', \
    '', \
    '        # The runs, most recent first', \
    '        RunInfo[] runs', \
    '', \
    '    errors (MarkowitzError)', \
    '', \
    '', \
    '# Get a run', \
    'action getRun', \
    '    urls', \
    '        GET', \
    '', \
    '    query', \
    '', \
    '        # The run ID', \
    '        string id', \
    '', \
    '    output', \
    '', \
    '        # The run', \
    '        Run run', \
    '', \
    '    errors (MarkowitzError)', \
    '', \
    '        # The run is unknown', \
    '        UnknownRun', \
    '', \
    '', \
    '# Start a run - compute the minimum-variance portfolio for each target return from the stocks\' monthly', \
    '# returns, the method of Harry Markowitz, as ported from a 1967 Fortran program. Stocks without a price for', \
    '# every month of the analysis period are excluded. The run is created running, with its stocks\' statistics -', \
    '# call computeRunPortfolio to compute each of its portfolios.', \
    'action createRun', \
    '    input', \
    '', \
    '        # The run name', \
    '        string(len > 0, len <= 100) name', \
    '', \
    '        # The stock group whose stocks are the portfolio stocks', \
    '        GroupName group', \
    '', \
    '        # The group\'s stocks to exclude from the run', \
    '        optional Symbol[len <= 1000] exclude', \
    '', \
    '        # The last month of the analysis period (default is the latest month for which most stocks, not', \
    '        # excluded, have a price - stocks whose prices end earlier are excluded)', \
    '        optional Month endMonth', \
    '', \
    '        # The number of months in the analysis period (default is 36)', \
    '        optional int(>= 6, <= 600) months', \
    '', \
    '        # The number of months, following the analysis period, of the projection (default is 3)', \
    '        optional int(>= 1, <= 12) horizon', \
    '', \
    '        # The target annual returns, in percent', \
    '        float(> -100, <= 1000)[len > 0, len <= 30] targets', \
    '', \
    '    output', \
    '', \
    '        # The new run\'s ID', \
    '        string id', \
    '', \
    '    errors (MarkowitzError)', \
    '', \
    '        # The end month is not a "YYYY-MM" month', \
    '        InvalidMonth', \
    '', \
    '        # The group is unknown', \
    '        UnknownGroup', \
    '', \
    '        # Fewer than two stocks have a price for every month of the analysis period', \
    '        TooFewStocks', \
    '', \
    '        # There are more stocks than months in the analysis period - the problem is singular', \
    '        TooManyStocks', \
    '', \
    '', \
    '# Compute a running run\'s next portfolio (the next target return\'s) - when every target return has a', \
    '# portfolio, the run is complete', \
    'action computeRunPortfolio', \
    '    input', \
    '', \
    '        # The run ID', \
    '        string id', \
    '', \
    '    output', \
    '', \
    '        # The number of the run\'s portfolios computed', \
    '        int portfolios', \
    '', \
    '        # The number of the run\'s target returns', \
    '        int targets', \
    '', \
    '    errors (MarkowitzError)', \
    '', \
    '        # The run is unknown', \
    '        UnknownRun', \
    '', \
    '        # The run is complete', \
    '        RunComplete', \
    '', \
    '', \
    '# Delete a run', \
    'action deleteRun', \
    '    input', \
    '', \
    '        # The run ID', \
    '        string id', \
    '', \
    '    errors (MarkowitzError)', \
    '', \
    '        # The run is unknown', \
    '        UnknownRun' \
)
