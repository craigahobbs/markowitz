        'stock': { \
            'symbol': 'IBM', 'name': 'IBM', 'currency': 'USD', 'firstMonth': '2026-07', 'lastMonth': '2026-08', \
            'monthCount': 2, 'updated': testNowISO \
        }, \
        'prices': {'2026-07': 9, '2026-08': 10} \
    }])
    unittestDeepEqual(unittestMockEnd(), [testCouchCall('/stock%3AIBM')])
endfunction
