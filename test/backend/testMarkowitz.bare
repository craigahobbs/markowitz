        { \
            'target': 10, 'solved': true, 'allocations': [{'symbol': 'A', 'weight': 0.6}, {'symbol': 'B', 'weight': 0.4}], \
            'deleted': [], 'variance': 9, 'realizedReturn': 5 \
        }, \
        {'target': 20, 'solved': false, 'allocations': [], 'deleted': ['B']} \
    ]
    doc = { \
        '_id': 'run1', '_rev': '1-abc', 'type': 'run', 'name': 'Run 1', 'created': testNowISO, 'symbols': ['A', 'B'], \
        'endMonth': '2026-06', 'months': 36, 'horizon': 3, 'targets': [10, 20], 'stocks': stocks, 'portfolios': portfolios \
    }
    testMockAll({'systemFetch': objectNew(testCouchURL + '/run1', jsonStringify(doc))})
    unittestDeepEqual(testAction('GET', '/getRun', 'id=run1', null), ['200 OK', {'run': { \
        'id': 'run1', 'name': 'Run 1', 'created': testNowISO, 'symbols': ['A', 'B'], 'endMonth': '2026-06', \
        'months': 36, 'horizon': 3, 'targets': [10, 20], 'stocks': stocks, 'portfolios': portfolios \
    }}])
