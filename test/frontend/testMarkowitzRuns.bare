include <dataLineChart.bare>
include <forms.bare>
include <unittest.bare>
include <unittestMock.bare>
include '../../frontend/markowitzRuns.bare'
include 'testMarkowitzHelpers.bare'


# The test run with excluded stocks
testRunExcluded = objectCopy(testRun)
objectSet(testRunExcluded, 'excluded', [ \
    {'symbol': 'E', 'reason': 'Prices start in 2021-03'}, \
    {'symbol': 'D', 'reason': 'Prices end in 2023-01'} \
])
objectSet(testRunExcluded, 'portfolios', jsonParse(jsonStringify(objectGet(testRun, 'portfolios'))))
objectSet(arrayGet(objectGet(testRunExcluded, 'portfolios'), 1), 'deletedWeights', [-0.05606])


# A test running run's progress - from the new run page, by default
function testRunProgress(count, args):
    return {'args': if(args != null, args, {'page': 'new'}), 'id': 'r1', 'name': 'Blue <Chips>', 'count': count, 'total': 3}
endfunction


#
# Runs page tests
#


async function testMarkowitzRunsPage():
    groupRun = { \
        'id': 'r2', 'name': 'Group Run', 'created': testCreated, 'symbols': ['A', 'B'], 'group': 'Tech | AI', \
        'endMonth': '2023-01', 'months': 36, 'horizon': 3, 'targets': [10] \
    }
    unittestMockAll({'systemFetch': {'getRuns': jsonStringify({'runs': [testRun, groupRun]})}})
    markowitzRunsPage()
    expected = testHeaderCalls('Markowitz', 'Markowitz')
    arrayPush(expected, \
        ['systemFetch', ['getRuns']], \
        ['markdownPrint', [[ \
            '| Run                                             | Created          | Stocks | Group      | Analysis Period      | Targets                |', \
            '|-------------------------------------------------|------------------|-------:|------------|----------------------|------------------------|', \
            "| [Blue \\<Chips\\>](#var.vId='r1'&var.vPage='run') | 2026-10-10 12:30 |      4 |            | 36 months to 2023-01 | 6.17%, 19.56%, 151.80% |", \
            "| [Group Run](#var.vId='r2'&var.vPage='run')      | 2026-10-10 12:30 |      2 | Tech \\| AI | 36 months to 2023-01 | 10.00%                 |" \
        ]]] \
    )
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction
unittestRunTest('testMarkowitzRunsPage')


async function testMarkowitzRunsPage_incomplete():
    run = objectAssign(objectCopy(testRun), {'running': true})
    unittestMockAll({'systemFetch': {'getRuns': jsonStringify({'runs': [run]})}})
    markowitzRunsPage()
    table = arrayGet(arrayGet(arrayGet(unittestMockEnd(), 3), 1), 0)
    unittestEqual(stringIndexOf(arrayGet(table, 2), "[Blue \\<Chips\\>](#var.vId='r1'&var.vPage='run') (incomplete)") != -1, true)
endfunction
unittestRunTest('testMarkowitzRunsPage_incomplete')


async function testMarkowitzRunsPage_empty():
    unittestMockAll({'systemFetch': {'getRuns': jsonStringify({'runs': []})}})
    markowitzRunsPage()
    expected = testHeaderCalls('Markowitz', 'Markowitz')
    arrayPush(expected, \
        ['systemFetch', ['getRuns']], \
        ['markdownPrint', ["There are no runs. [Start a run](#var.vPage='new')."]] \
    )
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction
unittestRunTest('testMarkowitzRunsPage_empty')


async function testMarkowitzRunsPage_error():
    unittestMockAll({})
    markowitzRunsPage()
    expected = testHeaderCalls('Markowitz', 'Markowitz')
    arrayPush(expected, ['systemFetch', ['getRuns']], ['markdownPrint', ['**Error:** The runs could not be loaded.']])
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction
unittestRunTest('testMarkowitzRunsPage_error')


#
# Run page tests
#


async function testMarkowitzRunPage():
    args = {'page': 'run', 'id': 'r1'}
    unittestMockAll({'systemFetch': {'getRun?id=r1': jsonStringify({'run': testRunExcluded})}})
    markowitzRunPage(args)
    expected = [['systemFetch', ['getRun?id=r1']]]
    arrayExtend(expected, testHeaderCalls('Blue <Chips>', 'Blue \\<Chips\\>', '#var='))
    arrayPush(expected, \
        ['markdownPrint', [ \
            '- **Stocks:** A, B, C, D', \
            '- **Analysis period:** 36 months to 2023-01', \
            '- **Projection:** 3 months', \
            '- **Created:** 2026-10-10 12:30', \
            '' \
        ]], \
        ['elementModelRender', [{'html': 'p', 'elem': [ \
            formsLinkElements('Run Again', "#var.vId='r1'&var.vPage='new'"), \
            {'text': ' | '}, \
            formsLinkButtonElements('Delete', '<function>') \
        ]}]], \
        ['markdownPrint', [ \
            '## Portfolios', \
            '', \
            'The minimum-risk portfolio for each target return. Stocks with negative allocations are deleted from the', \
            'portfolio, one at a time, most negative first (see "Excluded Stocks", below). Returns are annualized. Risk is', \
            'the standard deviation of the portfolio\'s monthly returns about their trend.', \
            '' \
        ]], \
        ['markdownPrint', [[ \
            '| Target Return | Realized Return |        Risk | Stocks | Deleted |', \
            '|--------------:|----------------:|------------:|-------:|--------:|', \
            '|         6.17% |          67.90% |       2.50% |      4 |       0 |', \
            '|        19.56% |                 |       3.00% |      3 |       1 |', \
            '|       151.80% |                 | No solution |      0 |       3 |' \
        ]]], \
        ['markdownPrint', ['', '## Efficient Frontier', '']], \
        ['elementModelRender', [{'html': 'p', 'elem': dataLineChartElements( \
            [{'Risk (%)': 2.5, 'Target Return (%)': 6.17}, {'Risk (%)': 3, 'Target Return (%)': 19.56}], \
            {'x': 'Target Return (%)', 'y': ['Risk (%)']} \
        )}]], \
        ['markdownPrint', [ \
            '', \
            '## Allocations', \
            '', \
            'The percent of each target return\'s portfolio to invest in each stock.', \
            '' \
        ]], \
        ['markdownPrint', [[ \
            '| Stock                                   |  6.17% | 19.56% | 151.80% |', \
            '|-----------------------------------------|-------:|-------:|--------:|', \
            "| [A](#var.vPage='stock'&var.vSymbol='A') | 39.59% | 55.67% |         |", \
            "| [B](#var.vPage='stock'&var.vSymbol='B') | 22.88% |  6.64% |         |", \
            "| [C](#var.vPage='stock'&var.vSymbol='C') | 26.74% | 37.69% |         |", \
            "| [D](#var.vPage='stock'&var.vSymbol='D') | 10.79% |        |         |" \
        ]]], \
        ['markdownPrint', [ \
            '', \
            '## Stocks', \
            '', \
            'Each stock\'s monthly returns are fit to a trend line. The projected return is the trend\'s return at the', \
            'end of the projection, and the risk is the standard deviation of the monthly returns about the trend.', \
            '' \
        ]], \
        ['markdownPrint', [[ \
            '| Stock                                   | Projected Return | Realized Return |  Risk |', \
            '|-----------------------------------------|-----------------:|----------------:|------:|', \
            "| [A](#var.vPage='stock'&var.vSymbol='A') |           31.24% |          35.90% | 4.80% |", \
            "| [B](#var.vPage='stock'&var.vSymbol='B') |          -19.90% |          77.90% | 5.50% |", \
            "| [C](#var.vPage='stock'&var.vSymbol='C') |           11.60% |                 | 4.90% |", \
            "| [D](#var.vPage='stock'&var.vSymbol='D') |          -23.00% |         118.50% | 5.50% |" \
        ]]], \
        ['markdownPrint', [ \
            '', \
            '## Excluded Stocks', \
            '', \
            'The stocks excluded from the run - stocks without a price for every month of the analysis period - and the', \
            'stocks deleted from each portfolio for a negative allocation, sorted by stock.', \
            '' \
        ]], \
        ['markdownPrint', [[ \
            '| Stock                                   | Excluded From     | Reason                       |', \
            '|-----------------------------------------|-------------------|------------------------------|', \
            "| [B](#var.vPage='stock'&var.vSymbol='B') | 151.80% portfolio | Negative allocation          |", \
            "| [C](#var.vPage='stock'&var.vSymbol='C') | 151.80% portfolio | Negative allocation          |", \
            "| [D](#var.vPage='stock'&var.vSymbol='D') | Run               | Prices end in 2023-01        |", \
            "| [D](#var.vPage='stock'&var.vSymbol='D') | 19.56% portfolio  | Negative allocation (-5.61%) |", \
            "| [D](#var.vPage='stock'&var.vSymbol='D') | 151.80% portfolio | Negative allocation          |", \
            "| [E](#var.vPage='stock'&var.vSymbol='E') | Run               | Prices start in 2021-03      |" \
        ]]] \
    )
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction
unittestRunTest('testMarkowitzRunPage')


async function testMarkowitzRunPage_message():
    args = {'page': 'run', 'id': 'r1'}
    run = objectCopy(testRun)
    objectSet(run, 'portfolios', arraySlice(objectGet(testRun, 'portfolios'), 0, 1))
    unittestMockAll({'systemFetch': {'getRun?id=r1': jsonStringify({'run': run})}})
    markowitzRunPage(args, 'The run could not be deleted.')
    calls = unittestMockEnd()

    # The message follows the header
    unittestDeepEqual(arrayGet(calls, 4), ['markdownPrint', ['**The run could not be deleted.**', '']])

    # With one solved portfolio, there's no efficient frontier chart - and with no excluded stocks, no excluded stocks
    for call in calls:
        unittestEqual(jsonStringify(call) != jsonStringify(['markdownPrint', ['', '## Efficient Frontier', '']]), true)
        unittestEqual(stringIndexOf(jsonStringify(call), '## Excluded Stocks') == -1, true)
    endfor
endfunction
unittestRunTest('testMarkowitzRunPage_message')


async function testMarkowitzRunPage_group():
    args = {'page': 'run', 'id': 'r1'}
    run = objectAssign(objectCopy(testRun), {'group': 'S&P 100'})
    unittestMockAll({'systemFetch': {'getRun?id=r1': jsonStringify({'run': run})}})
    markowitzRunPage(args)
    calls = unittestMockEnd()
    unittestDeepEqual(arrayGet(calls, 4), ['markdownPrint', ["- **Group:** [S&P 100](#var.vGroup='S%26P%20100'&var.vPage='group')"]])
    unittestDeepEqual(arrayGet(arrayGet(arrayGet(calls, 5), 1), 0), '- **Stocks:** A, B, C, D')
endfunction
unittestRunTest('testMarkowitzRunPage_group')


function testMarkowitzExcludedRow():
    unittestDeepEqual(markowitzExcludedRow('IBM', 'Run', 'No prices'), { \
        'Stock': "[IBM](#var.vPage='stock'&var.vSymbol='IBM')", \
        'Excluded From': 'Run', \
        'Reason': 'No prices' \
    })
endfunction
unittestRunTest('testMarkowitzExcludedRow')


function testMarkowitzCompareExcludedRow():
    unittestEqual(markowitzCompareExcludedRow(['A', 1, {}], ['B', 0, {}]), -1)
    unittestEqual(markowitzCompareExcludedRow(['B', 0, {}], ['A', 1, {}]), 1)
    unittestEqual(markowitzCompareExcludedRow(['A', 0, {}], ['A', 1, {}]), -1)
    unittestEqual(markowitzCompareExcludedRow(['A', 1, {}], ['A', 0, {}]), 1)
endfunction
unittestRunTest('testMarkowitzCompareExcludedRow')


