# Create a test stock's prices from its relatives - 100 in 2020-01
function testPrices(relatives):
    monthIndex = markowitzMonthIndex('2020-01')
    price = 100
    prices = objectNew('2020-01', price)
    for relative in relatives:
        monthIndex = monthIndex + 1
        price = price * relative
        objectSet(prices, markowitzMonthString(monthIndex), price)
    endfor
    return prices
endfunction


# The test stock documents' run fields - the test stocks, by default
function testStockDocs(symbols):
    docs = []
    for symbol, ixSymbol in if(symbols != null, symbols, testSymbols):
        relatives = arrayGet(testRelatives, ixSymbol % arrayLength(testRelatives))
        arrayPush(docs, {'symbol': symbol, 'firstMonth': '2020-01', 'lastMonth': '2023-04', 'prices': testPrices(relatives)})
    endfor
    return docs
endfunction


# The test createRun stock document query
function testCreateRunFindCall(symbols):
    return testCouchCall('/_find', { \
        'selector': {'type': 'stock', 'symbol': {'$in': symbols}}, \
        'fields': ['symbol', 'firstMonth', 'lastMonth', 'prices'], \
        'limit': 100000 \
    })
endfunction


# A test Yahoo Finance chart API response - 2026-06 (no price) through 2026-10 (the current month)
function testYahooResponse(meta):
    objectAssign(meta, {'gmtoffset': -14400, 'regularMarketTime': 1791576000})
    return jsonStringify({'chart': {'result': [{ \
        'meta': meta, \
        'timestamp': [1780286400, 1782878400, 1785556800, 1788235200, 1791576000], \
        'indicators': { \
            'quote': [{'close': [null, 9.5, 10.5, 12.5, 13.5]}], \
            'adjclose': [{'adjclose': [null, 9, 10, 12, 13]}] \
        } \
    }]}})
endfunction


# The test Yahoo Finance chart API URL
function testYahooURL(symbol):
    return 'https://query1.finance.yahoo.com/v8/finance/chart/' + symbol + \
        '?period1=-2208988800&period2=9999999999&interval=1mo'
endfunction


