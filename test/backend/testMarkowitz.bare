async function testUpdateStocks_all():
    # Every stock in the database, sorted
    stockDocs = [{'symbol': 'SC'}, {'symbol': 'SA'}, {'symbol': 'SB'}]
    fetchData = {}
    objectSet(fetchData, testCouchURL + '/_find', jsonStringify({'docs': stockDocs}))
    objectSet(fetchData, testCouchURL + '/_all_docs', jsonStringify({'rows': []}))
    objectSet(fetchData, testCouchURL + '/_bulk_docs', '[]')
    testMockAll({'systemFetch': fetchData})
    response = testAction('POST', '/updateStocks', '', {'all': true})
    unittestEqual(arrayGet(response, 0), '200 OK')
    unittestEqual(arrayLength(objectGet(arrayGet(response, 1), 'results')), 3)
    calls = unittestMockEnd()
    unittestEqual(arrayLength(calls), 4)
    unittestDeepEqual(arrayGet(calls, 0), testCouchCall('/_find', {'selector': {'type': 'stock'}, 'fields': ['symbol'], 'limit': 100000}))
    unittestDeepEqual(arrayGet(calls, 1), ['systemFetch', [[testYahooRequest('SA'), testYahooRequest('SB'), testYahooRequest('SC')]]])
endfunction
unittestRunTest('testUpdateStocks_all')


