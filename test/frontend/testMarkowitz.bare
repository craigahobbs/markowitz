# The menu line
testMenu = "[Runs](#var=) | [New Run](#var.vPage='new') | [Stocks](#var.vPage='stocks') | [API Documentation](doc/)"

# A local time, and its display text
testCreated = datetimeISOFormat(datetimeNew(2026, 10, 10, 12, 30))
testCreatedText = '2026-10-10 12:30'

# The test stocks
testStocks = [ \
    { \
        'symbol': 'IBM', 'name': 'International Business Machines', 'currency': 'USD', 'firstMonth': '1962-01', \
        'lastMonth': '2026-09', 'monthCount': 777, 'updated': testCreated \
    }, \
    {'symbol': 'KO', 'firstMonth': '1985-01', 'lastMonth': '2026-09', 'monthCount': 501, 'updated': testCreated} \
]
testStocksTable = [ \
    '| Stock                                       | Name                            | First Month | Last Month | Months | Updated          |', \
    '|---------------------------------------------|---------------------------------|-------------|------------|-------:|------------------|', \
    '| [IBM](#var.vPage=\'stock\'&var.vSymbol=\'IBM\') | International Business Machines | 1962-01     | 2026-09    |    777 | 2026-10-10 12:30 |', \
    '| [KO](#var.vPage=\'stock\'&var.vSymbol=\'KO\')   |                                 | 1985-01     | 2026-09    |    501 | 2026-10-10 12:30 |' \
]

# The test run
testRun = { \
    'id': 'r1', \
    'name': 'Blue <Chips>', \
    'created': testCreated, \
    'symbols': ['A', 'B', 'C', 'D'], \
    'endMonth': '2023-01', \
    'months': 36, \
    'horizon': 3, \
    'targets': [6.17, 19.56, 151.8], \
    'stocks': [ \
        {'symbol': 'A', 'expectedReturn': 31.24, 'variance': 23.04, 'realizedReturn': 35.9}, \
        {'symbol': 'B', 'expectedReturn': -19.9, 'variance': 30.25, 'realizedReturn': 77.9}, \
        {'symbol': 'C', 'expectedReturn': 11.6, 'variance': 24.01}, \
        {'symbol': 'D', 'expectedReturn': -23, 'variance': 30.25, 'realizedReturn': 118.5} \
    ], \
    'portfolios': [ \
        { \
            'target': 6.17, 'solved': true, \
            'allocations': [ \
                {'symbol': 'A', 'weight': 0.3959}, {'symbol': 'B', 'weight': 0.2288}, \
                {'symbol': 'C', 'weight': 0.2674}, {'symbol': 'D', 'weight': 0.1079} \
            ], \
            'deleted': [], 'variance': 6.25, 'realizedReturn': 67.9 \
        }, \
        { \
            'target': 19.56, 'solved': true, \
            'allocations': [{'symbol': 'A', 'weight': 0.5567}, {'symbol': 'B', 'weight': 0.0664}, {'symbol': 'C', 'weight': 0.3769}], \
            'deleted': ['D'], 'variance': 9 \
        }, \
        {'target': 151.8, 'solved': false, 'allocations': [], 'deleted': ['D', 'B', 'C']} \
    ] \
}


# The page header calls
function testHeaderCalls(title, titleMarkdown):
    return [ \
        ['documentSetTitle', [title]], \
        ['markdownPrint', ['# ' + titleMarkdown, '', testMenu, '']] \
    ]
endfunction


# A new run form field render call
function testFormFieldCall(name, label, size, value):
    inputID = 'markowitz-' + name
    return ['elementModelRender', [{'html': 'p', 'elem': [ \
        {'html': 'label', 'attr': {'for': inputID}, 'elem': {'html': 'b', 'elem': {'text': label}}}, \
        {'html': 'br'}, \
        formsTextElements(inputID, value, size) \
    ]}]]
endfunction


# The new run form render calls
function testFormCalls(form):
    return [ \
        testFormFieldCall('name', 'Name', 40, objectGet(form, 'name')), \
        testFormFieldCall('symbols', 'Stock symbols, separated by spaces or commas', 60, objectGet(form, 'symbols')), \
        testFormFieldCall('endMonth', 'End month of the analysis period, "YYYY-MM" (blank for the latest)', 10, objectGet(form, 'endMonth')), \
        testFormFieldCall('months', 'Months in the analysis period', 5, objectGet(form, 'months')), \
        testFormFieldCall('horizon', 'Months in the projection', 5, objectGet(form, 'horizon')), \
        testFormFieldCall('targets', 'Target annual returns, in percent, separated by spaces or commas', 40, objectGet(form, 'targets')), \
        ['elementModelRender', [{'html': 'p', 'elem': formsLinkButtonElements('Start Run', '<function>')}]] \
    ]
endfunction


# The new run form's input values mock data
function testFormInputs(form):
    inputs = {}
    for name in objectKeys(form):
        objectSet(inputs, 'markowitz-' + name, objectGet(form, name))
    endfor
    return inputs
endfunction


# The new run form's input value calls
testFormInputCalls = [ \
    ['documentInputValue', ['markowitz-name']], \
    ['documentInputValue', ['markowitz-symbols']], \
    ['documentInputValue', ['markowitz-endMonth']], \
    ['documentInputValue', ['markowitz-months']], \
    ['documentInputValue', ['markowitz-horizon']], \
    ['documentInputValue', ['markowitz-targets']] \
]


# A valid new run form
testForm = {'name': ' My Run ', 'symbols': 'ko, ibm', 'endMonth': '', 'months': '36', 'horizon': '3', 'targets': '10 20'}
testRequest = {'name': 'My Run', 'symbols': ['IBM', 'KO'], 'months': 36, 'horizon': 3, 'targets': [10, 20]}


# Concatenate two arrays
function testArrayConcat(array1, array2):
    result = arrayCopy(array1)
    arrayExtend(result, array2)
    return result
endfunction


# Get a page's call log - for comparing a handler's re-render
async function testPageCalls(pageFn, data):
    unittestMockAll(data)
    pageFn()
    return unittestMockEnd()
endfunction


