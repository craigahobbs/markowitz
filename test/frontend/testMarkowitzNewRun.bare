testMinimumGroups = [{'name': 'Minimum', 'symbols': testStockSymbols(testMinimumStocks)}]


async function testMarkowitzNewRunPage():
    unittestMockAll(testNewRunData())
    markowitzNewRunPage({'page': 'new'})
    expected = testNewRunCalls(testNewRunFetchCalls, '#var=', null, testGroupCall(), false, markowitzRunFormDefault)
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction
unittestRunTest('testMarkowitzNewRunPage')


