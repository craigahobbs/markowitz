async function testMarkowitzOnUpdateGroupStocks():
    unittestMockAll()
    markowitzOnUpdateGroupStocks({'page': 'group', 'group': 'S&P 100'}, 'S&P 100', ['IBM', 'KO', 'MSFT'])
    unittestDeepEqual(unittestMockEnd(), testUpdateProgressCalls('S&P 100', "#var.vPage='groups'", 0, 3, '0', ''))
endfunction
unittestRunTest('testMarkowitzOnUpdateGroupStocks')


async function testMarkowitzOnUpdateGroupStocks_done():
    # The update's timeout downloads its stocks, then renders the group's page with the update's message
    args = {'page': 'group', 'group': 'S&P 100'}
    symbols = ['IBM', 'KO', 'MSFT']
    data = testGroupData()
    objectSet(objectGet(data, 'systemFetch'), 'updateStocks', jsonStringify({'results': []}))
    callbacks = testCaptureTimeouts(systemPartial(markowitzOnUpdateGroupStocks, args, 'S&P 100', symbols), data)
    update = { \
        'title': 'S&P 100', 'back': {'page': 'groups'}, 'symbols': symbols, 'count': 0, 'updated': [], 'failed': [], \
        'pageFn': systemPartial(markowitzGroupPage, args) \
    }
    testSameEffect(arrayGet(callbacks, 0), systemPartial(markowitzOnUpdateChunk, update), data)
endfunction
unittestRunTest('testMarkowitzOnUpdateGroupStocks_done')


# Test a group save - its message and re-rendered page
async function testOnSaveGroup(symbolsText, setGroupResponse, fetchCount, message):
    args = {'page': 'group', 'group': 'S&P 100'}
    data = testGroupData()
    objectSet(data, 'documentInputValue', {'markowitz-group-symbols': symbolsText})
    if setGroupResponse != null:
        objectSet(objectGet(data, 'systemFetch'), 'setGroup', setGroupResponse)
    endif
    unittestMockAll(data)
    markowitzOnSaveGroup(args, 'S&P 100')
    calls = unittestMockEnd()
    unittestDeepEqual(arrayGet(calls, 0), ['documentInputValue', ['markowitz-group-symbols']])
    if fetchCount:
        unittestDeepEqual(arrayGet(calls, 1), ['systemFetch', [{'url': 'setGroup', 'body': '{"name":"S&P 100","symbols":["IBM","KO"]}'}]])
    endif
    unittestDeepEqual(arraySlice(calls, 1 + fetchCount), testPageCalls(systemPartial(markowitzGroupPage, args, message), data))
endfunction


async function testMarkowitzOnSaveGroup():
    testOnSaveGroup('ko ibm', '{}', 1, 'Saved the group.')
endfunction
unittestRunTest('testMarkowitzOnSaveGroup')


async function testMarkowitzOnSaveGroup_error():
    testOnSaveGroup('ko ibm', null, 1, 'The group could not be saved.')
endfunction
unittestRunTest('testMarkowitzOnSaveGroup_error')


async function testMarkowitzOnSaveGroup_invalid():
    testOnSaveGroup(' ', null, 0, 'Enter one to one thousand stock symbols.')
endfunction
unittestRunTest('testMarkowitzOnSaveGroup_invalid')


async function testMarkowitzOnDeleteGroup():
    unittestMockAll({'systemFetch': {'deleteGroup': '{}'}})
    markowitzOnDeleteGroup({'page': 'group', 'group': 'S&P 100'}, 'S&P 100')
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemFetch', [{'url': 'deleteGroup', 'body': '{"name":"S&P 100"}'}]], \
        ['windowSetLocation', ["#var.vPage='groups'"]] \
    ])
endfunction
unittestRunTest('testMarkowitzOnDeleteGroup')


async function testMarkowitzOnDeleteGroup_error():
    args = {'page': 'group', 'group': 'S&P 100'}
    data = testGroupData()
    unittestMockAll(data)
    markowitzOnDeleteGroup(args, 'S&P 100')
    calls = unittestMockEnd()
    unittestDeepEqual(arrayGet(calls, 0), ['systemFetch', [{'url': 'deleteGroup', 'body': '{"name":"S&P 100"}'}]])
    unittestDeepEqual(arraySlice(calls, 1), testPageCalls(systemPartial(markowitzGroupPage, args, 'The group could not be deleted.'), data))
endfunction
unittestRunTest('testMarkowitzOnDeleteGroup_error')
