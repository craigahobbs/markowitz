function testMarkowitzParseList():
    unittestDeepEqual(markowitzParseList(''), [])
    unittestDeepEqual(markowitzParseList(' , '), [])
    unittestDeepEqual(markowitzParseList(' ibm,KO  msft, '), ['ibm', 'KO', 'msft'])
endfunction
unittestRunTest('testMarkowitzParseList')


function testMarkowitzSymbols():
    unittestDeepEqual(markowitzSymbols(['ko', 'IBM', 'KO', 'brk-b']), ['BRK-B', 'IBM', 'KO'])
endfunction
unittestRunTest('testMarkowitzSymbols')


function testMarkowitzMonths():
    unittestEqual(markowitzMonthIndex('2023-01'), 2023 * 12)
    unittestEqual(markowitzMonthIndex('2023-00'), null)
    unittestEqual(markowitzMonthIndex('January'), null)
    unittestEqual(markowitzMonthString(2023 * 12 + 9), '2023-10')
    unittestEqual(markowitzMonthString(2023 * 12 + 2), '2023-03')
endfunction
unittestRunTest('testMarkowitzMonths')


function testMarkowitzPercentText():
    unittestEqual(markowitzPercentText(12.345), '12.35%')
    unittestEqual(markowitzPercentText(-5), '-5.00%')
    unittestEqual(markowitzPercentText(null), '')
endfunction
unittestRunTest('testMarkowitzPercentText')


function testMarkowitzDatetimeText():
    unittestEqual(markowitzDatetimeText(testCreated), testCreatedText)
