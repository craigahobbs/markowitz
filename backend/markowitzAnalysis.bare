# The Markowitz portfolio analysis - a port of Program HOBBS, Fortran 2.1, 09/13/67

# The month helpers - shared with the frontend
include '../frontend/markowitzUtil.bare'


# The magnitude below which a pivot is zero - the matrix is singular
markowitzSingularEpsilon = 1e-9


# Get the first month, from a start month to an end month, without a price - null if every month has a price
function markowitzMissingMonth(prices, startIndex, endIndex):
    monthIndex = startIndex
    while monthIndex <= endIndex:
        month = markowitzMonthString(monthIndex)
        if !objectHas(prices, month):
            return month
        endif
        monthIndex = monthIndex + 1
    endwhile
    return null
endfunction


# Compute a stock's monthly price relatives (the ratio of a month's price to the prior month's) for the months
# following a month - null if a month has no price
function markowitzRelatives(prices, startIndex, count):
    relatives = []
    pricePrior = objectGet(prices, markowitzMonthString(startIndex))
    monthIndex = startIndex + 1
    while monthIndex <= startIndex + count:
        price = objectGet(prices, markowitzMonthString(monthIndex))
        if pricePrior == null || price == null:
            return null
        endif
        arrayPush(relatives, price / pricePrior)
        pricePrior = price
        monthIndex = monthIndex + 1
    endwhile
    return relatives
endfunction


# Compute a run's stock statistics, and the stocks' covariance, projected monthly returns, and growths over the
# projection (null if its months haven't passed) - each target return's portfolio is computed from them. Each stock's
# monthly percent returns are regressed on time - the projected return is the trend's return at the end of the
# projection, and the risk is the variance (and covariance) of the returns about their trend.
function markowitzAnalyzeStocks(symbols, relatives, horizonRelatives, horizon):
    monthCount = arrayLength(arrayGet(relatives, 0))
    xBar = (monthCount + 1) / 2
    sumX2 = 0
    month = 1
    while month <= monthCount:
        sumX2 = sumX2 + (month - xBar) ** 2
        month = month + 1
    endwhile

    # Regress each stock's monthly percent returns on time
    stocks = []
    expected = []
    growths = []
    residuals = []
    for stockRelatives, ixStock in relatives:
        returns = []
        yBar = 0
        sumXY = 0
        for relative, ixMonth in stockRelatives:
            percent = (relative - 1) * 100
            arrayPush(returns, percent)
            yBar = yBar + percent
            sumXY = sumXY + (ixMonth + 1 - xBar) * percent
        endfor
        yBar = yBar / monthCount
        slope = sumXY / sumX2
        intercept = yBar - slope * xBar
        projected = yBar + slope * (monthCount + horizon - xBar)

        # The residuals about the trend
        stockResiduals = []
        variance = 0
        for percent, ixMonth in returns:
            residual = percent - intercept - slope * (ixMonth + 1)
            arrayPush(stockResiduals, residual)
            variance = variance + residual * residual
        endfor

        # The growth over the projection, if its months have passed
        growth = null
        stockHorizonRelatives = arrayGet(horizonRelatives, ixStock)
        if stockHorizonRelatives != null:
            growth = 1
            for relative in stockHorizonRelatives:
                growth = growth * relative
            endfor
        endif

        stock = { \
            'symbol': arrayGet(symbols, ixStock), \
            'expectedReturn': markowitzAnnualReturn(1 + projected / 100, 12), \
            'variance': variance / monthCount \
        }
        if growth != null:
            objectSet(stock, 'realizedReturn', markowitzAnnualReturn(growth, 12 / horizon))
        endif
        arrayPush(stocks, stock)
        arrayPush(expected, projected)
        arrayPush(growths, growth)
        arrayPush(residuals, stockResiduals)
    endfor

    # The covariance matrix of the residuals - it's symmetric, so each pair of stocks is computed once
    covariance = []
    for residualsI, ixStockI in residuals:
        row = []
        for residualsJ, ixStockJ in residuals:
            if ixStockJ < ixStockI:
                arrayPush(row, arrayGet(arrayGet(covariance, ixStockJ), ixStockI))
                continue
            endif
            sum = 0
            for residual, ixMonth in residualsI:
                sum = sum + residual * arrayGet(residualsJ, ixMonth)
            endfor
            arrayPush(row, sum / monthCount)
        endfor
        arrayPush(covariance, row)
    endfor

    return {'stocks': stocks, 'covariance': covariance, 'expected': expected, 'growths': growths}
endfunction


# Annualize a growth ratio - returns the annual percent return
function markowitzAnnualReturn(growth, periodsPerYear):
    return (growth ** periodsPerYear - 1) * 100
endfunction


# Compute a target annual return's minimum-variance portfolio. The weights that minimize the variance, with the target
# return and weights that sum to one, solve the Lagrangian's linear system - the covariance matrix bordered by the
# expected returns and ones, with the right-hand side zeros, the target return, and one. If a weight is negative, delete
# its stock (the most negative) and solve again. The system's matrix is inverted once - the weights are its inverse's
# last two columns, scaled by the target return and one - and a deleted stock's row and column are removed from the
# inverse (an O(n^2) update, rather than an O(n^3) solve).
function markowitzPortfolio(symbols, covariance, expected, growths, horizon, target):
    targetMonthly = ((1 + target / 100) ** (1 / 12) - 1) * 100
    stockCount = arrayLength(symbols)
    stockIndexes = []
    while arrayLength(stockIndexes) < stockCount:
        arrayPush(stockIndexes, arrayLength(stockIndexes))
    endwhile
    deleted = []
    deletedWeights = []
    unsolved = {'target': target, 'solved': false, 'allocations': [], 'deleted': deleted, 'deletedWeights': deletedWeights}
    inverse = markowitzInvert(markowitzSystem(covariance, expected, stockIndexes))
    if inverse == null:
        return unsolved
    endif

    # The inverse's rows and columns - the stocks not deleted, and the two constraints
    active = arrayCopy(stockIndexes)
    arrayPush(active, stockCount, stockCount + 1)
    while true:
        # The weights
        weights = []
        for stockIndex in stockIndexes:
            inverseRow = arrayGet(inverse, stockIndex)
            arrayPush(weights, targetMonthly * arrayGet(inverseRow, stockCount) + arrayGet(inverseRow, stockCount + 1))
        endfor

        # Find the most negative weight - if none, done
        ixMinimum = null
        weightMinimum = 0
        for weight, ixIndex in weights:
            if weight < weightMinimum:
                weightMinimum = weight
                ixMinimum = ixIndex
            endif
        endfor
        if ixMinimum == null:
            break
        endif

        # Delete the stock from the portfolio, and its row and column from the inverse
        stockIndex = arrayGet(stockIndexes, ixMinimum)
        arrayPush(deleted, arrayGet(symbols, stockIndex))
        arrayPush(deletedWeights, weightMinimum)
        arrayDelete(stockIndexes, ixMinimum)
        arrayDelete(active, ixMinimum)
        if !markowitzInverseDelete(inverse, active, stockIndex):
            return unsolved
        endif
    endwhile

    # The portfolio's allocations, variance, and realized return
    allocations = []
    variance = 0
    growth = 0
    for stockIndex, ixIndex in stockIndexes:
        weight = arrayGet(weights, ixIndex)
        arrayPush(allocations, {'symbol': arrayGet(symbols, stockIndex), 'weight': weight})
        covarianceRow = arrayGet(covariance, stockIndex)
        for stockIndexJ, ixIndexJ in stockIndexes:
            variance = variance + weight * arrayGet(weights, ixIndexJ) * arrayGet(covarianceRow, stockIndexJ)
        endfor
        stockGrowth = arrayGet(growths, stockIndex)
        growth = if(growth != null && stockGrowth != null, growth + weight * stockGrowth)
    endfor
    portfolio = { \
        'target': target, \
        'solved': true, \
        'allocations': allocations, \
        'deleted': deleted, \
        'deletedWeights': deletedWeights, \
        'variance': variance \
    }
    if growth != null:
        objectSet(portfolio, 'realizedReturn', markowitzAnnualReturn(growth, 12 / horizon))
    endif
    return portfolio
endfunction


# Create the matrix of the portfolio's linear system - the covariance matrix bordered by the expected returns and ones
function markowitzSystem(covariance, expected, stockIndexes):
    matrix = []
    expectedRow = []
    onesRow = []
    for stockIndex in stockIndexes:
        covarianceRow = arrayGet(covariance, stockIndex)
        row = []
        for stockIndexJ in stockIndexes:
            arrayPush(row, arrayGet(covarianceRow, stockIndexJ))
        endfor
        arrayPush(row, arrayGet(expected, stockIndex), 1)
        arrayPush(matrix, row)
        arrayPush(expectedRow, arrayGet(expected, stockIndex))
        arrayPush(onesRow, 1)
    endfor
    arrayPush(expectedRow, 0, 0)
    arrayPush(onesRow, 0, 0)
    arrayPush(matrix, expectedRow, onesRow)
    return matrix
endfunction


# Invert a matrix, in place, with Gauss-Jordan elimination and partial pivoting - returns the inverse, or null if the
# matrix is singular ("D WAS ZERO, NO SOLUTION"). Each pivot column becomes the inverse's column, so the row
# interchanges are undone as column interchanges, in reverse order (Numerical Recipes' "gaussj").
function markowitzInvert(matrix):
    size = arrayLength(matrix)
    pivotIndexes = []
    ixColumn = 0
    while ixColumn < size:
        # Find the pivot row - the first row with the column's largest magnitude
        ixPivot = ixColumn
        pivotMagnitude = mathAbs(arrayGet(arrayGet(matrix, ixColumn), ixColumn))
        ixRow = ixColumn + 1
        while ixRow < size:
            magnitude = mathAbs(arrayGet(arrayGet(matrix, ixRow), ixColumn))
            if magnitude > pivotMagnitude:
                pivotMagnitude = magnitude
                ixPivot = ixRow
            endif
            ixRow = ixRow + 1
        endwhile
        if pivotMagnitude < markowitzSingularEpsilon:
            return null
        endif
        arrayPush(pivotIndexes, ixPivot)

        # Swap the pivot row into place and normalize it
        pivotRow = arrayGet(matrix, ixPivot)
        arraySet(matrix, ixPivot, arrayGet(matrix, ixColumn))
        arraySet(matrix, ixColumn, pivotRow)
        pivotInverse = 1 / arrayGet(pivotRow, ixColumn)
        arraySet(pivotRow, ixColumn, 1)
        for value, ixValue in pivotRow:
            arraySet(pivotRow, ixValue, value * pivotInverse)
        endfor

        # Eliminate the column from the other rows
        for row, ixRow in matrix:
            factor = arrayGet(row, ixColumn)
            if ixRow != ixColumn && factor != 0:
                arraySet(row, ixColumn, 0)
                for pivotValue, ixValue in pivotRow:
                    arraySet(row, ixValue, arrayGet(row, ixValue) - factor * pivotValue)
                endfor
            endif
        endfor

        ixColumn = ixColumn + 1
    endwhile

    # Undo the row interchanges as column interchanges, in reverse order
    ixColumn = size - 1
    while ixColumn >= 0:
        ixPivot = arrayGet(pivotIndexes, ixColumn)
        if ixPivot != ixColumn:
            for row in matrix:
                value = arrayGet(row, ixPivot)
                arraySet(row, ixPivot, arrayGet(row, ixColumn))
                arraySet(row, ixColumn, value)
            endfor
        endif
        ixColumn = ixColumn - 1
    endwhile
    return matrix
endfunction


# Remove an index's row and column from a symmetric matrix's inverse, in place - the inverse's other active rows and
# columns become the inverse of the matrix without the index's row and column. Returns false if that matrix is singular
# - the index's diagonal value is zero, relative to its row.
function markowitzInverseDelete(inverse, active, index):
    indexRow = arrayGet(inverse, index)
    diagonal = arrayGet(indexRow, index)
    rowMagnitude = mathAbs(diagonal)
    for ixValue in active:
        rowMagnitude = mathMax(rowMagnitude, mathAbs(arrayGet(indexRow, ixValue)))
    endfor
    if mathAbs(diagonal) < markowitzSingularEpsilon * rowMagnitude:
        return false
    endif
    for ixRow in active:
        row = arrayGet(inverse, ixRow)
        factor = arrayGet(row, index) / diagonal
        if factor != 0:
            for ixValue in active:
                arraySet(row, ixValue, arrayGet(row, ixValue) - factor * arrayGet(indexRow, ixValue))
            endfor
        endif
    endfor
    return true
endfunction
