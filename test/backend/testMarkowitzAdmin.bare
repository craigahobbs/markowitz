#
# reset tests
#


# Run an administration command with a fetch mock keyed by method and URL (e.g. "DELETE http://...") - returns
# [status, fetch call log, log call log]
async function testAdminRunMethods(args, responses):
    groups = markowitzAdminGroups
    systemGlobalSet('markowitzAdminGroups', testAdminGroups)
    fetches = []
    originalFetch = systemFetch
    unittestMockAll()
    unittestMockOne('systemFetch', systemPartial(testAdminMethodFetch, responses, fetches))
    status = markowitzAdmin(args)
    calls = unittestMockEnd()

    # unittestMockEnd doesn't restore a function mocked by both unittestMockAll and unittestMockOne
    systemGlobalSet('systemFetch', originalFetch)
    systemGlobalSet('markowitzAdminGroups', groups)
    return [status, fetches, calls]
endfunction

function testAdminMethodFetch(responses, fetches, request):
    arrayPush(fetches, ['systemFetch', [request]])
    if systemType(request) == 'string':
        return objectGet(responses, 'GET ' + request)
    endif
    method = objectGet(request, 'method', if(objectHas(request, 'body'), 'POST', 'GET'))
    return objectGet(responses, method + ' ' + objectGet(request, 'url'))
endfunction


async function testMarkowitzAdminReset():
    responses = {}
    objectSet(responses, 'GET ' + testAdminServerURL + '/', '{"couchdb": "Welcome"}')
    objectSet(responses, 'DELETE ' + testAdminCouchURL, '{"ok": true}')
    objectSet(responses, 'PUT ' + testAdminCouchURL, '{"ok": true}')
    objectSet(responses, 'POST ' + testAdminCouchURL + '/_all_docs', jsonStringify({'rows': []}))
    objectSet(responses, 'PUT ' + testAdminCouchURL + '/group%3AGroup%20A', '{"ok": true}')
    objectSet(responses, 'PUT ' + testAdminCouchURL + '/group%3AGroup%20B', '{"ok": true}')
    unittestDeepEqual(testAdminRunMethods(['reset'], responses), [ \
        0, \
        testAdminConcat(testAdminServerCalls, [ \
            testAdminCall(testAdminCouchURL, 'DELETE'), \
            testAdminCall(testAdminCouchURL), \
            testAdminCall(testAdminCouchURL, 'PUT'), \
            testAdminCall(testAdminCouchURL + '/_all_docs', null, null, '{"keys":["group:Group A"]}'), \
            testAdminCall( \
                testAdminCouchURL + '/group%3AGroup%20A', 'PUT', null, \
                '{"_id":"group:Group A","name":"Group A","symbols":["IBM","KO"],"type":"group"}' \
            ), \
            testAdminCall(testAdminCouchURL + '/_all_docs', null, null, '{"keys":["group:Group B"]}'), \
            testAdminCall( \
                testAdminCouchURL + '/group%3AGroup%20B', 'PUT', null, \
                '{"_id":"group:Group B","name":"Group B","symbols":["KO"],"type":"group"}' \
            ) \
        ]), \
        [ \
            testAdminLog('Deleted the database "http://127.0.0.1:5984/markowitz"'), \
            testAdminLog('Created the database "http://127.0.0.1:5984/markowitz"'), \
            testAdminLog('Saved the group "Group A" (2 stocks)'), \
            testAdminLog('Saved the group "Group B" (1 stocks)'), \
            testAdminLog('Run "make init" to download the groups\' stocks\' prices') \
        ] \
    ])
endfunction


async function testMarkowitzAdminReset_groupError():
    responses = {}
    objectSet(responses, 'GET ' + testAdminServerURL + '/', '{"couchdb": "Welcome"}')
    objectSet(responses, 'DELETE ' + testAdminCouchURL, '{"ok": true}')
    objectSet(responses, 'PUT ' + testAdminCouchURL, '{"ok": true}')
    result = testAdminRunMethods(['reset'], responses)
    unittestEqual(arrayGet(result, 0), 1)
    unittestDeepEqual(arraySlice(arrayGet(result, 2), 2), [testAdminLog('Failed to save the group "Group A"')])
endfunction
unittestRunTest('testMarkowitzAdminReset_groupError')
unittestRunTest('testMarkowitzAdminReset')


async function testMarkowitzAdminReset_noDatabase():
    unittestDeepEqual(testAdminRun(['reset'], testAdminFetchData()), [1, testAdminConcat(testAdminServerCalls, [ \
        testAdminCall(testAdminCouchURL, 'DELETE'), \
        testAdminCall(testAdminCouchURL), \
        testAdminCall(testAdminCouchURL), \
        testAdminCall(testAdminCouchURL, 'PUT'), \
        testAdminLog('Failed to create the database "http://127.0.0.1:5984/markowitz"') \
    ])])
endfunction
unittestRunTest('testMarkowitzAdminReset_noDatabase')


async function testMarkowitzAdminReset_deleteError():
    responses = {}
    objectSet(responses, 'GET ' + testAdminServerURL + '/', '{"couchdb": "Welcome"}')
    objectSet(responses, 'GET ' + testAdminCouchURL, '{"db_name": "markowitz"}')
    unittestDeepEqual(testAdminRunMethods(['reset'], responses), [ \
        1, \
        testAdminConcat(testAdminServerCalls, [testAdminCall(testAdminCouchURL, 'DELETE'), testAdminCall(testAdminCouchURL)]), \
        [testAdminLog('Failed to delete the database "http://127.0.0.1:5984/markowitz"')] \
    ])
endfunction
unittestRunTest('testMarkowitzAdminReset_deleteError')
