# A fetch mock that fails PUT requests
function testComputeRunPortfolioFetch(fetchData, request):
    return if(objectGet(request, 'method') == 'PUT', null, objectGet(fetchData, objectGet(request, 'url')))
endfunction


async function testComputeRunPortfolio_saveError():
    # The run document is fetched, but its update fails (e.g. a conflict) - mock only systemFetch (unittestMockEnd
    # doesn't restore a function mocked by both unittestMockAll and unittestMockOne)
    fetchData = objectNew(testCouchURL + '/run1', jsonStringify(testRunningDoc(0)))
    unittestMockOne('systemFetch', systemPartial(testComputeRunPortfolioFetch, fetchData))
    unittestDeepEqual( \
        testAction('POST', '/computeRunPortfolio', '', {'id': 'run1'}), \
        ['500 Internal Server Error', {'error': 'DatabaseError', 'message': 'The database request failed'}] \
    )
    unittestMockEnd()
endfunction
unittestRunTest('testComputeRunPortfolio_saveError')



