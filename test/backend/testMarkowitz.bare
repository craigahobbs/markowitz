endfunction
unittestRunTest('testGetStock_invalidInput')


#
# updateStocks tests
#


# The test stock download request
function testYahooRequest(symbol):
    return {'url': testYahooURL(symbol), 'headers': {'User-Agent': 'Mozilla/5.0 (compatible; Markowitz)'}}
endfunction


async function testUpdateStocks():
    yahooFull = testYahooResponse({'longName': 'Test Corporation', 'shortName': 'Test Corp', 'currency': 'USD'})
    yahooShort = testYahooResponse({'shortName': 'Test Corp'})
    revs = {'rows': [ \
        {'id': 'stock:IBM', 'key': 'stock:IBM', 'value': {'rev': '1-abc'}}, \
        {'key': 'stock:KO', 'error': 'not_found'}, \
        {'key': 'stock:NEW', 'error': 'not_found'}, \
        {'id': 'stock:OLD', 'key': 'stock:OLD', 'value': {'rev': '2-def', 'deleted': true}}, \
        {'key': 'stock:XYZ', 'error': 'not_found'} \
    ]}
    saveResults = [ \
        {'ok': true, 'id': 'stock:IBM', 'rev': '2-abc'}, \
        {'id': 'stock:KO', 'error': 'conflict', 'reason': 'Document update conflict.'}, \
        {'ok': true, 'id': 'stock:NEW', 'rev': '1-new'}, \
        {'ok': true, 'id': 'stock:OLD', 'rev': '3-def'} \
    ]
    fetchData = {}
    objectSet(fetchData, testYahooURL('IBM'), yahooFull)
    objectSet(fetchData, testYahooURL('KO'), yahooFull)
    objectSet(fetchData, testYahooURL('NEW'), yahooShort)
    objectSet(fetchData, testYahooURL('OLD'), yahooFull)
    objectSet(fetchData, testCouchURL + '/_all_docs', jsonStringify(revs))
    objectSet(fetchData, testCouchURL + '/_bulk_docs', jsonStringify(saveResults))
    testMockAll({'systemFetch': fetchData})

    stockFull = { \
        'name': 'Test Corporation', 'currency': 'USD', 'firstMonth': '2026-07', 'lastMonth': '2026-09', \
        'monthCount': 3, 'updated': testNowISO \
    }
    stockShort = {'name': 'Test Corp', 'firstMonth': '2026-07', 'lastMonth': '2026-09', 'monthCount': 3, 'updated': testNowISO}
    stockIBM = objectAssign({'symbol': 'IBM'}, stockFull)
    stockNEW = objectAssign({'symbol': 'NEW'}, stockShort)
    stockOLD = objectAssign({'symbol': 'OLD'}, stockFull)
    unittestDeepEqual( \
        testAction('POST', '/updateStocks', '', {'symbols': ['old', 'XYZ', 'NEW', 'ko', 'ibm', 'IBM']}), \
        ['200 OK', {'results': [ \
            {'symbol': 'IBM', 'stock': stockIBM}, \
            {'symbol': 'KO', 'error': 'Database update failed (conflict)'}, \
            {'symbol': 'NEW', 'stock': stockNEW}, \
            {'symbol': 'OLD', 'stock': stockOLD}, \
            {'symbol': 'XYZ', 'error': 'Download failed - is "XYZ" a Yahoo Finance symbol? If so, try again later.'} \
        ]}] \
    )

    # The stock documents
    prices = {'2026-07': 9, '2026-08': 10, '2026-09': 12}
    docFull = {'type': 'stock', 'name': 'Test Corporation', 'currency': 'USD', 'firstMonth': '2026-07', \
        'lastMonth': '2026-09', 'monthCount': 3, 'prices': prices, 'updated': testNowISO}
    docShort = {'type': 'stock', 'name': 'Test Corp', 'currency': null, 'firstMonth': '2026-07', \
        'lastMonth': '2026-09', 'monthCount': 3, 'prices': prices, 'updated': testNowISO}
    docs = [ \
        objectAssign({'_id': 'stock:IBM', '_rev': '1-abc', 'symbol': 'IBM'}, docFull), \
        objectAssign({'_id': 'stock:KO', 'symbol': 'KO'}, docFull), \
        objectAssign({'_id': 'stock:NEW', 'symbol': 'NEW'}, docShort), \
        objectAssign({'_id': 'stock:OLD', 'symbol': 'OLD'}, docFull) \
    ]
    yahooRequests = []
    for symbol in ['IBM', 'KO', 'NEW', 'OLD', 'XYZ']:
        arrayPush(yahooRequests, testYahooRequest(symbol))
    endfor
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemFetch', [yahooRequests]], \
        testCouchCall('/_all_docs', {'keys': ['stock:IBM', 'stock:KO', 'stock:NEW', 'stock:OLD', 'stock:XYZ']}), \
        testCouchCall('/_bulk_docs', {'docs': docs}) \
    ])
endfunction
unittestRunTest('testUpdateStocks')


async function testUpdateStocks_revsError():
    testMockAll({})
    unittestDeepEqual( \
        testAction('POST', '/updateStocks', '', {'symbols': ['IBM']}), \
        ['500 Internal Server Error', {'error': 'DatabaseError', 'message': 'The database request failed'}] \
    )
    unittestEqual(arrayLength(unittestMockEnd()), 2)
endfunction
unittestRunTest('testUpdateStocks_revsError')


async function testUpdateStocks_saveError():
    testMockAll({'systemFetch': objectNew(testCouchURL + '/_all_docs', jsonStringify({'rows': []}))})
    unittestDeepEqual( \
        testAction('POST', '/updateStocks', '', {'symbols': ['IBM']}), \
        ['500 Internal Server Error', {'error': 'DatabaseError', 'message': 'The database request failed'}] \
    )
    unittestDeepEqual(arrayGet(unittestMockEnd(), 2), testCouchCall('/_bulk_docs', {'docs': []}))
endfunction
unittestRunTest('testUpdateStocks_saveError')


