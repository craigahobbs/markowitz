async function testGetStocks():
    stockIBM = { \
        'symbol': 'IBM', 'name': 'International Business Machines', 'currency': 'USD', \
        'firstMonth': '1962-01', 'lastMonth': '2026-09', 'monthCount': 777, 'updated': testNowISO \
    }
    stockKO = {'symbol': 'KO', 'firstMonth': '1985-01', 'lastMonth': '2026-09', 'monthCount': 501, 'updated': testNowISO}
    findKO = objectCopy(stockKO)
    objectSet(findKO, 'name', null)
    testMockAll({'systemFetch': objectNew(testCouchURL + '/_find', jsonStringify({'docs': [findKO, stockIBM]}))})
    unittestDeepEqual(testAction('GET', '/getStocks', '', null), ['200 OK', {'stocks': [stockIBM, stockKO]}])
    unittestDeepEqual(unittestMockEnd(), [ \
        testCouchCall('/_find', {'selector': {'type': 'stock'}, 'fields': markowitzStockInfoFields, 'limit': 100000}) \
    ])
endfunction
unittestRunTest('testGetStocks')


