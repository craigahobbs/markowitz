#
# New run page tests
#


# The new run page's fetch mock data
function testNewRunData(stocks, groups):
    return {'systemFetch': { \
        'getStocks': jsonStringify({'stocks': if(stocks != null, stocks, testStocks)}), \
        'getGroups': jsonStringify({'groups': if(groups != null, groups, testGroups)}) \
    }}
endfunction


# The new run page's calls - the header, the message, the stock group, the selection list, the group's stocks without
# prices warning and minimum analysis period (if a group is selected), and the form
function testNewRunCalls(fetchCalls, backURL, message, groupCall, selecting, form, minimumText, missingText):
    calls = arrayCopy(fetchCalls)
    arrayExtend(calls, testHeaderCalls('New Run', 'New Run', backURL))
    if message != null:
        arrayPush(calls, ['markdownPrint', ['**' + message + '**', '']])
    endif
    arrayPush(calls, groupCall)
    if selecting:
        arrayPush(calls, testGroupListCall)
    endif
    if missingText != null:
        arrayPush(calls, ['markdownPrint', [missingText, '']])
    endif
    if minimumText != null:
        arrayPush(calls, ['markdownPrint', [minimumText, '']])
    endif
    arrayExtend(calls, testFormCalls(form, minimumText != null))
    return calls
endfunction


# The new run page's fetch calls
testNewRunFetchCalls = [['systemFetch', ['getStocks']], ['systemFetch', ['getGroups']]]


# Create test stocks with prices through 2026-09 - one for each first month
function testPriceStocks(firstMonths):
    stocks = []
    for firstMonth, ixFirstMonth in firstMonths:
        arrayPush(stocks, {'symbol': 'S' + ixFirstMonth, 'firstMonth': firstMonth, 'lastMonth': '2026-09', 'monthCount': 1, 'updated': testCreated})
    endfor
    return stocks
endfunction


# Get test stocks' symbols
function testStockSymbols(stocks):
    symbols = []
    for stock in stocks:
        arrayPush(symbols, objectGet(stock, 'symbol'))
    endfor
    return symbols
endfunction


