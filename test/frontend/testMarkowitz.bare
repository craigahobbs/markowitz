# The group page's fetch mock data
function testGroupData(stocks):
    return {'systemFetch': { \
        'getGroup?name=S%26P%20100': jsonStringify({'group': arrayGet(testGroups, 1), 'stocks': if(stocks != null, stocks, testStocks)}) \
    }}
endfunction


# The group page's controls render calls
testGroupControlCalls = [ \
    ['elementModelRender', [{'html': 'p', 'elem': [ \
        formsLinkButtonElements('Update Stocks', '<function>'), \
        {'text': ' | '}, \
        formsLinkElements('New Run', "#var.vGroup='S%26P%20100'&var.vPage='new'"), \
        {'text': ' | '}, \
        formsLinkButtonElements('Delete', '<function>') \
    ]}]], \
    ['markdownPrint', ['## Stock Symbols', '']], \
    ['elementModelRender', [{'html': 'p', 'elem': [ \
        formsTextElements('markowitz-group-symbols', 'IBM KO MSFT', 80), \
        {'text': ' '}, \
        formsLinkButtonElements('Save', '<function>') \
    ]}]], \
    ['markdownPrint', ['## Stocks', '']] \
]


async function testMarkowitzGroupPage():
    args = {'page': 'group', 'group': 'S&P 100'}
    unittestMockAll(testGroupData())
    markowitzGroupPage(args)
    expected = [['systemFetch', ['getGroup?name=S%26P%20100']]]
    arrayExtend(expected, testHeaderCalls('S&P 100', 'S&P 100', "#var.vPage='groups'"))
    arrayPush(expected, \
        ['markdownPrint', ['- **Stocks:** 3']], \
        ['markdownPrint', ['- **Stocks without prices:** MSFT']], \
        ['markdownPrint', ['']] \
    )
    arrayExtend(expected, testGroupControlCalls)
    arrayPush(expected, ['markdownPrint', [testStocksTable]])
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction
unittestRunTest('testMarkowitzGroupPage')


async function testMarkowitzGroupPage_noStocks():
    args = {'page': 'group', 'group': 'S&P 100'}
    unittestMockAll(testGroupData([]))
    markowitzGroupPage(args, 'Saved the group.')
    expected = [['systemFetch', ['getGroup?name=S%26P%20100']]]
    arrayExtend(expected, testHeaderCalls('S&P 100', 'S&P 100', "#var.vPage='groups'"))
    arrayPush(expected, \
        ['markdownPrint', ['**Saved the group.**', '']], \
        ['markdownPrint', ['- **Stocks:** 3']], \
        ['markdownPrint', ['- **Stocks without prices:** IBM, KO, MSFT']], \
        ['markdownPrint', ['']] \
    )
    arrayExtend(expected, testGroupControlCalls)
    arrayPush(expected, ['markdownPrint', ['There are no stocks with prices.']])
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction
unittestRunTest('testMarkowitzGroupPage_noStocks')


