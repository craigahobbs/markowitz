include <wsgi.bare>

# The API types and utilities - shared with the frontend
include '../frontend/markowitzTypes.bare'
include '../frontend/markowitzUtil.bare'

# The portfolio analysis, the CouchDB database helpers, and the Yahoo Finance stock price download
include 'markowitzAnalysis.bare'
include 'markowitzCouch.bare'
include 'markowitzYahoo.bare'


# The stock summary fields
markowitzStockInfoFields = ['symbol', 'name', 'currency', 'firstMonth', 'lastMonth', 'monthCount', 'updated']

# The run summary fields
markowitzRunInfoFields = ['_id', 'name', 'created', 'symbols', 'group', 'endMonth', 'months', 'horizon', 'targets', 'running']


#
# The action functions - one for each action, named for the action
#


async function getStocks():
    stocks = markowitzFindStocks({'type': 'stock'})
    if stocks == null:
        return markowitzDatabaseError()
    endif
    return {'stocks': stocks}
endfunction


async function getStock(request):
    symbol = stringUpper(objectGet(request, 'symbol'))
    doc = markowitzDBGet(markowitzStockID(symbol))
    if doc == null:
        return markowitzUnknownStock(symbol)
    endif
    return {'stock': markowitzStockInfo(doc), 'prices': objectGet(doc, 'prices')}
endfunction


async function updateStocks(request):
    symbols = markowitzSymbols(objectGet(request, 'symbols'))

    # Download the stocks' monthly prices
    downloads = markowitzYahooDownload(symbols)

    # Get the existing stock documents' revisions
    ids = []
    for symbol in symbols:
        arrayPush(ids, markowitzStockID(symbol))
    endfor
    revs = markowitzDBRevs(ids)
    if revs == null:
        return markowitzDatabaseError()
    endif

    # Create the stock documents
    updated = datetimeISOFormat(datetimeNow())
    results = []
    docs = []
    docResults = []
    for symbol, ixSymbol in symbols:
        result = {'symbol': symbol}
        arrayPush(results, result)
        stock = arrayGet(downloads, ixSymbol)
        if stock == null:
            objectSet(result, 'error', 'Download failed - is "' + symbol + '" a Yahoo Finance symbol?')
            continue
        endif

        id = arrayGet(ids, ixSymbol)
        doc = {'_id': id, 'type': 'stock', 'symbol': symbol, 'updated': updated}
        objectAssign(doc, stock)
        if objectHas(revs, id):
            objectSet(doc, '_rev', objectGet(revs, id))
        endif
        arrayPush(docs, doc)
        arrayPush(docResults, result)
    endfor

    # Save the stock documents
    saveResults = markowitzDBBulkSave(docs)
    if saveResults == null:
        return markowitzDatabaseError()
    endif
    for saveResult, ixSave in saveResults:
        result = arrayGet(docResults, ixSave)
        if objectGet(saveResult, 'ok'):
            objectSet(result, 'stock', markowitzStockInfo(arrayGet(docs, ixSave)))
        else:
            objectSet(result, 'error', 'Database update failed (' + objectGet(saveResult, 'error') + ')')
        endif
    endfor

    return {'results': results}
endfunction


async function deleteStock(request):
    symbol = stringUpper(objectGet(request, 'symbol'))
    return markowitzDeleteDoc(markowitzStockID(symbol), markowitzUnknownStock(symbol))
endfunction


async function getGroups():
    docs = markowitzDBFind({'type': 'group'}, ['name', 'symbols'])
    if docs == null:
        return markowitzDatabaseError()
    endif
    groups = []
    for doc in docs:
        arrayPush(groups, {'name': objectGet(doc, 'name'), 'symbols': objectGet(doc, 'symbols')})
    endfor
    return {'groups': arraySort(groups, markowitzCompareName)}
endfunction


async function getGroup(request):
    name = objectGet(request, 'name')
    doc = markowitzDBGet(markowitzGroupID(name))
    if doc == null:
        return markowitzUnknownGroup(name)
    endif
    symbols = objectGet(doc, 'symbols')
    stocks = markowitzFindStocks({'type': 'stock', 'symbol': {'$in': symbols}})
    if stocks == null:
        return markowitzDatabaseError()
    endif
    return {'group': {'name': name, 'symbols': symbols}, 'stocks': stocks}
endfunction


async function setGroup(request):
    if !markowitzSaveGroup(objectGet(request, 'name'), objectGet(request, 'symbols')):
        return markowitzDatabaseError()
    endif
endfunction


# Create or update a stock group document - returns true on success
async function markowitzSaveGroup(name, symbols):
    id = markowitzGroupID(name)
    revs = markowitzDBRevs([id])
    if revs == null:
        return false
    endif
    doc = {'_id': id, 'type': 'group', 'name': name, 'symbols': markowitzSymbols(symbols)}
    if objectHas(revs, id):
        objectSet(doc, '_rev', objectGet(revs, id))
    endif
    return markowitzDBPut(doc)
endfunction


async function deleteGroup(request):
    name = objectGet(request, 'name')
    return markowitzDeleteDoc(markowitzGroupID(name), markowitzUnknownGroup(name))
endfunction


async function getRuns():
    docs = markowitzDBFind({'type': 'run'}, markowitzRunInfoFields)
    if docs == null:
        return markowitzDatabaseError()
    endif
    runs = []
    for doc in docs:
        arrayPush(runs, markowitzRunInfo(doc))
    endfor
    return {'runs': arraySort(runs, markowitzCompareCreatedDescending)}
endfunction


async function getRun(request):
    id = objectGet(request, 'id')
    doc = markowitzRunGet(id)
    if doc == null:
        return markowitzUnknownRun(id)
    endif
    run = markowitzRunInfo(doc)
    objectSet(run, 'stocks', objectGet(doc, 'stocks'))
    objectSet(run, 'portfolios', objectGet(doc, 'portfolios'))
    if objectHas(doc, 'excluded'):
        objectSet(run, 'excluded', objectGet(doc, 'excluded'))
    endif
    return {'run': run}
endfunction


async function createRun(request):
    groupName = objectGet(request, 'group')
    months = objectGet(request, 'months', 36)
    horizon = objectGet(request, 'horizon', 3)
    targets = objectGet(request, 'targets')

    # Parse the end month
    endMonth = objectGet(request, 'endMonth')
    endIndex = if(endMonth != null, markowitzMonthIndex(endMonth))
    if endMonth != null && endIndex == null:
        return wsgiActionError('InvalidMonth', 'Invalid end month "' + endMonth + '" - use "YYYY-MM"')
    endif

    # Get the group's stocks
    group = markowitzDBGet(markowitzGroupID(groupName))
    if group == null:
        return markowitzUnknownGroup(groupName)
    endif
    symbols = markowitzSymbols(objectGet(group, 'symbols'))
    exclude = markowitzSymbols(objectGet(request, 'exclude', []))

    # Get the stocks' prices
    docs = markowitzDBFind({'type': 'stock', 'symbol': {'$in': symbols}}, ['symbol', 'firstMonth', 'lastMonth', 'prices'])
    if docs == null:
        return markowitzDatabaseError()
    endif
    stocks = {}
    for doc in docs:
        objectSet(stocks, objectGet(doc, 'symbol'), doc)
    endfor

    # Select the stocks, not excluded, with prices for the analysis period - the end month defaults to the latest month
    # for which most stocks (not excluded) have a price
    selection = markowitzRunSelect(symbols, stocks, endIndex, months, exclude)
    endIndex = objectGet(selection, 'endIndex')
    excluded = objectGet(selection, 'excluded')

    # Compute the stocks' monthly price relatives over the analysis period and the projection - exclude the stocks
    # missing a month's price
    runSymbols = []
    relatives = []
    horizonRelatives = []
    for symbol in objectGet(selection, 'symbols'):
        prices = objectGet(objectGet(stocks, symbol), 'prices')
        missingMonth = markowitzMissingMonth(prices, endIndex - months, endIndex)
        if missingMonth != null:
            arrayPush(excluded, {'symbol': symbol, 'reason': 'No price for ' + missingMonth})
            continue
        endif
        arrayPush(runSymbols, symbol)
        arrayPush(relatives, markowitzRelatives(prices, endIndex - months, months))
        arrayPush(horizonRelatives, markowitzRelatives(prices, endIndex, horizon))
    endfor
    if arrayLength(runSymbols) < 2:
        return wsgiActionError('TooFewStocks', 'Fewer than two stocks have prices for the analysis period')
    endif

    # The covariance matrix of the residuals about the stocks' trends is singular if there are more stocks than months
    if arrayLength(runSymbols) > months:
        return wsgiActionError( \
            'TooManyStocks', 'There are more stocks (' + arrayLength(runSymbols) + ') than months (' + months + ')' \
        )
    endif

    # Compute the stocks' statistics and save the running run - computeRunPortfolio computes its portfolios, from the
    # stocks' price relatives, one at a time
    analysis = markowitzAnalyzeStocks(runSymbols, relatives, horizonRelatives, horizon)
    run = { \
        'type': 'run', \
        'name': objectGet(request, 'name'), \
        'created': datetimeISOFormat(datetimeNow()), \
        'symbols': runSymbols, \
        'endMonth': markowitzMonthString(endIndex), \
        'months': months, \
        'horizon': horizon, \
        'targets': targets, \
        'stocks': objectGet(analysis, 'stocks'), \
        'portfolios': [], \
        'group': groupName, \
        'excluded': arraySort(excluded, markowitzCompareSymbol), \
        'running': true, \
        'relatives': relatives, \
        'horizonRelatives': horizonRelatives \
    }
    id = markowitzDBPost(run)
    if id == null:
        return markowitzDatabaseError()
    endif
    return {'id': id}
endfunction


async function computeRunPortfolio(request):
    id = objectGet(request, 'id')
    doc = markowitzRunGet(id)
    if doc == null:
        return markowitzUnknownRun(id)
    endif
    if !objectGet(doc, 'running'):
        return wsgiActionError('RunComplete', 'The run "' + id + '" is complete')
    endif

    # Compute the next target return's portfolio
    symbols = objectGet(doc, 'symbols')
    horizon = objectGet(doc, 'horizon')
    analysis = markowitzAnalyzeStocks(symbols, objectGet(doc, 'relatives'), objectGet(doc, 'horizonRelatives'), horizon)
    portfolios = objectGet(doc, 'portfolios')
    targets = objectGet(doc, 'targets')
    arrayPush(portfolios, markowitzPortfolio( \
        symbols, objectGet(analysis, 'covariance'), objectGet(analysis, 'expected'), objectGet(analysis, 'growths'), \
        horizon, arrayGet(targets, arrayLength(portfolios)) \
    ))

    # The run is complete when every target return has a portfolio
    if arrayLength(portfolios) == arrayLength(targets):
        objectDelete(doc, 'running')
        objectDelete(doc, 'relatives')
        objectDelete(doc, 'horizonRelatives')
    endif
    if !markowitzDBPut(doc):
        return markowitzDatabaseError()
    endif
    return {'portfolios': arrayLength(portfolios), 'targets': arrayLength(targets)}
endfunction


async function deleteRun(request):
    id = objectGet(request, 'id')
    doc = markowitzRunGet(id)
    if doc == null:
        return markowitzUnknownRun(id)
    endif
    if !markowitzDBDelete(id, objectGet(doc, '_rev')):
        return markowitzDatabaseError()
    endif
endfunction


# Action error helpers
function markowitzDatabaseError():
    return wsgiActionError('DatabaseError', 'The database request failed', '500 Internal Server Error')
endfunction

function markowitzUnknownStock(symbol):
    return wsgiActionError('UnknownStock', 'Unknown stock "' + symbol + '"', '404 Not Found')
endfunction

function markowitzUnknownGroup(name):
    return wsgiActionError('UnknownGroup', 'Unknown group "' + name + '"', '404 Not Found')
endfunction

function markowitzUnknownRun(id):
    return wsgiActionError('UnknownRun', 'Unknown run "' + id + '"', '404 Not Found')
endfunction


# Get a stock's document ID
function markowitzStockID(symbol):
    return 'stock:' + symbol
endfunction


# Get a group's document ID
function markowitzGroupID(name):
    return 'group:' + name
endfunction


# Get a stock document's summary
function markowitzStockInfo(doc):
    return markowitzDocFields(doc, markowitzStockInfoFields)
endfunction


# Find stock documents with a Mango selector - returns their summaries, sorted by symbol, or null on failure
async function markowitzFindStocks(selector):
    docs = markowitzDBFind(selector, markowitzStockInfoFields)
    if docs == null:
        return null
    endif
    stocks = []
    for doc in docs:
        arrayPush(stocks, markowitzStockInfo(doc))
    endfor
    return arraySort(stocks, markowitzCompareSymbol)
endfunction


# Get a run document's summary - its ID, and its run summary fields (after "_id")
function markowitzRunInfo(doc):
    return objectAssign({'id': objectGet(doc, '_id')}, markowitzDocFields(doc, arraySlice(markowitzRunInfoFields, 1)))
endfunction


# Get a document's fields that aren't null
function markowitzDocFields(doc, fields):
    values = {}
    for field in fields:
        value = objectGet(doc, field)
        if value != null:
            objectSet(values, field, value)
        endif
    endfor
    return values
endfunction


# Sort comparison functions
function markowitzCompareSymbol(a, b):
    return systemCompare(objectGet(a, 'symbol'), objectGet(b, 'symbol'))
endfunction

function markowitzCompareName(a, b):
    return systemCompare(objectGet(a, 'name'), objectGet(b, 'name'))
endfunction

function markowitzCompareCreatedDescending(a, b):
    return systemCompare(datetimeISOParse(objectGet(b, 'created')), datetimeISOParse(objectGet(a, 'created')))
endfunction



#
# Document helpers
#


# Get a run document - null if it doesn't exist (or on failure), or isn't a run
async function markowitzRunGet(id):
    doc = markowitzDBGet(id)
    return if(doc != null && objectGet(doc, 'type') == 'run', doc)
endfunction


# Delete a document, if it exists - returns null on success, or the error response (the unknown error response if it
# doesn't exist)
async function markowitzDeleteDoc(id, unknownError):
    revs = markowitzDBRevs([id])
    if revs == null:
        return markowitzDatabaseError()
    endif
    if !objectHas(revs, id):
        return unknownError
    endif
    if !markowitzDBDelete(id, objectGet(revs, id)):
        return markowitzDatabaseError()
    endif
    return null
endfunction


#
# The WSGI application
#


# The request objects - the actions, then a static request for each static file. The host passes the
# "markowitzStatics" global, a map of URL path to source path (relative to the project root).
markowitzRequests = [ \
    {'type': 'action', 'name': 'getStocks', 'path': '/getStocks'}, \
    {'type': 'action', 'name': 'getStock', 'path': '/getStock'}, \
    {'type': 'action', 'name': 'updateStocks', 'path': '/updateStocks'}, \
    {'type': 'action', 'name': 'deleteStock', 'path': '/deleteStock'}, \
    {'type': 'action', 'name': 'getGroups', 'path': '/getGroups'}, \
    {'type': 'action', 'name': 'getGroup', 'path': '/getGroup'}, \
    {'type': 'action', 'name': 'setGroup', 'path': '/setGroup'}, \
    {'type': 'action', 'name': 'deleteGroup', 'path': '/deleteGroup'}, \
    {'type': 'action', 'name': 'getRuns', 'path': '/getRuns'}, \
    {'type': 'action', 'name': 'getRun', 'path': '/getRun'}, \
    {'type': 'action', 'name': 'createRun', 'path': '/createRun'}, \
    {'type': 'action', 'name': 'computeRunPortfolio', 'path': '/computeRunPortfolio'}, \
    {'type': 'action', 'name': 'deleteRun', 'path': '/deleteRun'} \
]
arrayExtend(markowitzRequests, wsgiStaticRequests(systemGlobalGet('markowitzStatics', {}), '../'))

# The WSGI application function
markowitzApplication = wsgiCreateAPIApplication(markowitzTypes, {'doc': true, 'requests': markowitzRequests})
