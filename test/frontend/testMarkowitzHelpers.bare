# The page header calls - with the "Back" link call at the top, if there's a URL
function testHeaderCalls(title, titleMarkdown, backURL):
    calls = [['documentSetTitle', [title]]]
    if backURL != null:
        arrayPush(calls, ['markdownPrint', ['[Back](' + backURL + ')', '']])
    endif
    arrayPush(calls, ['markdownPrint', ['# ' + titleMarkdown, '', testMenu, '']])
    return calls
endfunction


# A running run's progress page calls
function testRunProgressCalls(name, count, total, percent):
    calls = testHeaderCalls(name, name)
    arrayPush(calls, \
        ['markdownPrint', [ \
            '**Running...** Computed ' + count + ' of ' + total + ' portfolios (' + percent + '%). A run of many stocks can ' + \
                'take a minute.', \
            '' \
        ]], \
        ['elementModelRender', [{'html': 'p', 'elem': [ \
            {'html': 'progress', 'attr': {'max': total, 'value': count, 'style': 'width: 30em; max-width: 100%;'}}, \
            {'text': ' '}, \
            formsLinkButtonElements('Stop', '<function>') \
        ]}]], \
        ['windowSetTimeout', ['<function>', 0]] \
    )
    return calls
endfunction


# Concatenate two arrays
function testArrayConcat(array1, array2):
    result = arrayCopy(array1)
    arrayExtend(result, array2)
    return result
endfunction


# Get a page's call log - for comparing a handler's re-render
async function testPageCalls(pageFn, data):
    unittestMockAll(data)
    pageFn()
    return unittestMockEnd()
endfunction


# The new run page's fetch mock data
function testNewRunData(stocks, groups):
    return {'systemFetch': { \
        'getStocks': jsonStringify({'stocks': if(stocks != null, stocks, testStocks)}), \
        'getGroups': jsonStringify({'groups': if(groups != null, groups, testGroups)}) \
    }}
endfunction


# Create test stocks with prices through 2026-09 - one for each first month
function testPriceStocks(firstMonths):
    stocks = []
    for firstMonth, ixFirstMonth in firstMonths:
        arrayPush(stocks, {'symbol': 'S' + ixFirstMonth, 'firstMonth': firstMonth, 'lastMonth': '2026-09', 'monthCount': 1, 'updated': testCreated})
    endfor
    return stocks
endfunction


# Get test stocks' symbols
function testStockSymbols(stocks):
    symbols = []
    for stock in stocks:
        arrayPush(symbols, objectGet(stock, 'symbol'))
    endfor
    return symbols
endfunction


# A stock update's progress page calls
function testUpdateProgressCalls(title, backURL, count, total, percent, failedText):
    calls = testHeaderCalls(title, title, backURL)
    arrayPush(calls, \
        ['markdownPrint', ['**Updating stocks...** ' + count + ' of ' + total + ' (' + percent + '%)' + failedText, '']], \
        ['elementModelRender', [{'html': 'p', 'elem': [ \
            {'html': 'progress', 'attr': {'max': total, 'value': count, 'style': 'width: 30em; max-width: 100%;'}}, \
            {'text': ' '}, \
            formsLinkButtonElements('Stop', '<function>') \
        ]}]], \
        ['windowSetTimeout', ['<function>', 0]] \
    )
    return calls
endfunction
