include <base64.bare>
include <url.bare>
include <wsgi.bare>

# The API types and utilities - shared with the frontend
include '../frontend/markowitzTypes.bare'
include '../frontend/markowitzUtil.bare'


# Remove a URL's trailing slashes
function markowitzTrimURL(url):
    return regexReplace(markowitzRegexTrailingSlashes, url, '')
endfunction

markowitzRegexTrailingSlashes = regexNew('/+$')


# The CouchDB database URL and request headers - the host passes the URL and credentials ("user:password") as globals
markowitzCouchURL = markowitzTrimURL(systemGlobalGet('markowitzCouchURL', 'http://127.0.0.1:5984/markowitz'))
markowitzCouchHeaders = { \
    'Content-Type': 'application/json', \
    'Authorization': 'Basic ' + base64Encode(stringEncode(systemGlobalGet('markowitzCouchCredentials', ''))) \
}

# The stock price download URL - Yahoo Finance's chart API. Its "range=max" downsamples long histories, so request
# every month since 1900 explicitly. It rejects requests without a user agent.
markowitzYahooURL = 'https://query1.finance.yahoo.com/v8/finance/chart/'
markowitzYahooQuery = '?period1=-2208988800&period2=9999999999&interval=1mo'
markowitzYahooHeaders = {'User-Agent': 'Mozilla/5.0 (compatible; Markowitz)'}

# The number of stock price downloads made at once
markowitzDownloadBatchSize = 10

# The stock summary fields
markowitzStockInfoFields = ['symbol', 'name', 'currency', 'firstMonth', 'lastMonth', 'monthCount', 'updated']

# The run summary fields
markowitzRunInfoFields = ['_id', 'name', 'created', 'symbols', 'group', 'endMonth', 'months', 'horizon', 'targets']

# Half a day, in seconds
markowitzHalfDaySeconds = 43200

# The magnitude below which a pivot is zero - the matrix is singular
markowitzSingularEpsilon = 1e-9


#
# The action functions - one for each action, named for the action
#


async function getStocks():
    docs = markowitzDBFind({'type': 'stock'}, markowitzStockInfoFields)
    if docs == null:
        return markowitzDatabaseError()
    endif
    stocks = []
    for doc in docs:
        arrayPush(stocks, markowitzStockInfo(doc))
    endfor
    return {'stocks': arraySort(stocks, markowitzCompareSymbol)}
endfunction


async function getStock(request):
    symbol = stringUpper(objectGet(request, 'symbol'))
    doc = markowitzDBGet(markowitzStockID(symbol))
    if doc == null:
        return markowitzUnknownStock(symbol)
    endif
    return {'stock': markowitzStockInfo(doc), 'prices': objectGet(doc, 'prices')}
endfunction


async function updateStocks(request):
    symbols = arrayCopy(objectGet(request, 'symbols', []))

    # The group's stocks
    groupName = objectGet(request, 'group')
    if groupName != null:
        group = markowitzDBGet(markowitzGroupID(groupName))
        if group == null:
            return markowitzUnknownGroup(groupName)
        endif
        arrayExtend(symbols, objectGet(group, 'symbols'))
    endif

    # Every stock in the database
    if objectGet(request, 'all'):
        docs = markowitzDBFind({'type': 'stock'}, ['symbol'])
        if docs == null:
            return markowitzDatabaseError()
        endif
        for doc in docs:
            arrayPush(symbols, objectGet(doc, 'symbol'))
        endfor
    endif

    return markowitzDownloadStocks(markowitzSymbols(symbols))
endfunction


# Download stocks' monthly prices and add or update them in the database - returns the updateStocks response
async function markowitzDownloadStocks(symbols):
    if !arrayLength(symbols):
        return {'results': []}
    endif

    # Download the stocks' monthly prices, a batch at a time
    downloadRequests = []
    ids = []
    for symbol in symbols:
        url = markowitzYahooURL + urlEncodeComponent(symbol) + markowitzYahooQuery
        arrayPush(downloadRequests, {'url': url, 'headers': markowitzYahooHeaders})
        arrayPush(ids, markowitzStockID(symbol))
    endfor
    downloads = []
    ixBatch = 0
    while ixBatch < arrayLength(downloadRequests):
        ixBatchEnd = mathMin(ixBatch + markowitzDownloadBatchSize, arrayLength(downloadRequests))
        arrayExtend(downloads, systemFetch(arraySlice(downloadRequests, ixBatch, ixBatchEnd)))
        ixBatch = ixBatchEnd
    endwhile

    # Get the existing stock documents' revisions
    revs = markowitzDBRevs(ids)
    if revs == null:
        return markowitzDatabaseError()
    endif

    # Create the stock documents
    updated = datetimeISOFormat(datetimeNow())
    results = []
    docs = []
    docResults = []
    for symbol, ixSymbol in symbols:
        result = {'symbol': symbol}
        arrayPush(results, result)
        stock = markowitzParseYahoo(arrayGet(downloads, ixSymbol))
        if stock == null:
            objectSet(result, 'error', 'Download failed - is "' + symbol + '" a Yahoo Finance symbol?')
            continue
        endif

        id = arrayGet(ids, ixSymbol)
        doc = {'_id': id, 'type': 'stock', 'symbol': symbol, 'updated': updated}
        objectAssign(doc, stock)
        if objectHas(revs, id):
            objectSet(doc, '_rev', objectGet(revs, id))
        endif
        arrayPush(docs, doc)
        arrayPush(docResults, result)
    endfor

    # Save the stock documents
    saveResults = markowitzDBBulkSave(docs)
    if saveResults == null:
        return markowitzDatabaseError()
    endif
    for saveResult, ixSave in saveResults:
        result = arrayGet(docResults, ixSave)
        if objectGet(saveResult, 'ok'):
            objectSet(result, 'stock', markowitzStockInfo(arrayGet(docs, ixSave)))
        else:
            objectSet(result, 'error', 'Database update failed (' + objectGet(saveResult, 'error') + ')')
        endif
    endfor

    return {'results': results}
endfunction


async function deleteStock(request):
    symbol = stringUpper(objectGet(request, 'symbol'))
    id = markowitzStockID(symbol)
    revs = markowitzDBRevs([id])
    if revs == null:
        return markowitzDatabaseError()
    endif
    if !objectHas(revs, id):
        return markowitzUnknownStock(symbol)
    endif
    if !markowitzDBDelete(id, objectGet(revs, id)):
        return markowitzDatabaseError()
    endif
endfunction


async function getGroups():
    docs = markowitzDBFind({'type': 'group'}, ['name', 'symbols'])
    if docs == null:
        return markowitzDatabaseError()
    endif
    groups = []
    for doc in docs:
        arrayPush(groups, {'name': objectGet(doc, 'name'), 'symbols': objectGet(doc, 'symbols')})
    endfor
    return {'groups': arraySort(groups, markowitzCompareName)}
endfunction


async function getGroup(request):
    name = objectGet(request, 'name')
    doc = markowitzDBGet(markowitzGroupID(name))
    if doc == null:
        return markowitzUnknownGroup(name)
    endif
    symbols = objectGet(doc, 'symbols')
    stockDocs = markowitzDBFind({'type': 'stock', 'symbol': {'$in': symbols}}, markowitzStockInfoFields)
    if stockDocs == null:
        return markowitzDatabaseError()
    endif
    stocks = []
    for stockDoc in stockDocs:
        arrayPush(stocks, markowitzStockInfo(stockDoc))
    endfor
    return {'group': {'name': name, 'symbols': symbols}, 'stocks': arraySort(stocks, markowitzCompareSymbol)}
endfunction


async function setGroup(request):
    if !markowitzSaveGroup(objectGet(request, 'name'), objectGet(request, 'symbols')):
        return markowitzDatabaseError()
    endif
endfunction


# Create or update a stock group document - returns true on success
async function markowitzSaveGroup(name, symbols):
    id = markowitzGroupID(name)
    revs = markowitzDBRevs([id])
    if revs == null:
        return false
    endif
    doc = {'_id': id, 'type': 'group', 'name': name, 'symbols': markowitzSymbols(symbols)}
    if objectHas(revs, id):
        objectSet(doc, '_rev', objectGet(revs, id))
    endif
    return markowitzDBPut(doc)
endfunction


async function deleteGroup(request):
    name = objectGet(request, 'name')
    id = markowitzGroupID(name)
    revs = markowitzDBRevs([id])
    if revs == null:
        return markowitzDatabaseError()
    endif
    if !objectHas(revs, id):
        return markowitzUnknownGroup(name)
    endif
    if !markowitzDBDelete(id, objectGet(revs, id)):
        return markowitzDatabaseError()
    endif
endfunction


async function getRuns():
    docs = markowitzDBFind({'type': 'run'}, markowitzRunInfoFields)
    if docs == null:
        return markowitzDatabaseError()
    endif
    runs = []
    for doc in docs:
        arrayPush(runs, markowitzRunInfo(doc))
    endfor
    return {'runs': arraySort(runs, markowitzCompareCreatedDescending)}
endfunction


async function getRun(request):
    id = objectGet(request, 'id')
    doc = markowitzDBGet(id)
    if doc == null || objectGet(doc, 'type') != 'run':
        return markowitzUnknownRun(id)
    endif
    run = markowitzRunInfo(doc)
    objectSet(run, 'stocks', objectGet(doc, 'stocks'))
    objectSet(run, 'portfolios', objectGet(doc, 'portfolios'))
    if objectHas(doc, 'excluded'):
        objectSet(run, 'excluded', objectGet(doc, 'excluded'))
    endif
    return {'run': run}
endfunction


async function createRun(request):
    groupName = objectGet(request, 'group')
    months = objectGet(request, 'months', 36)
    horizon = objectGet(request, 'horizon', 3)
    targets = objectGet(request, 'targets')

    # Parse the end month
    endMonth = objectGet(request, 'endMonth')
    endIndex = if(endMonth != null, markowitzMonthIndex(endMonth))
    if endMonth != null && endIndex == null:
        return wsgiActionError('InvalidMonth', 'Invalid end month "' + endMonth + '" - use "YYYY-MM"')
    endif

    # Get the group's stocks
    group = markowitzDBGet(markowitzGroupID(groupName))
    if group == null:
        return markowitzUnknownGroup(groupName)
    endif
    symbols = markowitzSymbols(objectGet(group, 'symbols'))
    exclude = markowitzSymbols(objectGet(request, 'exclude', []))

    # Get the stocks' prices
    docs = markowitzDBFind({'type': 'stock', 'symbol': {'$in': symbols}}, ['symbol', 'firstMonth', 'lastMonth', 'prices'])
    if docs == null:
        return markowitzDatabaseError()
    endif
    stocks = {}
    for doc in docs:
        objectSet(stocks, objectGet(doc, 'symbol'), doc)
    endfor

    # Select the stocks, not excluded, with prices for the analysis period - the end month defaults to the latest month
    # for which most stocks (not excluded) have a price
    selection = markowitzRunSelect(symbols, stocks, endIndex, months, exclude)
    endIndex = objectGet(selection, 'endIndex')
    excluded = objectGet(selection, 'excluded')

    # Compute the stocks' monthly price relatives over the analysis period and the projection - exclude the stocks
    # missing a month's price
    runSymbols = []
    relatives = []
    horizonRelatives = []
    for symbol in objectGet(selection, 'symbols'):
        prices = objectGet(objectGet(stocks, symbol), 'prices')
        missingMonth = markowitzMissingMonth(prices, endIndex - months, endIndex)
        if missingMonth != null:
            arrayPush(excluded, {'symbol': symbol, 'reason': 'No price for ' + missingMonth})
            continue
        endif
        arrayPush(runSymbols, symbol)
        arrayPush(relatives, markowitzRelatives(prices, endIndex - months, months))
        arrayPush(horizonRelatives, markowitzRelatives(prices, endIndex, horizon))
    endfor
    if arrayLength(runSymbols) < 2:
        return wsgiActionError('TooFewStocks', 'Fewer than two stocks have prices for the analysis period')
    endif

    # The covariance matrix of the residuals about the stocks' trends is singular if there are more stocks than months
    if arrayLength(runSymbols) > months:
        return wsgiActionError( \
            'TooManyStocks', 'There are more stocks (' + arrayLength(runSymbols) + ') than months (' + months + ')' \
        )
    endif

    # Compute the run and save it
    analysis = markowitzAnalyze(runSymbols, relatives, horizonRelatives, horizon, targets)
    run = { \
        'type': 'run', \
        'name': objectGet(request, 'name'), \
        'created': datetimeISOFormat(datetimeNow()), \
        'symbols': runSymbols, \
        'endMonth': markowitzMonthString(endIndex), \
        'months': months, \
        'horizon': horizon, \
        'targets': targets, \
        'stocks': objectGet(analysis, 'stocks'), \
        'portfolios': objectGet(analysis, 'portfolios'), \
        'group': groupName, \
        'excluded': arraySort(excluded, markowitzCompareSymbol) \
    }
    id = markowitzDBPost(run)
    if id == null:
        return markowitzDatabaseError()
    endif
    return {'id': id}
endfunction


async function deleteRun(request):
    id = objectGet(request, 'id')
    doc = markowitzDBGet(id)
    if doc == null || objectGet(doc, 'type') != 'run':
        return markowitzUnknownRun(id)
    endif
    if !markowitzDBDelete(id, objectGet(doc, '_rev')):
        return markowitzDatabaseError()
    endif
endfunction


# Action error helpers
function markowitzDatabaseError():
    return wsgiActionError('DatabaseError', 'The database request failed', '500 Internal Server Error')
endfunction

function markowitzUnknownStock(symbol):
    return wsgiActionError('UnknownStock', 'Unknown stock "' + symbol + '"', '404 Not Found')
endfunction

function markowitzUnknownGroup(name):
    return wsgiActionError('UnknownGroup', 'Unknown group "' + name + '"', '404 Not Found')
endfunction

function markowitzUnknownRun(id):
    return wsgiActionError('UnknownRun', 'Unknown run "' + id + '"', '404 Not Found')
endfunction


# Get a stock's document ID
function markowitzStockID(symbol):
    return 'stock:' + symbol
endfunction


# Get a group's document ID
function markowitzGroupID(name):
    return 'group:' + name
endfunction


# Get a stock document's summary
function markowitzStockInfo(doc):
    info = {}
    for field in markowitzStockInfoFields:
        value = objectGet(doc, field)
        if value != null:
            objectSet(info, field, value)
        endif
    endfor
    return info
endfunction


# Get a run document's summary
function markowitzRunInfo(doc):
    info = {'id': objectGet(doc, '_id')}
    for field in arraySlice(markowitzRunInfoFields, 1):
        value = objectGet(doc, field)
        if value != null:
            objectSet(info, field, value)
        endif
    endfor
    return info
endfunction


# Sort comparison functions
function markowitzCompareSymbol(a, b):
    return systemCompare(objectGet(a, 'symbol'), objectGet(b, 'symbol'))
endfunction

function markowitzCompareName(a, b):
    return systemCompare(objectGet(a, 'name'), objectGet(b, 'name'))
endfunction

function markowitzCompareCreatedDescending(a, b):
    return systemCompare(datetimeISOParse(objectGet(b, 'created')), datetimeISOParse(objectGet(a, 'created')))
endfunction


#
# Stock prices
#


# Get the month string of a POSIX timestamp, in seconds - computed from the days since the epoch (Howard Hinnant's
# "civil_from_days" algorithm), since BareScript datetimes are local time
function markowitzTimestampMonth(timestamp):
    days = mathFloor(timestamp / 86400) + 719468
    era = mathFloor(days / 146097)
    dayOfEra = days - era * 146097
    yearOfEra = mathFloor((dayOfEra - mathFloor(dayOfEra / 1460) + mathFloor(dayOfEra / 36524) - mathFloor(dayOfEra / 146096)) / 365)
    dayOfYear = dayOfEra - (365 * yearOfEra + mathFloor(yearOfEra / 4) - mathFloor(yearOfEra / 100))
    monthPrime = mathFloor((5 * dayOfYear + 2) / 153)
    monthNumber = if(monthPrime < 10, monthPrime + 3, monthPrime - 9)
    year = yearOfEra + era * 400 + if(monthNumber <= 2, 1, 0)
    return markowitzMonthString(year * 12 + monthNumber - 1)
endfunction


# Parse a Yahoo Finance chart API monthly response - returns the stock document fields, or null on failure. The month
# of the latest trade is incomplete, so it's excluded (and so are any later months).
function markowitzParseYahoo(responseText):
    response = if(responseText != null, jsonParse(responseText))
    chart = if(response != null, objectGet(response, 'chart'))
    chartResults = if(chart != null, objectGet(chart, 'result'))
    if !chartResults:
        return null
    endif
    chartResult = arrayGet(chartResults, 0)
    meta = objectGet(chartResult, 'meta', {})
    offset = objectGet(meta, 'gmtoffset', 0)
    currentMonth = markowitzTimestampMonth(objectGet(meta, 'regularMarketTime', 0) + offset)

    # Map each month to its last price. A month's price is at the exchange's local midnight on the month's first day,
    # but the offset is the latest trade's - in or out of daylight saving time - so round to the nearest local day. The
    # latest trade's price is at its time, which rounds into its month, or the next.
    timestamps = objectGet(chartResult, 'timestamp', [])
    adjcloses = objectGet(objectGet(chartResult, 'indicators', {}), 'adjclose')
    closes = if(adjcloses, objectGet(arrayGet(adjcloses, 0), 'adjclose'), [])
    prices = {}
    for timestamp, ixTimestamp in timestamps:
        month = markowitzTimestampMonth(timestamp + offset + markowitzHalfDaySeconds)
        close = if(ixTimestamp < arrayLength(closes), arrayGet(closes, ixTimestamp))
        if month < currentMonth && close != null && close > 0:
            objectSet(prices, month, close)
        endif
    endfor
    months = arraySort(objectKeys(prices))
    if !months:
        return null
    endif

    return { \
        'name': objectGet(meta, 'longName') || objectGet(meta, 'shortName'), \
        'currency': objectGet(meta, 'currency'), \
        'firstMonth': arrayGet(months, 0), \
        'lastMonth': arrayGet(months, arrayLength(months) - 1), \
        'monthCount': arrayLength(months), \
        'prices': prices \
    }
endfunction


# Get the first month, from a start month to an end month, without a price - null if every month has a price
function markowitzMissingMonth(prices, startIndex, endIndex):
    monthIndex = startIndex
    while monthIndex <= endIndex:
        month = markowitzMonthString(monthIndex)
        if !objectHas(prices, month):
            return month
        endif
        monthIndex = monthIndex + 1
    endwhile
    return null
endfunction


# Compute a stock's monthly price relatives (the ratio of a month's price to the prior month's) for the months
# following a month - null if a month has no price
function markowitzRelatives(prices, startIndex, count):
    relatives = []
    pricePrior = objectGet(prices, markowitzMonthString(startIndex))
    monthIndex = startIndex + 1
    while monthIndex <= startIndex + count:
        price = objectGet(prices, markowitzMonthString(monthIndex))
        if pricePrior == null || price == null:
            return null
        endif
        arrayPush(relatives, price / pricePrior)
        pricePrior = price
        monthIndex = monthIndex + 1
    endwhile
    return relatives
endfunction


#
# The Markowitz portfolio analysis - a port of Program HOBBS, Fortran 2.1, 09/13/67
#


# Compute a run's stock statistics and each target return's portfolio. Each stock's monthly percent returns are
# regressed on time - the projected return is the trend's return at the end of the projection, and the risk is the
# variance (and covariance) of the returns about their trend.
function markowitzAnalyze(symbols, relatives, horizonRelatives, horizon, targets):
    monthCount = arrayLength(arrayGet(relatives, 0))
    xBar = (monthCount + 1) / 2
    sumX2 = 0
    month = 1
    while month <= monthCount:
        sumX2 = sumX2 + (month - xBar) ** 2
        month = month + 1
    endwhile

    # Regress each stock's monthly percent returns on time
    stocks = []
    expected = []
    growths = []
    residuals = []
    for stockRelatives, ixStock in relatives:
        returns = []
        yBar = 0
        sumXY = 0
        for relative, ixMonth in stockRelatives:
            percent = (relative - 1) * 100
            arrayPush(returns, percent)
            yBar = yBar + percent
            sumXY = sumXY + (ixMonth + 1 - xBar) * percent
        endfor
        yBar = yBar / monthCount
        slope = sumXY / sumX2
        intercept = yBar - slope * xBar
        projected = yBar + slope * (monthCount + horizon - xBar)

        # The residuals about the trend
        stockResiduals = []
        variance = 0
        for percent, ixMonth in returns:
            residual = percent - intercept - slope * (ixMonth + 1)
            arrayPush(stockResiduals, residual)
            variance = variance + residual * residual
        endfor

        # The growth over the projection, if its months have passed
        growth = null
        stockHorizonRelatives = arrayGet(horizonRelatives, ixStock)
        if stockHorizonRelatives != null:
            growth = 1
            for relative in stockHorizonRelatives:
                growth = growth * relative
            endfor
        endif

        stock = { \
            'symbol': arrayGet(symbols, ixStock), \
            'expectedReturn': markowitzAnnualReturn(1 + projected / 100, 12), \
            'variance': variance / monthCount \
        }
        if growth != null:
            objectSet(stock, 'realizedReturn', markowitzAnnualReturn(growth, 12 / horizon))
        endif
        arrayPush(stocks, stock)
        arrayPush(expected, projected)
        arrayPush(growths, growth)
        arrayPush(residuals, stockResiduals)
    endfor

    # The covariance matrix of the residuals
    covariance = []
    for residualsI in residuals:
        row = []
        for residualsJ in residuals:
            sum = 0
            for residual, ixMonth in residualsI:
                sum = sum + residual * arrayGet(residualsJ, ixMonth)
            endfor
            arrayPush(row, sum / monthCount)
        endfor
        arrayPush(covariance, row)
    endfor

    # Compute each target return's portfolio
    portfolios = []
    for target in targets:
        arrayPush(portfolios, markowitzPortfolio(symbols, covariance, expected, growths, horizon, target))
    endfor

    return {'stocks': stocks, 'portfolios': portfolios}
endfunction


# Annualize a growth ratio - returns the annual percent return
function markowitzAnnualReturn(growth, periodsPerYear):
    return (growth ** periodsPerYear - 1) * 100
endfunction


# Compute a target annual return's minimum-variance portfolio. Solve for the weights that minimize the variance with
# the target return and weights that sum to one (the Lagrangian's linear system). If a weight is negative, delete its
# stock (the most negative) and solve again.
function markowitzPortfolio(symbols, covariance, expected, growths, horizon, target):
    targetMonthly = ((1 + target / 100) ** (1 / 12) - 1) * 100
    stockIndexes = []
    while arrayLength(stockIndexes) < arrayLength(symbols):
        arrayPush(stockIndexes, arrayLength(stockIndexes))
    endwhile
    deleted = []
    deletedWeights = []
    while true:
        weights = markowitzSolve(markowitzSystem(covariance, expected, stockIndexes, targetMonthly))
        if weights == null:
            return {'target': target, 'solved': false, 'allocations': [], 'deleted': deleted, 'deletedWeights': deletedWeights}
        endif

        # Find the most negative weight - if none, done
        ixMinimum = null
        weightMinimum = 0
        for stockIndex, ixIndex in stockIndexes:
            weight = arrayGet(weights, ixIndex)
            if weight < weightMinimum:
                weightMinimum = weight
                ixMinimum = ixIndex
            endif
        endfor
        if ixMinimum == null:
            break
        endif

        # Delete the stock from the portfolio
        arrayPush(deleted, arrayGet(symbols, arrayGet(stockIndexes, ixMinimum)))
        arrayPush(deletedWeights, weightMinimum)
        arrayDelete(stockIndexes, ixMinimum)
    endwhile

    # The portfolio's allocations, variance, and realized return
    allocations = []
    variance = 0
    growth = 0
    for stockIndex, ixIndex in stockIndexes:
        weight = arrayGet(weights, ixIndex)
        arrayPush(allocations, {'symbol': arrayGet(symbols, stockIndex), 'weight': weight})
        covarianceRow = arrayGet(covariance, stockIndex)
        for stockIndexJ, ixIndexJ in stockIndexes:
            variance = variance + weight * arrayGet(weights, ixIndexJ) * arrayGet(covarianceRow, stockIndexJ)
        endfor
        stockGrowth = arrayGet(growths, stockIndex)
        growth = if(growth != null && stockGrowth != null, growth + weight * stockGrowth)
    endfor
    portfolio = { \
        'target': target, \
        'solved': true, \
        'allocations': allocations, \
        'deleted': deleted, \
        'deletedWeights': deletedWeights, \
        'variance': variance \
    }
    if growth != null:
        objectSet(portfolio, 'realizedReturn', markowitzAnnualReturn(growth, 12 / horizon))
    endif
    return portfolio
endfunction


# Create the augmented matrix of the portfolio's linear system - the covariance matrix bordered by the expected
# returns and ones, with the right-hand side zeros, the target return, and one
function markowitzSystem(covariance, expected, stockIndexes, targetMonthly):
    matrix = []
    expectedRow = []
    onesRow = []
    for stockIndex in stockIndexes:
        covarianceRow = arrayGet(covariance, stockIndex)
        row = []
        for stockIndexJ in stockIndexes:
            arrayPush(row, arrayGet(covarianceRow, stockIndexJ))
        endfor
        arrayPush(row, arrayGet(expected, stockIndex), 1, 0)
        arrayPush(matrix, row)
        arrayPush(expectedRow, arrayGet(expected, stockIndex))
        arrayPush(onesRow, 1)
    endfor
    arrayPush(expectedRow, 0, 0, targetMonthly)
    arrayPush(onesRow, 0, 0, 1)
    arrayPush(matrix, expectedRow, onesRow)
    return matrix
endfunction


# Solve a linear system's augmented matrix, in place, with Gauss-Jordan elimination and partial pivoting - returns
# the solution array, or null if the matrix is singular ("D WAS ZERO, NO SOLUTION")
function markowitzSolve(matrix):
    size = arrayLength(matrix)
    columnCount = size + 1
    ixColumn = 0
    while ixColumn < size:
        # Find the pivot row - the first row with the column's largest magnitude
        ixPivot = ixColumn
        pivotMagnitude = mathAbs(arrayGet(arrayGet(matrix, ixColumn), ixColumn))
        ixRow = ixColumn + 1
        while ixRow < size:
            magnitude = mathAbs(arrayGet(arrayGet(matrix, ixRow), ixColumn))
            if magnitude > pivotMagnitude:
                pivotMagnitude = magnitude
                ixPivot = ixRow
            endif
            ixRow = ixRow + 1
        endwhile
        if pivotMagnitude < markowitzSingularEpsilon:
            return null
        endif

        # Swap the pivot row into place and normalize it - its prior columns are zero
        pivotRow = arrayGet(matrix, ixPivot)
        arraySet(matrix, ixPivot, arrayGet(matrix, ixColumn))
        arraySet(matrix, ixColumn, pivotRow)
        pivot = arrayGet(pivotRow, ixColumn)
        ixValue = ixColumn
        while ixValue < columnCount:
            arraySet(pivotRow, ixValue, arrayGet(pivotRow, ixValue) / pivot)
            ixValue = ixValue + 1
        endwhile

        # Eliminate the column from the other rows
        for row, ixRow in matrix:
            factor = arrayGet(row, ixColumn)
            if ixRow != ixColumn && factor != 0:
                ixValue = ixColumn
                while ixValue < columnCount:
                    arraySet(row, ixValue, arrayGet(row, ixValue) - factor * arrayGet(pivotRow, ixValue))
                    ixValue = ixValue + 1
                endwhile
            endif
        endfor

        ixColumn = ixColumn + 1
    endwhile

    # The solution is the right-hand side column
    solution = []
    for row in matrix:
        arrayPush(solution, arrayGet(row, size))
    endfor
    return solution
endfunction


#
# CouchDB database helpers
#


# Get a document - null if it doesn't exist (or on failure)
async function markowitzDBGet(id):
    docJSON = systemFetch({'url': markowitzCouchURL + '/' + urlEncodeComponent(id), 'headers': markowitzCouchHeaders})
    return if(docJSON != null, jsonParse(docJSON))
endfunction


# Create or update a document (an update has the current "_rev") - returns true on success
async function markowitzDBPut(doc):
    url = markowitzCouchURL + '/' + urlEncodeComponent(objectGet(doc, '_id'))
    return systemFetch({'url': url, 'method': 'PUT', 'headers': markowitzCouchHeaders, 'body': jsonStringify(doc)}) != null
endfunction


# Create a document with a database-assigned ID - returns the ID, or null on failure
async function markowitzDBPost(doc):
    responseJSON = systemFetch({'url': markowitzCouchURL, 'headers': markowitzCouchHeaders, 'body': jsonStringify(doc)})
    return if(responseJSON != null, objectGet(jsonParse(responseJSON), 'id'))
endfunction


# Create or update documents (an update has the current "_rev") - returns the array of per-document results
# ({"ok": true} or {"error": "conflict"}), or null on failure
async function markowitzDBBulkSave(docs):
    url = markowitzCouchURL + '/_bulk_docs'
    responseJSON = systemFetch({'url': url, 'headers': markowitzCouchHeaders, 'body': jsonStringify({'docs': docs})})
    return if(responseJSON != null, jsonParse(responseJSON))
endfunction


# Delete a document - returns true on success
async function markowitzDBDelete(id, rev):
    url = markowitzCouchURL + '/' + urlEncodeComponent(id) + '?rev=' + urlEncodeComponent(rev)
    return systemFetch({'url': url, 'method': 'DELETE', 'headers': markowitzCouchHeaders}) != null
endfunction


# Find documents with a Mango selector, returning only the fields - null on failure
async function markowitzDBFind(selector, fields):
    body = jsonStringify({'selector': selector, 'fields': fields, 'limit': 100000})
    responseJSON = systemFetch({'url': markowitzCouchURL + '/_find', 'headers': markowitzCouchHeaders, 'body': body})
    return if(responseJSON != null, objectGet(jsonParse(responseJSON), 'docs'))
endfunction


# Get the current revisions of the existing (not deleted) documents - returns the map of ID to revision, or null on
# failure
async function markowitzDBRevs(ids):
    url = markowitzCouchURL + '/_all_docs'
    responseJSON = systemFetch({'url': url, 'headers': markowitzCouchHeaders, 'body': jsonStringify({'keys': ids})})
    if responseJSON == null:
        return null
    endif
    revs = {}
    for row in objectGet(jsonParse(responseJSON), 'rows'):
        value = objectGet(row, 'value')
        if value != null && !objectGet(value, 'deleted'):
            objectSet(revs, objectGet(row, 'id'), objectGet(value, 'rev'))
        endif
    endfor
    return revs
endfunction


#
# The WSGI application
#


# The request objects - the actions, then a static request for each static file. The host passes the
# "markowitzStatics" global, a map of URL path to source path (relative to the project root).
markowitzRequests = [ \
    {'type': 'action', 'name': 'getStocks', 'path': '/getStocks'}, \
    {'type': 'action', 'name': 'getStock', 'path': '/getStock'}, \
    {'type': 'action', 'name': 'updateStocks', 'path': '/updateStocks'}, \
    {'type': 'action', 'name': 'deleteStock', 'path': '/deleteStock'}, \
    {'type': 'action', 'name': 'getGroups', 'path': '/getGroups'}, \
    {'type': 'action', 'name': 'getGroup', 'path': '/getGroup'}, \
    {'type': 'action', 'name': 'setGroup', 'path': '/setGroup'}, \
    {'type': 'action', 'name': 'deleteGroup', 'path': '/deleteGroup'}, \
    {'type': 'action', 'name': 'getRuns', 'path': '/getRuns'}, \
    {'type': 'action', 'name': 'getRun', 'path': '/getRun'}, \
    {'type': 'action', 'name': 'createRun', 'path': '/createRun'}, \
    {'type': 'action', 'name': 'deleteRun', 'path': '/deleteRun'} \
]
arrayExtend(markowitzRequests, wsgiStaticRequests(systemGlobalGet('markowitzStatics', {}), '../'))

# The WSGI application function
markowitzApplication = wsgiCreateAPIApplication(markowitzTypes, {'doc': true, 'requests': markowitzRequests})
