    form = objectAssign(objectCopy(testForm), {'group': 'S&P 100', 'exclude': ' msft, XYZ '})
    request = objectAssign(objectCopy(testRequest), {'group': 'S&P 100', 'exclude': ['MSFT', 'XYZ']})
    unittestDeepEqual(markowitzRunRequest(form, testStocks, testGroups), {'request': request})

    # Excluding IBM leaves MSFT, without prices
    unittestDeepEqual(markowitzRunRequest(objectAssign(objectCopy(form), {'exclude': 'IBM'}), testStocks, testGroups), {'missing': ['MSFT']})

    # Excluding IBM and MSFT leaves one stock
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(form), {'exclude': 'IBM MSFT'}), testStocks, testGroups), \
        {'error': 'Fewer than two of the group\'s stocks have prices for the analysis period - update the group\'s stocks.'} \
