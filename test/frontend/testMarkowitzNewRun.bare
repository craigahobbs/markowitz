        testNewRunFetchCalls, "#var.vGroup='S%26P%20100'&var.vPage='group'", null, testGroupCall('S&P 100', 3), false, form, \
        testMinimumText(6, 2, 3), testMissingText('S%26P%20100', 1, 3) \
    )
    arrayPush(expected, \
        ['markdownPrint', ['## S&P 100 Stocks', '']], \
        ['markdownPrint', [testStocksTable]] \
    )
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction
unittestRunTest('testMarkowitzNewRunPage_group')


