async function testCreateRun_excluded():
    # E's prices start late, and C is missing a month's price - F is unknown
    docs = testStockDocs()
    arrayPush(docs, objectAssign(objectCopy(arrayGet(docs, 0)), {'symbol': 'E', 'firstMonth': '2021-01'}))
    objectDelete(objectGet(arrayGet(docs, 2), 'prices'), '2021-06')
    testMockAll(testCreateRunData(['A', 'B', 'C', 'D', 'E', 'F'], docs, 'run3'))
    request = {'name': 'Group Run', 'group': 'Test', 'endMonth': '2023-01', 'targets': [10]}
    unittestDeepEqual(testAction('POST', '/createRun', '', request), ['200 OK', {'id': 'run3'}])
    run = testCreateRunDoc(unittestMockEnd())
    unittestEqual(objectGet(run, 'group'), 'Test')
    unittestDeepEqual(objectGet(run, 'symbols'), ['A', 'B', 'D'])
    unittestDeepEqual(objectGet(run, 'excluded'), [ \
        {'symbol': 'C', 'reason': 'No price for 2021-06'}, \
        {'symbol': 'E', 'reason': 'Prices start in 2021-01'}, \
        {'symbol': 'F', 'reason': 'No prices - update the stock on the Stocks page'} \
    ])
endfunction
unittestRunTest('testCreateRun_excluded')


async function testCreateRun_exclude():
    # B's prices end early - excluded, it doesn't move the default end month. E is unknown.
    docs = testStockDocs()
    objectSet(arrayGet(docs, 1), 'lastMonth', '2022-12')
    testMockAll(testCreateRunData(['A', 'B', 'C', 'D', 'E'], docs, 'run5'))
    request = {'name': 'Test Run', 'group': 'Test', 'exclude': ['c', 'B', 'E', 'XYZ'], 'targets': [10]}
    unittestDeepEqual(testAction('POST', '/createRun', '', request), ['200 OK', {'id': 'run5'}])
    run = testCreateRunDoc(unittestMockEnd())
    unittestEqual(objectGet(run, 'endMonth'), '2023-04')
    unittestDeepEqual(objectGet(run, 'symbols'), ['A', 'D'])
    unittestDeepEqual(objectGet(run, 'excluded'), [ \
        {'symbol': 'B', 'reason': 'Prices end in 2022-12'}, \
        {'symbol': 'C', 'reason': 'Excluded by the user'}, \
        {'symbol': 'E', 'reason': 'No prices - update the stock on the Stocks page'} \
    ])
endfunction
unittestRunTest('testCreateRun_exclude')


async function testCreateRun_stale():
    # One of ten stocks' prices end early - it's excluded, rather than ending the analysis period early
    symbols = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J']
    docs = testStockDocs(symbols)
    objectSet(arrayGet(docs, 5), 'lastMonth', '2022-06')
    testMockAll(testCreateRunData(symbols, docs, 'run6'))
    request = {'name': 'Test Run', 'group': 'Test', 'targets': [10]}
    unittestDeepEqual(testAction('POST', '/createRun', '', request), ['200 OK', {'id': 'run6'}])
    run = testCreateRunDoc(unittestMockEnd())
    unittestEqual(objectGet(run, 'endMonth'), '2023-04')
    unittestEqual(arrayIndexOf(objectGet(run, 'symbols'), 'F'), -1)
    unittestDeepEqual(objectGet(run, 'excluded'), [{'symbol': 'F', 'reason': 'Prices end in 2022-06'}])
endfunction
unittestRunTest('testCreateRun_stale')


