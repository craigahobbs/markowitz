# Round a value's numbers, recursively, for comparison
function testRound(value):
    type = systemType(value)
    if type == 'number':
        return mathRound(value * 1e9) / 1e9
    elif type == 'array':
        rounded = []
        for item in value:
            arrayPush(rounded, testRound(item))
        endfor
        return rounded
    elif type == 'object':
        rounded = {}
        for key in objectKeys(value):
            objectSet(rounded, key, testRound(objectGet(value, key)))
        endfor
        return rounded
    endif
    return value
endfunction


