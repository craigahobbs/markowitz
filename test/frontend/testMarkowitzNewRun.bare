# Find the change callback of the input element with the ID
function testFindChange(model, id):
    type = systemType(model)
    if type == 'array':
        for item in model:
            found = testFindChange(item, id)
            if found != null:
                return found
            endif
        endfor
    elif type == 'object':
        callback = objectGet(model, 'callback')
        if callback != null && objectGet(objectGet(model, 'attr', {}), 'id') == id:
            return objectGet(callback, 'change')
        endif
        return testFindChange(objectGet(model, 'elem'), id)
    endif
    return null
endfunction


async function testMarkowitzNewRunPage_periodChangeBinding():
    args = {'page': 'new'}
    data = testNewRunInputData(objectAssign(objectCopy(testForm), {'months': '12'}))
    for id in ['markowitz-endMonth', 'markowitz-months']:
        unittestMockAll(data)
        markowitzNewRunPage(args, testForm)
        found = testFindChange(unittestMockEnd(), id)
        testSameEffect(found, systemPartial(markowitzOnRunPeriodChange, args, 'Dow 30', testStocks, testGroups), data)
    endfor

    # Without a selected group, there are no change callbacks
    unittestMockAll(data)
    markowitzNewRunPage(args)
    unittestEqual(testFindChange(unittestMockEnd(), 'markowitz-months'), null)
endfunction
unittestRunTest('testMarkowitzNewRunPage_periodChangeBinding')


