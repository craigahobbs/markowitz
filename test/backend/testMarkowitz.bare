#
# computeRunPortfolio tests
#


# A test running run document - the test stocks' run with the test portfolios computed so far
function testRunningDoc(portfolioCount):
    return { \
        '_id': 'run1', '_rev': '1-abc', 'type': 'run', 'name': 'Test Run', 'created': testNowISO, 'symbols': testSymbols, \
        'group': 'Test', 'endMonth': '2023-01', 'months': 36, 'horizon': 3, 'targets': testTargets, \
        'stocks': testRunStocks, 'portfolios': arraySlice(testRunPortfolios, 0, portfolioCount), 'excluded': [], \
        'running': true, 'relatives': testAnalysisRelatives, 'horizonRelatives': testHorizonRelatives \
    }
endfunction


async function testComputeRunPortfolio():
    fetchData = {}
    objectSet(fetchData, testCouchURL + '/run1', jsonStringify(testRunningDoc(0)))
    testMockAll({'systemFetch': fetchData})
    unittestDeepEqual(testAction('POST', '/computeRunPortfolio', '', {'id': 'run1'}), ['200 OK', {'portfolios': 1, 'targets': 3}])
    calls = unittestMockEnd()
    unittestEqual(arrayLength(calls), 2)
    unittestDeepEqual(arrayGet(calls, 0), testCouchCall('/run1'))

    # The first portfolio matches the original program's
    putRequest = arrayGet(arrayGet(arrayGet(calls, 1), 1), 0)
    unittestEqual(objectGet(putRequest, 'url'), testCouchURL + '/run1')
    unittestEqual(objectGet(putRequest, 'method'), 'PUT')
    unittestDeepEqual(testRound(jsonParse(objectGet(putRequest, 'body'))), testRound(testRunningDoc(1)))
endfunction
unittestRunTest('testComputeRunPortfolio')


async function testComputeRunPortfolio_complete():
    # The last portfolio completes the run - its relatives are removed
    testMockAll({'systemFetch': objectNew(testCouchURL + '/run1', jsonStringify(testRunningDoc(2)))})
    unittestDeepEqual(testAction('POST', '/computeRunPortfolio', '', {'id': 'run1'}), ['200 OK', {'portfolios': 3, 'targets': 3}])
    doc = testRunningDoc(3)
    objectDelete(doc, 'running')
    objectDelete(doc, 'relatives')
    objectDelete(doc, 'horizonRelatives')
    unittestDeepEqual(testRound(jsonParse(objectGet(arrayGet(arrayGet(arrayGet(unittestMockEnd(), 1), 1), 0), 'body'))), testRound(doc))
endfunction
unittestRunTest('testComputeRunPortfolio_complete')


async function testComputeRunPortfolio_runComplete():
    doc = testRunningDoc(3)
    objectDelete(doc, 'running')
    testMockAll({'systemFetch': objectNew(testCouchURL + '/run1', jsonStringify(doc))})
    unittestDeepEqual( \
        testAction('POST', '/computeRunPortfolio', '', {'id': 'run1'}), \
        ['400 Bad Request', {'error': 'RunComplete', 'message': 'The run "run1" is complete'}] \
    )
    unittestEqual(arrayLength(unittestMockEnd()), 1)
endfunction
unittestRunTest('testComputeRunPortfolio_runComplete')


