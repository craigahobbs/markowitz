include <args.bare>
include <dataLineChart.bare>
include <dataTable.bare>
include <forms.bare>
include <markdown.bare>
include <schema.bare>
include <url.bare>

# The API types and utilities - shared with the backend
include 'markowitzTypes.bare'
include 'markowitzUtil.bare'


# The application's URL arguments
markowitzArguments = [ \
    {'name': 'page', 'default': 'runs'}, \
    {'name': 'id'}, \
    {'name': 'symbol'} \
]

# The new run form's fields - [name, label, input size] - and default values
markowitzRunFormFields = [ \
    ['name', 'Name', 40], \
    ['symbols', 'Stock symbols, separated by spaces or commas', 60], \
    ['endMonth', 'End month of the analysis period, "YYYY-MM" (blank for the latest)', 10], \
    ['months', 'Months in the analysis period', 5], \
    ['horizon', 'Months in the projection', 5], \
    ['targets', 'Target annual returns, in percent, separated by spaces or commas', 40] \
]
markowitzRunFormDefault = { \
    'name': '', \
    'symbols': '', \
    'endMonth': '', \
    'months': '36', \
    'horizon': '3', \
    'targets': '5, 10, 15, 20, 25' \
}

# The number of stocks in a run
markowitzRunSymbolsMin = 2
markowitzRunSymbolsMax = 100

# The stock symbols text input ID
markowitzSymbolsInputID = 'markowitz-symbols'

# The list text separator regex - spaces and commas
markowitzRegexListSeparator = regexNew('[\\s,]+')


# The Markowitz application main entry point
async function markowitzMain():
    args = argsParse(markowitzArguments)
    page = objectGet(args, 'page')
    if page == 'run':
        markowitzRunPage(args)
    elif page == 'new':
        markowitzNewRunPage(args)
    elif page == 'stocks':
        markowitzStocksPage(args)
    elif page == 'stock':
        markowitzStockPage(args)
    else:
        markowitzRunsPage()
    endif
endfunction


#
# Runs page
#


async function markowitzRunsPage():
    markowitzHeader('Markowitz')
    response = markowitzFetch('getRuns')
    if response == null:
        markdownPrint('**Error:** The runs could not be loaded.')
        return
    endif
    runs = objectGet(response, 'runs')
    if !arrayLength(runs):
        markdownPrint('There are no runs. ' + argsLink(markowitzArguments, 'Start a run', {'page': 'new'}, true) + '.')
        return
    endif

    # The runs table
    data = []
    for run in runs:
        arrayPush(data, { \
            'Run': argsLink(markowitzArguments, objectGet(run, 'name'), {'page': 'run', 'id': objectGet(run, 'id')}, true), \
            'Created': markowitzDatetimeText(objectGet(run, 'created')), \
            'Stocks': stringNew(arrayLength(objectGet(run, 'symbols'))), \
            'Analysis Period': markowitzPeriodText(run), \
            'Targets': markowitzTargetsText(objectGet(run, 'targets')) \
        })
    endfor
    markdownPrint(dataTableMarkdown(data, { \
        'fields': ['Run', 'Created', 'Stocks', 'Analysis Period', 'Targets'], \
        'formats': {'Run': {'markdown': true}, 'Stocks': {'align': 'right'}} \
    }))
endfunction


#
# Run page
#


async function markowitzRunPage(args, message):
    id = objectGet(args, 'id')
    response = if(id != null, markowitzFetch('getRun?id=' + urlEncodeComponent(id)))
    if response == null:
        markowitzHeader('Run')
        markdownPrint('**Error:** The run could not be loaded.')
        return
    endif
    run = objectGet(response, 'run')
    symbols = objectGet(run, 'symbols')
    portfolios = objectGet(run, 'portfolios')

    # The run's parameters and actions
    markowitzHeader(objectGet(run, 'name'))
    markowitzMessage(message)
    markdownPrint( \
        '- **Stocks:** ' + markdownEscape(arrayJoin(symbols, ', ')), \
        '- **Analysis period:** ' + markowitzPeriodText(run), \
        '- **Projection:** ' + objectGet(run, 'horizon') + ' months', \
        '- **Created:** ' + markowitzDatetimeText(objectGet(run, 'created')), \
        '' \
    )
    elementModelRender({'html': 'p', 'elem': [ \
        formsLinkElements('Run Again', argsURL(markowitzArguments, {'page': 'new', 'id': id}, true)), \
        {'text': ' | '}, \
        formsLinkButtonElements('Delete', systemPartial(markowitzOnDeleteRun, args, id)) \
    ]})

    # The portfolios table
    portfolioData = []
    frontierData = []
    for portfolio in portfolios:
        variance = objectGet(portfolio, 'variance')
        risk = if(variance != null, mathSqrt(variance))
        arrayPush(portfolioData, { \
            'Target Return': markowitzPercentText(objectGet(portfolio, 'target')), \
            'Realized Return': markowitzPercentText(objectGet(portfolio, 'realizedReturn')), \
            'Risk': if(risk != null, markowitzPercentText(risk), 'No solution'), \
            'Stocks': stringNew(arrayLength(objectGet(portfolio, 'allocations'))), \
            'Deleted': arrayJoin(objectGet(portfolio, 'deleted'), ', ') \
        })
        if risk != null:
            arrayPush(frontierData, {'Risk (%)': risk, 'Target Return (%)': objectGet(portfolio, 'target')})
        endif
    endfor
    markdownPrint( \
        '## Portfolios', \
        '', \
        'The minimum-risk portfolio for each target return. Stocks with negative allocations are deleted from the', \
        'portfolio, one at a time, most negative first. Returns are annualized. Risk is the standard deviation of the', \
        'portfolio\'s monthly returns about their trend.', \
        '' \
    )
    markdownPrint(dataTableMarkdown(portfolioData, { \
        'fields': ['Target Return', 'Realized Return', 'Risk', 'Stocks', 'Deleted'], \
        'formats': { \
            'Target Return': {'align': 'right'}, \
            'Realized Return': {'align': 'right'}, \
            'Risk': {'align': 'right'}, \
            'Stocks': {'align': 'right'} \
        } \
    }))

    # The efficient frontier chart
    if arrayLength(frontierData) >= 2:
        markdownPrint('', '## Efficient Frontier', '')
        dataLineChart(frontierData, {'x': 'Target Return (%)', 'y': ['Risk (%)']})
    endif

    # The allocations table - a column for each portfolio
    allocationData = []
    allocationFields = ['Stock']
    allocationFormats = {'Stock': {'markdown': true}}
    for symbol in symbols:
        arrayPush(allocationData, { \
            'Stock': argsLink(markowitzArguments, symbol, {'page': 'stock', 'symbol': symbol}, true) \
        })
    endfor
    for portfolio, ixPortfolio in portfolios:
        field = 'P' + ixPortfolio
        arrayPush(allocationFields, field)
        objectSet(allocationFormats, field, {'align': 'right', 'header': markowitzPercentText(objectGet(portfolio, 'target'))})
        for row in allocationData:
            objectSet(row, field, '')
        endfor
        for allocation in objectGet(portfolio, 'allocations'):
            row = arrayGet(allocationData, arrayIndexOf(symbols, objectGet(allocation, 'symbol')))
            objectSet(row, field, markowitzPercentText(100 * objectGet(allocation, 'weight')))
        endfor
    endfor
    markdownPrint( \
        '', \
        '## Allocations', \
        '', \
        'The percent of each target return\'s portfolio to invest in each stock.', \
        '' \
    )
    markdownPrint(dataTableMarkdown(allocationData, {'fields': allocationFields, 'formats': allocationFormats}))

    # The stocks table
    stockData = []
    for stock in objectGet(run, 'stocks'):
        stockSymbol = objectGet(stock, 'symbol')
        arrayPush(stockData, { \
            'Stock': argsLink(markowitzArguments, stockSymbol, {'page': 'stock', 'symbol': stockSymbol}, true), \
            'Projected Return': markowitzPercentText(objectGet(stock, 'expectedReturn')), \
            'Realized Return': markowitzPercentText(objectGet(stock, 'realizedReturn')), \
            'Risk': markowitzPercentText(mathSqrt(objectGet(stock, 'variance'))) \
        })
    endfor
    markdownPrint( \
        '', \
        '## Stocks', \
        '', \
        'Each stock\'s monthly returns are fit to a trend line. The projected return is the trend\'s return at the', \
        'end of the projection, and the risk is the standard deviation of the monthly returns about the trend.', \
        '' \
    )
    markdownPrint(dataTableMarkdown(stockData, { \
        'fields': ['Stock', 'Projected Return', 'Realized Return', 'Risk'], \
        'formats': { \
            'Stock': {'markdown': true}, \
            'Projected Return': {'align': 'right'}, \
            'Realized Return': {'align': 'right'}, \
            'Risk': {'align': 'right'} \
        } \
    }))
endfunction


# Delete a run
async function markowitzOnDeleteRun(args, id):
    if markowitzFetch('deleteRun', {'id': id}) == null:
        markowitzRunPage(args, 'The run could not be deleted.')
        return
    endif
    windowSetLocation(argsURL(markowitzArguments, {'page': 'runs'}, true))
endfunction


#
# New run page
#


async function markowitzNewRunPage(args, form, message):
    stocksResponse = markowitzFetch('getStocks')

    # Start with the default form, or a prior run's
    if form == null:
        form = objectCopy(markowitzRunFormDefault)
        id = objectGet(args, 'id')
        runResponse = if(id != null, markowitzFetch('getRun?id=' + urlEncodeComponent(id)))
        if runResponse != null:
            run = objectGet(runResponse, 'run')
            targets = []
            for target in objectGet(run, 'targets'):
                arrayPush(targets, stringNew(target))
            endfor
            objectAssign(form, { \
                'name': objectGet(run, 'name'), \
                'symbols': arrayJoin(objectGet(run, 'symbols'), ' '), \
                'endMonth': objectGet(run, 'endMonth'), \
                'months': stringNew(objectGet(run, 'months')), \
                'horizon': stringNew(objectGet(run, 'horizon')), \
                'targets': arrayJoin(targets, ', ') \
            })
        endif
    endif

    markowitzHeader('New Run')
    if stocksResponse == null:
        markdownPrint('**Error:** The stocks could not be loaded.')
        return
    endif
    stocks = objectGet(stocksResponse, 'stocks')
    markowitzMessage(message)

    # The run form
    for field in markowitzRunFormFields:
        name = arrayGet(field, 0)
        inputID = 'markowitz-' + name
        elementModelRender({'html': 'p', 'elem': [ \
            {'html': 'label', 'attr': {'for': inputID}, 'elem': {'html': 'b', 'elem': {'text': arrayGet(field, 1)}}}, \
            {'html': 'br'}, \
            formsTextElements(inputID, objectGet(form, name), arrayGet(field, 2)) \
        ]})
    endfor
    elementModelRender({'html': 'p', 'elem': formsLinkButtonElements('Start Run', systemPartial(markowitzOnStartRun, args, stocks))})

    # The available stocks
    markdownPrint('', '## Stocks', '')
    if !arrayLength(stocks):
        markdownPrint('There are no stocks. ' + argsLink(markowitzArguments, 'Add stocks', {'page': 'stocks'}, true) + '.')
        return
    endif
    markdownPrint(markowitzStocksTable(stocks))
endfunction


# Start a run
async function markowitzOnStartRun(args, stocks):
    form = {}
    for field in markowitzRunFormFields:
        name = arrayGet(field, 0)
        objectSet(form, name, documentInputValue('markowitz-' + name))
    endfor

    # Create the request
    requestResult = markowitzRunRequest(form, stocks)
    if objectHas(requestResult, 'error'):
        markowitzNewRunPage(args, form, objectGet(requestResult, 'error'))
        return
    endif

    # Start the run
    response = markowitzFetch('createRun', objectGet(requestResult, 'request'))
    if response == null:
        markowitzNewRunPage(args, form, 'The run failed.')
        return
    endif
    windowSetLocation(argsURL(markowitzArguments, {'page': 'run', 'id': objectGet(response, 'id')}, true))
endfunction


# Create a run request from the run form - returns {"request": request} or {"error": message}. The stocks are
# checked here since the browser can't read the API's error response.
function markowitzRunRequest(form, stocks):
    # Parse the form
    targets = []
    for target in markowitzParseList(objectGet(form, 'targets')):
        arrayPush(targets, numberParseFloat(target))
    endfor
    request = { \
        'name': stringTrim(objectGet(form, 'name')), \
        'symbols': markowitzSymbols(markowitzParseList(objectGet(form, 'symbols'))), \
        'months': numberParseInt(objectGet(form, 'months')), \
        'horizon': numberParseInt(objectGet(form, 'horizon')), \
        'targets': targets \
    }
    endMonth = stringTrim(objectGet(form, 'endMonth'))
    if endMonth != '':
        objectSet(request, 'endMonth', endMonth)
    endif

    # Validate the request
    symbolCount = arrayLength(objectGet(request, 'symbols'))
    if symbolCount < markowitzRunSymbolsMin || symbolCount > markowitzRunSymbolsMax:
        return {'error': 'Enter ' + markowitzRunSymbolsMin + ' to ' + markowitzRunSymbolsMax + \
            ' stock symbols (you entered ' + symbolCount + ').'}
    endif
    validated = schemaValidateEx(markowitzTypes, 'createRun_input', request)
    if objectHas(validated, 'error'):
        fieldName = arrayGet(stringSplit(objectGet(validated, 'memberFqn'), '.'), 0)
        label = fieldName
        for field in markowitzRunFormFields:
            label = if(arrayGet(field, 0) == fieldName, arrayGet(field, 1), label)
        endfor
        return {'error': 'Invalid "' + label + '" value.'}
    endif
    endIndex = if(endMonth != '', markowitzMonthIndex(endMonth))
    if endMonth != '' && endIndex == null:
        return {'error': 'Invalid end month "' + endMonth + '" - use "YYYY-MM".'}
    endif

    # Check the stocks
    symbols = objectGet(request, 'symbols')
    months = objectGet(request, 'months')
    if arrayLength(symbols) > months:
        return {'error': 'There are more stocks (' + arrayLength(symbols) + ') than months (' + months + \
            ') - increase the months in the analysis period.'}
    endif
    symbolStocks = {}
    for stock in stocks:
        objectSet(symbolStocks, objectGet(stock, 'symbol'), stock)
    endfor
    unknown = []
    lastIndex = null
    for symbol in symbols:
        stock = objectGet(symbolStocks, symbol)
        if stock == null:
            arrayPush(unknown, symbol)
        else:
            stockLastIndex = markowitzMonthIndex(objectGet(stock, 'lastMonth'))
            lastIndex = if(lastIndex == null, stockLastIndex, mathMin(lastIndex, stockLastIndex))
        endif
    endfor
    if arrayLength(unknown):
        return {'error': 'Unknown stocks: ' + arrayJoin(unknown, ', ') + ' - add them on the Stocks page.'}
    endif

    # Check the stocks' months
    endIndex = if(endIndex != null, endIndex, lastIndex)
    startIndex = endIndex - months
    missing = []
    for symbol in symbols:
        stock = objectGet(symbolStocks, symbol)
        if markowitzMonthIndex(objectGet(stock, 'firstMonth')) > startIndex || \
                markowitzMonthIndex(objectGet(stock, 'lastMonth')) < endIndex:
            arrayPush(missing, symbol)
        endif
    endfor
    if arrayLength(missing):
        return {'error': 'Stocks without prices from ' + markowitzMonthString(startIndex) + ' to ' + \
            markowitzMonthString(endIndex) + ': ' + arrayJoin(missing, ', ') + '.'}
    endif

    return {'request': request}
endfunction


#
# Stocks page
#


async function markowitzStocksPage(args, message):
    markowitzHeader('Stocks')
    response = markowitzFetch('getStocks')
    if response == null:
        markdownPrint('**Error:** The stocks could not be loaded.')
        return
    endif
    stocks = objectGet(response, 'stocks')
    markowitzMessage(message)

    # The stock update controls
    symbols = []
    for stock in stocks:
        arrayPush(symbols, objectGet(stock, 'symbol'))
    endfor
    markdownPrint( \
        'Download stocks\' monthly prices from Yahoo Finance. Enter stock symbols, separated by spaces or commas, to', \
        'add or update them.', \
        '' \
    )
    controls = [ \
        formsTextElements(markowitzSymbolsInputID, '', 40), \
        {'text': ' '}, \
        formsLinkButtonElements('Add / Update', systemPartial(markowitzOnUpdateStocks, args, null)) \
    ]
    if arrayLength(symbols):
        arrayPush(controls, {'text': ' | '}, formsLinkButtonElements('Update All', systemPartial(markowitzOnUpdateStocks, args, symbols)))
    endif
    elementModelRender({'html': 'p', 'elem': controls})

    # The stocks table
    if !arrayLength(stocks):
        markdownPrint('There are no stocks.')
        return
    endif
    markdownPrint(markowitzStocksTable(stocks))
endfunction


# Download and update stocks - the stock symbols input's stocks if the symbols are null
async function markowitzOnUpdateStocks(args, symbols):
    symbols = if(symbols != null, symbols, markowitzParseList(documentInputValue(markowitzSymbolsInputID)))
    request = {'symbols': symbols}
    if objectHas(schemaValidateEx(markowitzTypes, 'updateStocks_input', request), 'error'):
        markowitzStocksPage(args, 'Enter one to fifty stock symbols.')
        return
    endif
    markowitzStocksPage(args, markowitzUpdateStocks(request))
endfunction


# Download and update stocks - returns the result message
async function markowitzUpdateStocks(request):
    response = markowitzFetch('updateStocks', request)
    if response == null:
        return 'The stock update failed.'
    endif
    updated = []
    failed = []
    for result in objectGet(response, 'results'):
        symbol = objectGet(result, 'symbol')
        error = objectGet(result, 'error')
        if error != null:
            arrayPush(failed, symbol + ' (' + error + ')')
        else:
            arrayPush(updated, symbol)
        endif
    endfor
    messages = []
    if arrayLength(updated):
        arrayPush(messages, 'Updated ' + arrayJoin(updated, ', ') + '.')
    endif
    if arrayLength(failed):
        arrayPush(messages, 'Failed ' + arrayJoin(failed, ', ') + '.')
    endif
    return arrayJoin(messages, ' ')
endfunction


#
# Stock page
#


async function markowitzStockPage(args, message):
    symbol = objectGet(args, 'symbol')
    response = if(symbol != null, markowitzFetch('getStock?symbol=' + urlEncodeComponent(symbol)))
    if response == null:
        markowitzHeader('Stock')
        markdownPrint('**Error:** The stock could not be loaded.')
        return
    endif
    stock = objectGet(response, 'stock')
    stockSymbol = objectGet(stock, 'symbol')
    prices = objectGet(response, 'prices')

    # The stock's summary and actions
    markowitzHeader(stockSymbol)
    markowitzMessage(message)
    markdownPrint( \
        '- **Name:** ' + markdownEscape(objectGet(stock, 'name', '')), \
        '- **Currency:** ' + markdownEscape(objectGet(stock, 'currency', '')), \
        '- **Months:** ' + objectGet(stock, 'monthCount') + ', ' + objectGet(stock, 'firstMonth') + ' to ' + \
            objectGet(stock, 'lastMonth'), \
        '- **Updated:** ' + markowitzDatetimeText(objectGet(stock, 'updated')), \
        '' \
    )
    elementModelRender({'html': 'p', 'elem': [ \
        formsLinkButtonElements('Update', systemPartial(markowitzOnUpdateStock, args, stockSymbol)), \
        {'text': ' | '}, \
        formsLinkButtonElements('Delete', systemPartial(markowitzOnDeleteStock, args, stockSymbol)) \
    ]})

    # The monthly price chart
    data = []
    for month in arraySort(objectKeys(prices)):
        monthIndex = markowitzMonthIndex(month)
        arrayPush(data, { \
            'Month': datetimeNew(mathFloor(monthIndex / 12), monthIndex % 12 + 1, 1), \
            'Price': objectGet(prices, month) \
        })
    endfor
    dataLineChart(data, {'title': 'Monthly Price (adjusted)', 'x': 'Month', 'y': ['Price'], 'yScale': 'log'})
endfunction


# Download and update a stock
async function markowitzOnUpdateStock(args, symbol):
    markowitzStockPage(args, markowitzUpdateStocks({'symbols': [symbol]}))
endfunction


# Delete a stock
async function markowitzOnDeleteStock(args, symbol):
    if markowitzFetch('deleteStock', {'symbol': symbol}) == null:
        markowitzStockPage(args, 'The stock could not be deleted.')
        return
    endif
    windowSetLocation(argsURL(markowitzArguments, {'page': 'stocks'}, true))
endfunction


#
# Helpers
#


# Render the page header and menu
function markowitzHeader(title):
    documentSetTitle(title)
    markdownPrint( \
        '# ' + markdownEscape(title), \
        '', \
        argsLink(markowitzArguments, 'Runs', {'page': 'runs'}, true) + ' | ' + \
            argsLink(markowitzArguments, 'New Run', {'page': 'new'}, true) + ' | ' + \
            argsLink(markowitzArguments, 'Stocks', {'page': 'stocks'}, true) + ' | ' + \
            '[API Documentation](doc/)', \
        '' \
    )
endfunction


# Render a page message, if any
function markowitzMessage(message):
    if message:
        markdownPrint('**' + markdownEscape(message) + '**', '')
    endif
endfunction


# Call an API action - a POST if there's a request object. Returns the response object, or null on failure.
async function markowitzFetch(url, request):
    responseText = systemFetch(if(request != null, {'url': url, 'body': jsonStringify(request)}, url))
    return if(responseText != null, jsonParse(responseText))
endfunction


# The stocks table Markdown lines
function markowitzStocksTable(stocks):
    data = []
    for stock in stocks:
        symbol = objectGet(stock, 'symbol')
        arrayPush(data, { \
            'Stock': argsLink(markowitzArguments, symbol, {'page': 'stock', 'symbol': symbol}, true), \
            'Name': objectGet(stock, 'name', ''), \
            'First Month': objectGet(stock, 'firstMonth'), \
            'Last Month': objectGet(stock, 'lastMonth'), \
            'Months': stringNew(objectGet(stock, 'monthCount')), \
            'Updated': markowitzDatetimeText(objectGet(stock, 'updated')) \
        })
    endfor
    return dataTableMarkdown(data, { \
        'fields': ['Stock', 'Name', 'First Month', 'Last Month', 'Months', 'Updated'], \
        'formats': {'Stock': {'markdown': true}, 'Months': {'align': 'right'}} \
    })
endfunction


# Split a list text on spaces and commas
function markowitzParseList(text):
    items = []
    for item in regexSplit(markowitzRegexListSeparator, text):
        if item != '':
            arrayPush(items, item)
        endif
    endfor
    return items
endfunction


# Format a percent value - empty if null
function markowitzPercentText(value):
    return if(value != null, numberToFixed(value, 2) + '%', '')
endfunction


# Format target returns
function markowitzTargetsText(targets):
    texts = []
    for target in targets:
        arrayPush(texts, markowitzPercentText(target))
    endfor
    return arrayJoin(texts, ', ')
endfunction


# Format a run's analysis period
function markowitzPeriodText(run):
    return objectGet(run, 'months') + ' months to ' + objectGet(run, 'endMonth')
endfunction


# Format an ISO datetime string as a local "YYYY-MM-DD HH:MM" string
function markowitzDatetimeText(text):
    return stringReplace(stringSlice(datetimeISOFormat(datetimeISOParse(text)), 0, 16), 'T', ' ')
endfunction
