testCouchHeaders = {'Authorization': 'Basic YWRtaW46c2VjcmV0', 'Content-Type': 'application/json'}

# The test time
testNow = datetimeNew(2026, 10, 10, 12, 30, 0)
testNowISO = datetimeISOFormat(testNow)


# Call the application with a request - returns [status, response object]
async function testAction(method, path, query, body):
    response = markowitzApplication({ \
        'REQUEST_METHOD': method, \
        'PATH_INFO': path, \
        'QUERY_STRING': query, \
        'wsgi.input': if(body != null, jsonStringify(body), '') \
    })
    return [objectGet(response, 'status'), jsonParse(objectGet(response, 'content'))]
endfunction


# Start mocking, with the test time
function testMockAll(data):
    unittestMockAll(data)
    unittestMockOne('datetimeNow', testDatetimeNow)
endfunction

function testDatetimeNow():
    return testNow
endfunction


# Round a value's numbers, recursively, for comparison
function testRound(value):
    type = systemType(value)
    if type == 'number':
        return mathRound(value * 1e9) / 1e9
    elif type == 'array':
        rounded = []
        for item in value:
            arrayPush(rounded, testRound(item))
        endfor
        return rounded
    elif type == 'object':
        rounded = {}
        for key in objectKeys(value):
            objectSet(rounded, key, testRound(objectGet(value, key)))
        endfor
        return rounded
    endif
    return value
endfunction


# A CouchDB request call log entry
function testCouchCall(path, body, method):
    request = {'url': testCouchURL + path, 'headers': testCouchHeaders}
    if body != null:
        objectSet(request, 'body', jsonStringify(body))
    endif
    if method != null:
        objectSet(request, 'method', method)
    endif
    return ['systemFetch', [request]]
endfunction


