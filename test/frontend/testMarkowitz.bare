    )
endfunction
unittestRunTest('testMarkowitzRunRequest_invalid')


# Create a symbols text of a number of unique symbols
function testSymbolsText(count):
    symbols = []
    while arrayLength(symbols) < count:
        arrayPush(symbols, 'S' + arrayLength(symbols))
    endwhile
    return arrayJoin(symbols, ' ')
endfunction


function testMarkowitzRunRequest_symbolCount():
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(testForm), {'symbols': 'IBM ibm'}), testStocks), \
        {'error': 'Enter 2 to 100 stock symbols (you entered 1).'} \
    )
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(testForm), {'symbols': testSymbolsText(101)}), testStocks), \
        {'error': 'Enter 2 to 100 stock symbols (you entered 101).'} \
    )

    # One hundred stocks are checked against the stocks (and the months)
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(testForm), {'symbols': testSymbolsText(100)}), testStocks), \
        {'error': 'There are more stocks (100) than months (36) - increase the months in the analysis period.'} \
    )
endfunction
unittestRunTest('testMarkowitzRunRequest_symbolCount')


