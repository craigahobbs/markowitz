async function testMarkowitzRunPage_deleteBinding():
    args = {'page': 'run', 'id': 'r1'}
    data = {'systemFetch': {'getRun?id=r1': jsonStringify({'run': testRun}), 'deleteRun': '{}'}}
    testVerifyClick(systemPartial(markowitzRunPage, args), 'Delete', systemPartial(markowitzOnDeleteRun, args, 'r1'), data)
endfunction
unittestRunTest('testMarkowitzRunPage_deleteBinding')


# The test run, incomplete - one of its three portfolios computed
testRunIncomplete = objectCopy(testRun)
objectSet(testRunIncomplete, 'portfolios', arraySlice(objectGet(testRun, 'portfolios'), 0, 1))
objectSet(testRunIncomplete, 'running', true)


async function testMarkowitzRunPage_incomplete():
    args = {'page': 'run', 'id': 'r1'}
    unittestMockAll({'systemFetch': {'getRun?id=r1': jsonStringify({'run': testRunIncomplete})}})
    markowitzRunPage(args)
    calls = unittestMockEnd()
    unittestDeepEqual(arraySlice(calls, 5, 7), [ \
        ['markdownPrint', [ \
            '**This run is incomplete** - 1 of its 3 portfolios are computed. Continue the run to compute the rest.', \
            '' \
        ]], \
        ['elementModelRender', [{'html': 'p', 'elem': [ \
            formsLinkButtonElements('Continue', '<function>'), \
            {'text': ' | '}, \
            formsLinkElements('Run Again', "#var.vId='r1'&var.vPage='new'"), \
            {'text': ' | '}, \
            formsLinkButtonElements('Delete', '<function>') \
        ]}]] \
    ])
endfunction
unittestRunTest('testMarkowitzRunPage_incomplete')


async function testMarkowitzRunPage_continueBinding():
    args = {'page': 'run', 'id': 'r1'}
    data = {'systemFetch': {'getRun?id=r1': jsonStringify({'run': testRunIncomplete})}}
    testVerifyClick(systemPartial(markowitzRunPage, args), 'Continue', systemPartial(markowitzOnContinueRun, args, testRunIncomplete), data)
endfunction
unittestRunTest('testMarkowitzRunPage_continueBinding')


function testMarkowitzOnContinueRun():
    args = {'page': 'run', 'id': 'r1'}
    unittestMockAll()
    markowitzOnContinueRun(args, testRunIncomplete)
    unittestDeepEqual(unittestMockEnd(), testPageCalls(systemPartial(markowitzRunProgress, testRunProgress(1, args)), {}))
endfunction
unittestRunTest('testMarkowitzOnContinueRun')


async function testMarkowitzOnDeleteRun():
    unittestMockAll({'systemFetch': {'deleteRun': '{}'}})
    markowitzOnDeleteRun({'page': 'run', 'id': 'r1'}, 'r1')
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemFetch', [{'url': 'deleteRun', 'body': '{"id":"r1"}'}]], \
        ['windowSetLocation', ['#var=']] \
    ])
endfunction
unittestRunTest('testMarkowitzOnDeleteRun')


async function testMarkowitzOnDeleteRun_error():
    args = {'page': 'run', 'id': 'r1'}
    data = {'systemFetch': {'getRun?id=r1': jsonStringify({'run': testRun})}}
    unittestMockAll(data)
    markowitzOnDeleteRun(args, 'r1')
    calls = unittestMockEnd()
    unittestDeepEqual(arrayGet(calls, 0), ['systemFetch', [{'url': 'deleteRun', 'body': '{"id":"r1"}'}]])
    unittestDeepEqual(arraySlice(calls, 1), testPageCalls(systemPartial(markowitzRunPage, args, 'The run could not be deleted.'), data))
endfunction
unittestRunTest('testMarkowitzOnDeleteRun_error')


#
# Run progress tests
#


function testMarkowitzRunProgress():
    unittestMockAll()
    markowitzRunProgress(testRunProgress(1))
    expected = testHeaderCalls('Blue <Chips>', 'Blue \\<Chips\\>')
    arrayExtend(expected, arraySlice(testRunProgressCalls('Blue <Chips>', 1, 3, '33'), 2))
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction
unittestRunTest('testMarkowitzRunProgress')


async function testMarkowitzRunProgress_timeoutBinding():
    data = {'systemFetch': {'computeRunPortfolio': jsonStringify({'portfolios': 2, 'targets': 3})}}
    callbacks = testCaptureTimeouts(systemPartial(markowitzRunProgress, testRunProgress(1)), data)
    testSameEffect(arrayGet(callbacks, 0), systemPartial(markowitzOnRunPortfolio, testRunProgress(1)), data)
endfunction
unittestRunTest('testMarkowitzRunProgress_timeoutBinding')


async function testMarkowitzRunProgress_stopBinding():
    unittestMockAll()
    markowitzRunProgress(testRunProgress(1))
    found = testFindClick(unittestMockEnd(), 'Stop')
    testSameEffect(found, systemPartial(markowitzOnRunStop, testRunProgress(1)), {})
endfunction
unittestRunTest('testMarkowitzRunProgress_stopBinding')


async function testMarkowitzOnRunPortfolio():
    # A portfolio is computed - the progress is rendered, and the next portfolio is scheduled
    progress = testRunProgress(1)
    unittestMockAll({'systemFetch': {'computeRunPortfolio': jsonStringify({'portfolios': 2, 'targets': 3})}})
    markowitzOnRunPortfolio(progress)
    expected = [['systemFetch', [{'url': 'computeRunPortfolio', 'body': '{"id":"r1"}'}]]]
    arrayExtend(expected, testHeaderCalls('Blue <Chips>', 'Blue \\<Chips\\>'))
    arrayExtend(expected, arraySlice(testRunProgressCalls('Blue <Chips>', 2, 3, '67'), 2))
    unittestDeepEqual(unittestMockEnd(), expected)
    unittestEqual(objectGet(progress, 'count'), 2)
endfunction
unittestRunTest('testMarkowitzOnRunPortfolio')


async function testMarkowitzOnRunPortfolio_done():
    # The last portfolio is computed - the run's page is opened
    unittestMockAll({'systemFetch': {'computeRunPortfolio': jsonStringify({'portfolios': 3, 'targets': 3})}})
    markowitzOnRunPortfolio(testRunProgress(2))
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemFetch', [{'url': 'computeRunPortfolio', 'body': '{"id":"r1"}'}]], \
        ['windowSetLocation', ["#var.vId='r1'&var.vPage='run'"]] \
    ])
endfunction
unittestRunTest('testMarkowitzOnRunPortfolio_done')


async function testMarkowitzOnRunPortfolio_error():
    # Continued from the run's page - the run's page is rendered with the message
    args = {'page': 'run', 'id': 'r1'}
    data = {'systemFetch': {'getRun?id=r1': jsonStringify({'run': testRun})}}
    unittestMockAll(data)
    markowitzOnRunPortfolio(testRunProgress(2, args))
    calls = unittestMockEnd()
    unittestDeepEqual(arrayGet(calls, 0), ['systemFetch', [{'url': 'computeRunPortfolio', 'body': '{"id":"r1"}'}]])
    message = 'Computing the run\'s portfolio failed.'
    unittestDeepEqual(arraySlice(calls, 1), testPageCalls(systemPartial(markowitzRunPage, args, message), data))
endfunction
unittestRunTest('testMarkowitzOnRunPortfolio_error')


async function testMarkowitzOnRunStop():
    progress = testRunProgress(1)
    unittestMockAll()
    markowitzOnRunStop(progress)
    unittestDeepEqual(unittestMockEnd(), [['windowSetLocation', ["#var.vId='r1'&var.vPage='run'"]]])
    unittestEqual(objectGet(progress, 'stopped'), true)
endfunction
unittestRunTest('testMarkowitzOnRunStop')


async function testMarkowitzOnRunPortfolio_stoppedDuring():
    # Stop is clicked while the portfolio is computed - nothing is rendered or scheduled
    # (unittestMockOne doesn't record calls - the generic mocks record any render or schedule)
    progress = testRunProgress(1)
    unittestMockOne('systemFetch', systemPartial(testStoppingFetch, progress, jsonStringify({'portfolios': 2, 'targets': 3})))
    unittestMockOneGeneric('windowSetTimeout')
    unittestMockOneGeneric('windowSetLocation')
    unittestMockOneGeneric('markdownPrint')
    markowitzOnRunPortfolio(progress)
    unittestDeepEqual(unittestMockEnd(), [])
    unittestEqual(objectGet(progress, 'count'), 1)
endfunction
unittestRunTest('testMarkowitzOnRunPortfolio_stoppedDuring')


async function testMarkowitzOnRunPortfolio_stopped():
    # The next portfolio's timeout was queued behind the Stop click - it does nothing
    progress = testRunProgress(1)
    objectSet(progress, 'stopped', true)
    unittestMockAll({'systemFetch': {'computeRunPortfolio': jsonStringify({'portfolios': 2, 'targets': 3})}})
    markowitzOnRunPortfolio(progress)
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testMarkowitzOnRunPortfolio_stopped')
