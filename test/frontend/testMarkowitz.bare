function testMarkowitzRunRequest_missingMonths():
    # KO's prices start in 1985-01 - the analysis period's starting price is needed
    unittestEqual( \
        objectHas(markowitzRunRequest(objectAssign(objectCopy(testForm), {'endMonth': '1988-01'}), testStocks), 'request'), \
        true \
    )
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(testForm), {'endMonth': '1987-12'}), testStocks), \
        {'error': 'Stocks without prices from 1984-12 to 1987-12: KO.'} \
    )
    unittestDeepEqual( \
        markowitzRunRequest(objectAssign(objectCopy(testForm), {'endMonth': '2026-10'}), testStocks), \
        {'error': 'Stocks without prices from 2023-10 to 2026-10: IBM, KO.'} \
    )
endfunction
unittestRunTest('testMarkowitzRunRequest_missingMonths')


