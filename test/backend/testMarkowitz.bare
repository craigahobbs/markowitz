async function testGetGroup():
    group = {'_id': 'group:S&P 100', '_rev': '1-abc', 'type': 'group', 'name': 'S&P 100', 'symbols': ['IBM', 'KO', 'XYZ']}
    stockIBM = {'symbol': 'IBM', 'firstMonth': '1962-01', 'lastMonth': '2026-09', 'monthCount': 777, 'updated': testNowISO}
    stockKO = {'symbol': 'KO', 'firstMonth': '1985-01', 'lastMonth': '2026-09', 'monthCount': 501, 'updated': testNowISO}
    fetchData = {}
    objectSet(fetchData, testCouchURL + '/group%3AS%26P%20100', jsonStringify(group))
    objectSet(fetchData, testCouchURL + '/_find', jsonStringify({'docs': [stockKO, stockIBM]}))
    testMockAll({'systemFetch': fetchData})
    unittestDeepEqual( \
        testAction('GET', '/getGroup', 'name=S%26P%20100', null), \
        ['200 OK', {'group': {'name': 'S&P 100', 'symbols': ['IBM', 'KO', 'XYZ']}, 'stocks': [stockIBM, stockKO]}] \
    )
    unittestDeepEqual(unittestMockEnd(), [ \
        testCouchCall('/group%3AS%26P%20100'), \
        testCouchCall('/_find', { \
            'selector': {'type': 'stock', 'symbol': {'$in': ['IBM', 'KO', 'XYZ']}}, \
            'fields': markowitzStockInfoFields, \
            'limit': 100000 \
        }) \
    ])
endfunction
unittestRunTest('testGetGroup')


