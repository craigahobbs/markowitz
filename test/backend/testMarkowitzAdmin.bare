include <unittest.bare>
include <unittestMock.bare>


# The database credentials the host passes to the backend
markowitzCouchCredentials = 'admin:secret'


include '../../backend/markowitzAdmin.bare'


# The test server and database URLs and headers
testAdminServerURL = 'http://127.0.0.1:5984'
testAdminCouchURL = testAdminServerURL + '/markowitz'
testAdminHeaders = {'Authorization': 'Basic YWRtaW46c2VjcmV0', 'Content-Type': 'application/json'}

# The test admin session
testAdminSession = jsonStringify({'ok': true, 'userCtx': {'name': 'admin', 'roles': ['_admin']}})

# The test stock groups
testAdminGroups = [{'name': 'Group A', 'symbols': ['IBM', 'KO']}, {'name': 'Group B', 'symbols': ['KO']}]


# A CouchDB request call log entry
function testAdminCall(url, method, headers, body):
    request = {'url': url, 'headers': if(headers != null, headers, testAdminHeaders)}
    if method != null:
        objectSet(request, 'method', method)
    endif
    if body != null:
        objectSet(request, 'body', body)
    endif
    return ['systemFetch', [request]]
endfunction


# A log call log entry
function testAdminLog(message):
    return ['systemLog', [message]]
endfunction


# The server check's call log entries
testAdminServerCalls = [['systemFetch', [testAdminServerURL + '/']]]


# Run an administration command with the test groups - returns [status, call log]
async function testAdminRun(args, fetchData):
    groups = markowitzAdminGroups
    systemGlobalSet('markowitzAdminGroups', testAdminGroups)
    unittestMockAll({'systemFetch': fetchData})
    status = markowitzAdmin(args)
    calls = unittestMockEnd()
    systemGlobalSet('markowitzAdminGroups', groups)
    return [status, calls]
endfunction


# The test fetch data, with the server running
function testAdminFetchData():
    return objectNew(testAdminServerURL + '/', '{"couchdb": "Welcome"}')
endfunction


# Concatenate arrays
function testAdminConcat(arrays...):
    result = []
    for array in arrays:
        arrayExtend(result, array)
    endfor
    return result
endfunction


#
# Command tests
#


function testMarkowitzAdminServerURL():
    unittestEqual(markowitzAdminServerURL, testAdminServerURL)
endfunction
unittestRunTest('testMarkowitzAdminServerURL')


function testMarkowitzAdminGroups():
    names = []
    for group in markowitzAdminGroups:
        name = objectGet(group, 'name')
        symbols = objectGet(group, 'symbols')
        arrayPush(names, name)

        # The symbols are valid, sorted, and unique
        unittestEqual(objectHas(schemaValidateEx(markowitzTypes, 'setGroup_input', group), 'error'), false)
        unittestDeepEqual(markowitzSymbols(symbols), symbols)
    endfor
    unittestDeepEqual(names, ['Dow 30', 'Magnificent 7', 'Nasdaq-100', 'S&P 100', 'S&P 500'])
endfunction
unittestRunTest('testMarkowitzAdminGroups')


async function testMarkowitzAdmin_usage():
    for args in [[], ['unknown'], ['check', 'init']]:
        unittestDeepEqual(testAdminRun(args, {}), [1, [testAdminLog('usage: python3 wsgi.py {check|init|reset}')]])
    endfor
endfunction
unittestRunTest('testMarkowitzAdmin_usage')


async function testMarkowitzAdmin_notRunning():
    for command in ['check', 'init', 'reset']:
        unittestDeepEqual(testAdminRun([command], {}), [1, testAdminConcat(testAdminServerCalls, [ \
            testAdminLog('CouchDB is not running at "http://127.0.0.1:5984" - start it (e.g. "brew services start couchdb")') \
        ])])
    endfor
endfunction
unittestRunTest('testMarkowitzAdmin_notRunning')


#
# check tests
#


async function testMarkowitzAdminCheck():
    fetchData = testAdminFetchData()
    objectSet(fetchData, testAdminCouchURL, '{"db_name": "markowitz"}')
    unittestDeepEqual(testAdminRun(['check'], fetchData), [0, testAdminConcat(testAdminServerCalls, [ \
        testAdminCall(testAdminCouchURL), \
        testAdminLog('The database "http://127.0.0.1:5984/markowitz" is ready') \
    ])])
endfunction
unittestRunTest('testMarkowitzAdminCheck')


async function testMarkowitzAdminCheck_noDatabase():
    unittestDeepEqual(testAdminRun(['check'], testAdminFetchData()), [1, testAdminConcat(testAdminServerCalls, [ \
        testAdminCall(testAdminCouchURL), \
        testAdminLog( \
            'The database "http://127.0.0.1:5984/markowitz" does not exist, or MARKOWITZ_COUCH_CREDENTIALS is not valid - ' + \
                'run "make init"' \
        ) \
    ])])
endfunction
unittestRunTest('testMarkowitzAdminCheck_noDatabase')


#
# init tests
