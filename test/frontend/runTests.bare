include <unittest.bare>
include <unittestMock.bare>


# Start coverage
unittestCoverageStart()

# Test includes
include 'testMarkowitz.bare'
include 'testMarkowitzCommon.bare'
include 'testMarkowitzGroups.bare'
include 'testMarkowitzNewRun.bare'
include 'testMarkowitzRuns.bare'
include 'testMarkowitzStocks.bare'
include 'testMarkowitzUtil.bare'

# Stop coverage
unittestCoverageStop()

# Test report
return unittestReport({'coverageExclude': ['runTests.bare'], 'coverageMin': 100})
