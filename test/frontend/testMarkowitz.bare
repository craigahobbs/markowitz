# The page header calls - with the "Back" link call at the top, if there's a URL
function testHeaderCalls(title, titleMarkdown, backURL):
    calls = [['documentSetTitle', [title]]]
    if backURL != null:
        arrayPush(calls, ['markdownPrint', ['[Back](' + backURL + ')', '']])
    endif
    arrayPush(calls, ['markdownPrint', ['# ' + titleMarkdown, '', testMenu, '']])
    return calls
endfunction


# A new run form field render call
function testFormFieldCall(name, label, size, value, change):
    inputID = 'markowitz-' + name
    inputElements = formsTextElements(inputID, value, size)
    if change:
        objectSet(inputElements, 'callback', {'change': '<function>'})
    endif
    return ['elementModelRender', [{'html': 'p', 'elem': [ \
        {'html': 'label', 'attr': {'for': inputID}, 'elem': {'html': 'b', 'elem': {'text': label}}}, \
        {'html': 'br'}, \
        inputElements \
    ]}]]
endfunction


# The excluded stocks field label
testExcludeLabel = 'Excluded stocks, separated by spaces or commas - updated when the group, end month, or months change'


# The new run form render calls - if "change" is true, the analysis period inputs have change callbacks
function testFormCalls(form, change):
    return [ \
        testFormFieldCall('name', 'Name', 40, objectGet(form, 'name')), \
        testFormFieldCall('endMonth', 'End month of the analysis period, "YYYY-MM" (blank for the latest)', 10, objectGet(form, 'endMonth'), change), \
        testFormFieldCall('months', 'Months in the analysis period', 5, objectGet(form, 'months'), change), \
        testFormFieldCall('horizon', 'Months in the projection', 5, objectGet(form, 'horizon')), \
        testFormFieldCall('targets', 'Target annual returns, in percent, separated by spaces or commas', 40, objectGet(form, 'targets')), \
        testFormFieldCall('exclude', testExcludeLabel, 80, objectGet(form, 'exclude')), \
        ['elementModelRender', [{'html': 'p', 'elem': formsLinkButtonElements('Start Run', '<function>')}]], \
        ['markdownPrint', [ \
            'Stocks without a price for every month of the analysis period are excluded from the run. A run needs at least', \
            'as many months as stocks.', \
            '' \
        ]] \
    ]
endfunction


# A stock group's stocks without prices warning text
function testMissingText(groupURL, missingCount, total):
    return '**Warning:** ' + missingCount + ' of the group\'s ' + total + ' stocks have no prices - ' + \
        "[update the stocks](#var.vGroup='" + groupURL + "'&var.vPage='group') for an accurate minimum analysis period."
endfunction


# A stock group's minimum analysis period text
function testMinimumText(months, count, total):
    return '**Minimum analysis period:** ' + months + ' months - a run can\'t have more stocks than months, and ' + \
        count + ' of the group\'s ' + total + ' stocks have prices for ' + months + ' months.'
endfunction


# The new run page's stock group render call - the selected group and its stock count, if any
function testGroupCall(group, count):
    elem = [{'html': 'b', 'elem': {'text': 'Stock group'}}, {'html': 'br'}]
    if group != null:
        arrayPush(elem, {'text': group + ' (' + count + ' stocks) '})
    endif
    arrayPush(elem, formsLinkButtonElements(if(group != null, 'Change', 'Select'), '<function>'))
    return ['elementModelRender', [{'html': 'p', 'elem': elem}]]
endfunction


# The new run page's stock group selection list render call
testGroupListCall = ['elementModelRender', [{'html': 'ul', 'elem': [ \
    {'html': 'li', 'elem': [formsLinkButtonElements('Dow 30', '<function>'), {'text': ' (2 stocks)'}]}, \
    {'html': 'li', 'elem': [formsLinkButtonElements('S&P 100', '<function>'), {'text': ' (3 stocks)'}]} \
]}]]


# The new run form's input values mock data
function testFormInputs(form):
    inputs = {}
    for name in objectKeys(form):
        if name != 'group':
            objectSet(inputs, 'markowitz-' + name, objectGet(form, name))
        endif
    endfor
    return inputs
endfunction


# The new run form's input value calls
testFormInputCalls = [ \
