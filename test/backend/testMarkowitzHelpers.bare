# A test Yahoo Finance chart API response - 2026-06 (no price) through 2026-10 (the current month)
function testYahooResponse(meta):
    objectAssign(meta, {'gmtoffset': -14400, 'regularMarketTime': 1791576000})
    return jsonStringify({'chart': {'result': [{ \
        'meta': meta, \
        'timestamp': [1780286400, 1782878400, 1785556800, 1788235200, 1791576000], \
        'indicators': { \
            'quote': [{'close': [null, 9.5, 10.5, 12.5, 13.5]}], \
            'adjclose': [{'adjclose': [null, 9, 10, 12, 13]}] \
        } \
    }]}})
endfunction
