include <args.bare>

# The application's pages
include 'markowitzCommon.bare'
include 'markowitzGroups.bare'
include 'markowitzNewRun.bare'
include 'markowitzRuns.bare'
include 'markowitzStocks.bare'


# The Markowitz application main entry point
async function markowitzMain():
    args = argsParse(markowitzArguments)
    page = objectGet(args, 'page')
    if page == 'run':
        markowitzRunPage(args)
    elif page == 'new':
        markowitzNewRunPage(args)
    elif page == 'stocks':
        markowitzStocksPage(args)
    elif page == 'stock':
        markowitzStockPage(args)
    elif page == 'groups':
        markowitzGroupsPage(args)
    elif page == 'group':
        markowitzGroupPage(args)
    else:
        markowitzRunsPage()
    endif
endfunction
